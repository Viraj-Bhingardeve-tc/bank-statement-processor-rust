# Copy to server/.env and fill in real values for your environment.
# server/.env is gitignored (see repo-root .gitignore's "*.env" pattern
# added in Phase 4H.1) — never commit real secrets.
#
# Read at startup by server/src/config.rs (AppConfig::from_env) unless
# noted otherwise below.

# Postgres connection string (required — no default; a missing value fails
# startup loudly rather than silently pointing at nothing). When running
# via docker-compose.yml, the host must be the "postgres" service name
# (Docker's internal DNS), not localhost.
#
# Phase 4J.8 (production readiness audit — least-privilege DB role): this
# must use the restricted `license_server_app` role (APP_DB_USER /
# APP_DB_PASSWORD below), NOT POSTGRES_USER — POSTGRES_USER is the Postgres
# instance superuser (administration only: running migrations, backups —
# see docker-compose.yml and server/README.md's "Database roles and least
# privilege" section). `license_server_app` is created automatically by
# migration 0003_least_privilege_app_role.sql; its password is set
# separately via server/deploy/set-app-db-password.sh (never committed —
# a migration file can't safely contain a real secret). The db name here
# must still match POSTGRES_DB.
DATABASE_URL=postgres://license_server_app:changeme@postgres:5432/license_server

# The restricted application role's own credentials — used to run
# server/deploy/set-app-db-password.sh (which sets/rotates the password
# above) and to double-check DATABASE_URL matches. NOT read directly by
# server/src/config.rs; DATABASE_URL above is the only thing the server
# process itself parses. Keep APP_DB_PASSWORD equal to whatever you put in
# DATABASE_URL's password field.
APP_DB_USER=license_server_app
APP_DB_PASSWORD=changeme

# HTTP listener. Defaults: HOST=0.0.0.0, PORT=8080.
HOST=0.0.0.0
PORT=8080

# Production Hardening, Finding H3. Comma-separated CIDR ranges this
# process trusts enough to read the real client IP from the
# `X-Forwarded-For` header instead of the raw TCP peer address, for
# /login's per-IP rate limiter. Optional — unset (the default) means no
# proxy is trusted at all, so /login always keys on the raw peer address,
# exactly this crate's behavior before this finding was fixed.
#
# Behind this crate's own documented deployment topology
# (docker-compose.yml: Caddy → license-server, both on the internal
# "licensing" Docker network), license-server's TCP peer for every real
# request is Caddy's own container IP on that network, not the original
# client's — set this to whatever CIDR covers that Docker network's
# subnet (check `docker network inspect licensing`, or pin it by giving
# that network a fixed `ipam.config.subnet` in docker-compose.yml) so
# Caddy's forwarded `X-Forwarded-For` is trusted and every other peer
# (i.e. anyone who isn't Caddy) is not.
#
# NEVER set this to a range that includes addresses the public internet
# can connect from — doing so lets any caller in that range forge
# X-Forwarded-For and bypass the rate limiter entirely for whatever IP
# they claim to be.
# TRUSTED_PROXY_CIDRS=172.20.0.0/16

# Production Hardening, Finding H4. How often (in seconds) the background
# rate-limiter cleanup sweep runs, evicting login/device rate-limit entries
# that have gone idle. Optional — default 900 (15 minutes) if unset.
#
# This is the sweep *interval*, not a standalone per-key idle timeout: an
# idle entry becomes eligible for removal once its own quota's bucket has
# fully replenished (a handful of seconds — 12s for the login limiter, 2s
# for the device limiter, intrinsic to their `Quota::per_minute` budgets
# and unaffected by this setting — see server/src/config.rs's
# RateLimitConfig doc comment for the full reasoning), and is then
# guaranteed to actually be reclaimed within this many seconds of that.
# Lower it (e.g. 60) for faster memory reclaim under
# heavy unique-caller churn; raise it if the periodic O(n) sweep itself
# ever needs to be rarer (unlikely at any traffic level this crate expects).
# RATE_LIMIT_ENTRY_TTL_SECONDS=900

# tracing-subscriber env-filter. Default: license_server=info,tower_http=info
RUST_LOG=license_server=info,tower_http=info

# sqlx Postgres connection pool size. Default: 5
DATABASE_MAX_CONNECTIONS=5

# Razorpay API credentials (PHASE4_DESIGN.md §6). All optional — an unset
# value means Razorpay isn't configured in this environment, surfaced
# honestly as PROVIDER_ERROR/401 rather than a startup failure (see
# config.rs's doc comment). Use test-mode keys until staging verification
# (PHASE4_DESIGN.md §10/§14 item 5) has passed.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=changeme
RAZORPAY_WEBHOOK_SECRET=changeme

# Razorpay Plan ids for recurring billing (server/src/razorpay/client.rs:
# HttpRazorpayClient::create_checkout). Under a rzp_test_... key these are
# unused — monthly/yearly checkout falls back to the same one-time Payment
# Links call lifetime/trial use, so local development needs neither set.
#
# Under a LIVE key (rzp_live_...), both are REQUIRED: monthly/yearly
# checkout goes through the real Razorpay Subscriptions API
# (POST /v1/subscriptions), which needs a real Plan id — there is no
# fallback. AppConfig::from_vars enforces this at startup (fails fast with
# ConfigError::LiveRazorpayKeyMissingPlanIds rather than only discovering
# the gap the first time a real customer picks that plan). Create the two
# Plans in the Razorpay dashboard (Subscriptions → Plans) — one for the
# monthly price, one for the yearly price, matching the amounts in
# server/src/service/payment_service.rs's PRICING table — and paste their
# plan_... ids here before switching KEY_ID/KEY_SECRET to live values.
RAZORPAY_MONTHLY_PLAN_ID=plan_changeme_monthly
RAZORPAY_YEARLY_PLAN_ID=plan_changeme_yearly

# Reserved for future use — NOT currently read by server/src/config.rs.
# Session tokens are random 256-bit values from the OS CSPRNG
# (server/src/auth/token.rs), not signed, so no secret is required to
# generate or verify them today (PHASE4_DESIGN.md §6: "no signing secret
# needed for random opaque tokens, unlike JWT").
SESSION_TOKEN_SECRET=changeme

# Reserved for future use — NOT currently read by server/src/config.rs.
# Password hashing (server/src/auth/password.rs) uses Argon2 with a random
# per-password salt, not a pepper/secret key.
ARGON2_SECRET=changeme

# ── Backup & Disaster Recovery (Phase 4L.2.1) ────────────────────────────
# NOT read by server/src/config.rs — these are read directly by
# server/deploy/backup.sh / restore.sh / verify-backup.sh (via
# server/.env, which those scripts also source). See server/README.md's
# "Backup location" section for the full operator checklist.

# Optional. If set, every backup.sh run AES-256-CBC-encrypts the dump
# (producing <dump>.sql.gz.enc instead of <dump>.sql.gz) using this as the
# passphrase. Unset means unencrypted backups, same as before this phase.
# Back this up somewhere OTHER than this backup directory itself — a lost
# key makes every encrypted backup permanently unreadable.
# BACKUP_ENCRYPTION_KEY=changeme

# Optional. If set, backup.sh runs this shell command after a successful
# local backup, with BACKUP_DIR exported for it to reference. No specific
# tool is required or assumed — use whatever your operations already run
# (rclone, aws s3, rsync, restic, ...). Unset means backups exist only on
# this host.
# OFFSITE_SYNC_CMD=rclone sync "$BACKUP_DIR" remote:license-server-backups

# Optional. Override the default retention window (14 daily backups, 8
# weekly backups) if your recovery-point-objective needs differ.
# DAILY_RETENTION=14
# WEEKLY_RETENTION=8

# Optional. Where backup.sh writes local backups. Default:
# /var/backups/license-server (outside every Docker volume by design).
# BACKUP_DIR=/var/backups/license-server
