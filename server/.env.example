# Copy to server/.env and fill in real values for your environment.
# server/.env is gitignored (see repo-root .gitignore's "*.env" pattern
# added in Phase 4H.1) — never commit real secrets.
#
# Read at startup by server/src/config.rs (AppConfig::from_env) unless
# noted otherwise below.

# Postgres connection string (required — no default; a missing value fails
# startup loudly rather than silently pointing at nothing). When running
# via docker-compose.yml, the host must be the "postgres" service name
# (Docker's internal DNS), not localhost — and the user/password/db here
# must match the POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB you export
# for the postgres service (docker-compose.yml, not this file).
DATABASE_URL=postgres://license_server:changeme@postgres:5432/license_server

# HTTP listener. Defaults: HOST=0.0.0.0, PORT=8080.
HOST=0.0.0.0
PORT=8080

# tracing-subscriber env-filter. Default: license_server=info,tower_http=info
RUST_LOG=license_server=info,tower_http=info

# sqlx Postgres connection pool size. Default: 5
DATABASE_MAX_CONNECTIONS=5

# Razorpay API credentials (PHASE4_DESIGN.md §6). All optional — an unset
# value means Razorpay isn't configured in this environment, surfaced
# honestly as PROVIDER_ERROR/401 rather than a startup failure (see
# config.rs's doc comment). Use test-mode keys until staging verification
# (PHASE4_DESIGN.md §10/§14 item 5) has passed.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=changeme
RAZORPAY_WEBHOOK_SECRET=changeme

# Reserved for future use — NOT currently read by server/src/config.rs.
# Session tokens are random 256-bit values from the OS CSPRNG
# (server/src/auth/token.rs), not signed, so no secret is required to
# generate or verify them today (PHASE4_DESIGN.md §6: "no signing secret
# needed for random opaque tokens, unlike JWT").
SESSION_TOKEN_SECRET=changeme

# Reserved for future use — NOT currently read by server/src/config.rs.
# Password hashing (server/src/auth/password.rs) uses Argon2 with a random
# per-password salt, not a pepper/secret key.
ARGON2_SECRET=changeme
