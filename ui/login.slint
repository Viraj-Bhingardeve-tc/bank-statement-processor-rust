// login.slint — Monthly-password login screen.
// Pixel-perfect match to login.html:
//   card: 380×auto, padding 36px 40px 32px, border-radius 10px, shadow 0 8px 32px rgba(0,0,0,.28)
//   brand → 28px gap → divider → 24px gap → form groups (label 5px → input, 16px between groups)
//   button: full-width, font-size 14px, font-weight 600, padding 10px (→ height ~44px), border-radius 5px
//   footer note: margin-top 22px, font-size 11px, color #90A4AE

import { VerticalBox } from "std-widgets.slint";

export component LoginScreen inherits Rectangle {
    in property <string>  error-message: "";
    in property <bool>    is-loading:    false;
    callback attempt-login(string, string);

    // Internal state to hold typed values
    in-out property <string> email-val: "";
    in-out property <string> pwd-val:   "";

    background: #1565C0;

    card := Rectangle {
        width:         380px;
        x:             (parent.width  - self.width)  / 2;
        y:             (parent.height - self.height) / 2;
        background:    #FFFFFF;
        border-radius: 10px;
        drop-shadow-blur:     32px;
        drop-shadow-color:    #00000047;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 8px;

        VerticalBox {
            padding-top:    36px;
            padding-left:   40px;
            padding-right:  40px;
            padding-bottom: 32px;
            spacing: 0px;

            // ── Brand (centered, name 20/800, sub 12/400) ─────────────────────
            Text {
                text: "A S Havaldar";
                font-size: 20px; font-weight: 800; color: #0D47A1;
                letter-spacing: 0.3px; horizontal-alignment: center;
            }
            Rectangle { height: 3px; }   // margin-top:3px on brand-sub
            Text {
                text: "Bank Statement Processor";
                font-size: 12px; color: #546E7A;
                horizontal-alignment: center;
            }
            Rectangle { height: 25px; }  // brand margin-bottom:28px total (3+25)

            // ── Divider + gap ─────────────────────────────────────────────────
            Rectangle { height: 1px; background: #BBDEFB; }
            Rectangle { height: 24px; }  // margin: 0 0 24px

            // ── Email group ───────────────────────────────────────────────────
            Text {
                text: "WORK EMAIL"; font-size: 11px; font-weight: 600;
                color: #37474F; letter-spacing: 0.5px;
            }
            Rectangle { height: 5px; }
            email-box := Rectangle {
                height: 36px; border-radius: 5px;
                border-width: 1px; border-color: email-ti.has-focus ? #1565C0 : #90CAF9;
                background: #FFFFFF;
                email-ti := TextInput {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    font-size: 13px; color: #0A1929;
                    vertical-alignment: center;
                    enabled: !root.is-loading;
                    text <=> root.email-val;
                    accepted => { pwd-ti.focus(); }
                }
            }
            Rectangle { height: 16px; }

            // ── Password group ────────────────────────────────────────────────
            Text {
                text: "THIS MONTH'S PASSWORD"; font-size: 11px; font-weight: 600;
                color: #37474F; letter-spacing: 0.5px;
            }
            Rectangle { height: 5px; }
            pwd-box := Rectangle {
                height: 36px; border-radius: 5px;
                border-width: 1px; border-color: pwd-ti.has-focus ? #1565C0 : #90CAF9;
                background: #FFFFFF;
                pwd-ti := TextInput {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    font-size: 13px; color: #0A1929;
                    vertical-alignment: center;
                    input-type: password;
                    enabled: !root.is-loading;
                    text <=> root.pwd-val;
                    accepted => {
                        if root.email-val != "" && root.pwd-val != "" {
                            root.attempt-login(root.email-val, root.pwd-val);
                        }
                    }
                }
            }
            Rectangle { height: 14px; }  // margin-top:4px on button + some spacing

            // ── Sign In button — full-width, 14px/600, #1565C0, radius 5px ───
            Rectangle {
                height:        44px;
                background:    root.is-loading ? #90CAF9 : #1565C0;
                border-radius: 5px;
                TouchArea {
                    enabled: !root.is-loading;
                    mouse-cursor: pointer;
                    clicked => { root.attempt-login(root.email-val, root.pwd-val); }
                }
                Text {
                    text: root.is-loading ? "Verifying…" : "Sign In";
                    font-size: 14px; font-weight: 600; color: #FFFFFF;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }

            // ── Error (margin-top:14px, padding 9px 12px) ────────────────────
            if root.error-message != "" : Rectangle { height: 14px; }
            if root.error-message != "" : Rectangle {
                height: 40px; background: #FFEBEE;
                border-radius: 5px; border-width: 1px; border-color: #FFCDD2;
                Text {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    text: root.error-message;
                    color: #B71C1C; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            // ── Footer note (margin-top:22px) ─────────────────────────────────
            Rectangle { height: 22px; }
            Text {
                text: "Password is valid for this month only.\nContact your administrator for access.";
                font-size: 11px; color: #90A4AE;
                horizontal-alignment: center; wrap: word-wrap;
            }
        }
    }

    init => { email-ti.focus(); }
}
