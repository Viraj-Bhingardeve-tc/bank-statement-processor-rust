// login.slint — Monthly-password login screen.
// Pixel-perfect match to login.html:
//   card: 380×auto, padding 36px 40px 32px, border-radius 10px, shadow 0 8px 32px rgba(0,0,0,.28)
//   brand → 28px gap → divider → 24px gap → form groups (label 5px → input, 16px between groups)
//   button: full-width, font-size 14px, font-weight 600, padding 10px (→ height ~44px), border-radius 5px
//   footer note: margin-top 22px, font-size 11px, color #90A4AE

import { VerticalBox } from "std-widgets.slint";

export component LoginScreen inherits Rectangle {
    in property <string>  error-message: "";
    in property <bool>    is-loading:    false;
    // True during the ~1.5s countdown before the app auto-quits after the 3rd
    // failed attempt — matches old app's lockout UX (login.html:196-201).
    in property <bool>    is-closing:    false;
    callback attempt-login(string, string);

    // Internal state to hold typed values
    in-out property <string> email-val: "";
    in-out property <string> pwd-val:   "";

    // ── License enforcement (Phase 4K.3) ──────────────────────────────────────
    // When license-blocked is true, this screen shows the license-key form
    // below instead of the password form — reusing the same properties/
    // callback the Settings screen's license section already exposes
    // (`app.slint`'s `license-status-text`/`license-key-input`/
    // `license-activate-result`/`do-license-activate`), just wired to a
    // second place they're shown from.
    in property <bool>       license-blocked:         false;
    in property <string>     license-status-text:      "";
    in-out property <string> license-key-input:        "";
    in property <string>     license-activate-result:  "";
    callback license-activate();

    background: #1565C0;

    card := Rectangle {
        width:         380px;
        x:             (parent.width  - self.width)  / 2;
        y:             (parent.height - self.height) / 2;
        background:    #FFFFFF;
        border-radius: 10px;
        drop-shadow-blur:     32px;
        drop-shadow-color:    #00000047;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 8px;

        VerticalBox {
            padding-top:    36px;
            padding-left:   40px;
            padding-right:  40px;
            padding-bottom: 32px;
            spacing: 0px;

            // ── Brand (centered, name 20/800, sub 12/400) ─────────────────────
            Text {
                text: "A S Havaldar";
                font-size: 20px; font-weight: 800; color: #0D47A1;
                letter-spacing: 0.3px; horizontal-alignment: center;
            }
            Rectangle { height: 3px; }   // margin-top:3px on brand-sub
            Text {
                text: "Bank Statement Processor";
                font-size: 12px; color: #546E7A;
                horizontal-alignment: center;
            }
            Rectangle { height: 25px; }  // brand margin-bottom:28px total (3+25)

            // ── Divider + gap ─────────────────────────────────────────────────
            Rectangle { height: 1px; background: #BBDEFB; }
            Rectangle { height: 24px; }  // margin: 0 0 24px

            // ── Password login form (hidden while license-blocked) ─────────────
            if !root.license-blocked : VerticalBox {
            padding: 0px;
            spacing: 0px;
            // Deferred one event-loop tick via Timer rather than focused
            // directly from `init`: this VerticalBox is itself lazily
            // instantiated (the `if` above), sometimes from inside an
            // in-progress geometry/layout computation (e.g. the first
            // pointer event over the login screen) — focusing synchronously
            // there re-enters that same in-progress layout-cache property
            // (via TextInput::focus_event's IME-positioning geometry
            // lookup) and Slint's cycle detector panics with "Recursion
            // detected". Firing from a Timer callback runs in a fresh,
            // unnested call stack once layout has settled, so the focus
            // grab (and its geometry lookup) sees a fully-resolved property
            // instead of one still being computed.
            autofocus-timer := Timer {
                interval: 1ms;
                running: true;
                triggered => {
                    self.running = false;
                    email-ti.focus();
                }
            }

            // ── Email group ───────────────────────────────────────────────────
            Text {
                text: "WORK EMAIL"; font-size: 11px; font-weight: 600;
                color: #37474F; letter-spacing: 0.5px;
            }
            Rectangle { height: 5px; }
            email-box := Rectangle {
                height: 36px; border-radius: 5px;
                border-width: 1px; border-color: email-ti.has-focus ? #1565C0 : #90CAF9;
                background: #FFFFFF;
                // Placeholder — visible when empty and not focused
                if root.email-val == "" && !email-ti.has-focus : Text {
                    x: 13px; width: parent.width - 26px; height: parent.height;
                    text: "yourname@company.com";
                    font-size: 13px; color: #AAAAAA; vertical-alignment: center; overflow: elide;
                }
                email-ti := TextInput {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    font-size: 13px; color: #0A1929;
                    vertical-alignment: center;
                    enabled: !root.is-loading && !root.is-closing;
                    text <=> root.email-val;
                    accessible-label: "Work email";
                    accepted => { pwd-ti.focus(); }
                }
            }
            Rectangle { height: 16px; }

            // ── Password group ────────────────────────────────────────────────
            Text {
                text: "THIS MONTH'S PASSWORD"; font-size: 11px; font-weight: 600;
                color: #37474F; letter-spacing: 0.5px;
            }
            Rectangle { height: 5px; }
            pwd-box := Rectangle {
                height: 36px; border-radius: 5px;
                border-width: 1px; border-color: pwd-ti.has-focus ? #1565C0 : #90CAF9;
                background: #FFFFFF;
                // Placeholder — visible when empty and not focused
                if root.pwd-val == "" && !pwd-ti.has-focus : Text {
                    x: 13px; width: parent.width - 26px; height: parent.height;
                    text: "XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX";
                    font-size: 13px; color: #AAAAAA; vertical-alignment: center; overflow: elide;
                }
                pwd-ti := TextInput {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    font-size: 13px; color: #0A1929;
                    vertical-alignment: center;
                    input-type: password;
                    enabled: !root.is-loading && !root.is-closing;
                    text <=> root.pwd-val;
                    accessible-label: "This month's password";
                    accepted => {
                        if root.email-val != "" && root.pwd-val != "" && !root.is-closing {
                            root.attempt-login(root.email-val, root.pwd-val);
                        }
                    }
                }
            }
            Rectangle { height: 4px; }  // margin-top:4px on .btn-login

            // ── Sign In button — full-width, 14px/600, #1565C0, radius 5px ───
            // Original: padding:10px both sides + font-size:14px ≈ 40px height
            Rectangle {
                height:        40px;
                background:    (root.is-loading || root.is-closing) ? #90CAF9 : #1565C0;
                border-radius: 5px;
                accessible-role: button;
                accessible-label: root.is-closing ? "Closing" : (root.is-loading ? "Verifying" : "Sign In");
                accessible-enabled: !root.is-loading && !root.is-closing;
                TouchArea {
                    enabled: !root.is-loading && !root.is-closing;
                    mouse-cursor: pointer;
                    clicked => { root.attempt-login(root.email-val, root.pwd-val); }
                }
                Text {
                    text: root.is-closing ? "Closing…" : (root.is-loading ? "Verifying…" : "Sign In");
                    font-size: 14px; font-weight: 600; color: #FFFFFF;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }

            // ── Error (margin-top:14px, padding 9px 12px) ────────────────────
            if root.error-message != "" : Rectangle { height: 14px; }
            if root.error-message != "" : Rectangle {
                height: 40px; background: #FFEBEE;
                border-radius: 5px; border-width: 1px; border-color: #FFCDD2;
                Text {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    text: root.error-message;
                    color: #B71C1C; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            } // if !root.license-blocked

            // ── License-required form (Phase 4K.3) ───────────────────────────
            // Shown instead of the password form when the currently
            // activated license is missing, expired, revoked, or has failed
            // offline-grace validation — reuses the same license-key input
            // and activation callback the Settings screen's license section
            // already provides.
            if root.license-blocked : VerticalBox {
            padding: 0px;
            spacing: 0px;

            Text {
                text: "LICENSE REQUIRED"; font-size: 11px; font-weight: 600;
                color: #37474F; letter-spacing: 0.5px;
            }
            Rectangle { height: 5px; }
            Rectangle {
                height: 40px; background: #FFF3E0;
                border-radius: 5px; border-width: 1px; border-color: #FFCC80;
                Text {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    text: root.license-status-text == "" ? "A valid license is required to continue." : root.license-status-text;
                    color: #E65100; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            Rectangle { height: 16px; }

            Text {
                text: "LICENSE KEY"; font-size: 11px; font-weight: 600;
                color: #37474F; letter-spacing: 0.5px;
            }
            Rectangle { height: 5px; }
            license-key-box := Rectangle {
                height: 36px; border-radius: 5px;
                border-width: 1px; border-color: license-key-ti.has-focus ? #1565C0 : #90CAF9;
                background: #FFFFFF;
                if root.license-key-input == "" && !license-key-ti.has-focus : Text {
                    x: 13px; width: parent.width - 26px; height: parent.height;
                    text: "XXXX-XXXX-XXXX-XXXX";
                    font-size: 13px; color: #AAAAAA; vertical-alignment: center; overflow: elide;
                }
                license-key-ti := TextInput {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    font-size: 13px; color: #0A1929;
                    vertical-alignment: center;
                    text <=> root.license-key-input;
                    accessible-label: "License key";
                    accepted => { root.license-activate(); }
                }
            }
            Rectangle { height: 4px; }

            Rectangle {
                height:        40px;
                background:    #1565C0;
                border-radius: 5px;
                accessible-role: button;
                accessible-label: "Activate license";
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.license-activate(); }
                }
                Text {
                    text: "Activate";
                    font-size: 14px; font-weight: 600; color: #FFFFFF;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }

            if root.license-activate-result != "" : Rectangle { height: 14px; }
            if root.license-activate-result != "" : Text {
                text: root.license-activate-result;
                font-size: 12px; color: #37474F;
                horizontal-alignment: center; wrap: word-wrap;
            }
            } // if root.license-blocked

            // ── Footer note (margin-top:22px) ─────────────────────────────────
            Rectangle { height: 22px; }
            Text {
                text: root.license-blocked
                    ? "Need a license? Contact your administrator or renew your subscription."
                    : "Password is valid for this month only.\nContact your administrator for access.";
                font-size: 11px; color: #90A4AE;
                horizontal-alignment: center; wrap: word-wrap;
            }
        }
    }
}
