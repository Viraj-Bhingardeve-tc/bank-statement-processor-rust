// app.slint — Root window. Switches between LoginScreen and MainScreen.

import { LoginScreen } from "login.slint";
import { MainScreen }  from "main_screen.slint";

export component AppWindow inherits Window {
    title:            "A S Havaldar — Bank Statement Processor";
    preferred-width:  1280px;
    preferred-height: 800px;
    min-width:        960px;
    min-height:       600px;

    // ── Auth state ────────────────────────────────────────────────────────────
    in-out property <bool>   logged-in:     false;
    in-out property <string> login-error:   "";
    in-out property <bool>   login-loading: false;

    // ── File / bank status (set by Rust after parse) ──────────────────────────
    in property <string> status-bank: "";
    in property <string> status-file: "";

    // ── Transaction table (set by Rust after parse) ───────────────────────────
    in property <[[StandardListViewItem]]> transaction-rows: [];

    // ── Dashboard summary (set by Rust after parse) ───────────────────────────
    in property <string> dash-bank-name:  "";
    in property <string> dash-opening:    "₹ —";
    in property <string> dash-credits:    "₹ —";
    in property <string> dash-debits:     "₹ —";
    in property <string> dash-closing:    "₹ —";
    in property <string> dash-txn-count:  "—";
    in property <string> dash-vendors:    "—";

    // ── Client list (Phase 9) ─────────────────────────────────────────────────
    in property <[string]> client-names: ["-- Select Client --"];

    // ── Callbacks implemented in Rust ─────────────────────────────────────────
    callback do-login(string, string);
    callback do-load-file();
    callback do-batch-folder();

    // ── Login screen ──────────────────────────────────────────────────────────
    if !root.logged-in : LoginScreen {
        error-message: root.login-error;
        is-loading:    root.login-loading;
        attempt-login(email, password) => { root.do-login(email, password); }
    }

    // ── Main screen ───────────────────────────────────────────────────────────
    if root.logged-in : MainScreen {
        client-names:     root.client-names;
        status-bank:      root.status-bank;
        status-file:      root.status-file;
        transaction-rows: root.transaction-rows;
        dash-bank-name:   root.dash-bank-name;
        dash-opening:     root.dash-opening;
        dash-credits:     root.dash-credits;
        dash-debits:      root.dash-debits;
        dash-closing:     root.dash-closing;
        dash-txn-count:   root.dash-txn-count;
        dash-vendors:     root.dash-vendors;
        logout       => { root.logged-in = false; root.login-error = ""; }
        load-file    => { root.do-load-file();    }
        batch-folder => { root.do-batch-folder(); }
    }
}
