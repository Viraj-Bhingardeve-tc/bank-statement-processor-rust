        } // end content wrapper Rectangle

        // ─────────────────────────── ACTION BAR ───────────────────────────────
        // Redesigned (Phase 2): grouped AppButton variants — Export/Reconcile
        // primary, Re-import secondary, Reset Dedupe danger, Batch Monitor/
        // Audit Trail/Settings ghost — same callbacks/bodies as before.
        TxnActionBar {
            height: 56px;

            AppButton { text: "Export to Excel";    variant: "primary"; compact: true; enabled: root.transaction-rows.length > 0; clicked => { root.modal-state = "excel-export"; } }
            AppButton { text: "\u{21D3} Export for Accounting"; variant: "primary"; compact: true; enabled: root.transaction-rows.length > 0; clicked => { root.wiz-step = 1; root.wiz-state-idx = root.settings-state-idx; root.modal-state = "export-wizard"; } }
            AppButton { text: "Quick Tally XML";     variant: "primary"; compact: true; enabled: root.transaction-rows.length > 0; clicked => { root.modal-state = "tally-export"; } }
            AppButton { text: "Re-import Excel";     variant: "secondary"; compact: true; enabled: root.transaction-rows.length > 0; clicked => { root.reimport-excel(); } }
            AppButton {
                text: "Reset Dedupe History"; variant: "danger"; compact: true;
                enabled: root.transaction-rows.length > 0;
                clicked => {
                    root.confirm-title = "Reset Dedupe History";
                    // Requirement #10: this action also re-runs within-session
                    // duplicate detection (dup_flag/DUP tags on the currently
                    // loaded rows) — the message previously only mentioned
                    // clearing cross-import history, understating what it does.
                    root.confirm-message = "Clear cross-import dedupe history and re-check the loaded transactions for duplicates?";
                    root.confirm-action = "reset-dedupe";
                    root.confirm-payload = -1;
                    root.modal-state = "confirm";
                }
            }

            Rectangle { width: 1px; height: 26px; background: FintechPalette.border; }

            AppButton { text: "Reconcile";     variant: "primary"; compact: true; enabled: root.transaction-rows.length > 0; clicked => { root.modal-state = "reconcile"; } }
            AppButton { text: "Batch Monitor"; variant: "ghost"; compact: true; clicked => { root.modal-state = "batch-monitor"; } }
            AppButton { text: "Audit Trail";   variant: "ghost"; compact: true; clicked => { root.modal-state = "audit-trail";  } }
            AppButton { text: "Settings";      variant: "ghost"; compact: true; clicked => { root.modal-state = "settings";     } }

            Rectangle { horizontal-stretch: 1; }

            // Audit fix (2026-08-05): "logout" was already wired
            // end-to-end (app.slint forwards it to logged-in = false)
            // but nothing in the UI ever invoked it — there was no way
            // to sign out short of quitting the app. Routed through
            // the existing confirm modal like Reset Dedupe/Clear Logs
            // above, since it's a "leave your place" action worth a
            // confirmation, not a destructive one.
            AppButton {
                text: "Logout"; variant: "secondary"; compact: true;
                clicked => {
                    root.confirm-title = "Logout";
                    root.confirm-message = "Sign out and return to the login screen?";
                    root.confirm-action = "logout";
                    root.confirm-payload = -1;
                    root.modal-state = "confirm";
                }
            }
        }
    }

    // ─────────────────────────── DASHBOARD (redesigned shell) ─────────────────
    // New persistent Sidebar + TopHeader chrome, Dashboard tab only — see the
    // "MAIN LAYOUT (Transactions tab)" comment above for why the two shells
    // are now mutually-exclusive sibling branches instead of nested inside
    // one shared layout. Every handler below routes to functionality that
    // already exists elsewhere in this file (the exact same modal-state
    // values / callbacks the Transactions toolbar and footer already use) —
    // no new backend behavior, only new routing to old behavior.
    if root.show-dashboard : HorizontalLayout {
        width: root.width; height: root.height;
        padding: 0px; spacing: 0px;

        if !root.dash-sidebar-collapsed : Sidebar {
            bank-name:  root.dash-bank-name;
            account-no: root.dash-account-no;
            period:     root.dash-period;
            nav-transactions => { root.show-dashboard = false; }
            nav-ai-classify  => { root.ai-consent-checked = false; root.modal-state = "ai-consent"; }
            nav-rules        => { root.view-rules(); root.modal-state = "view-rules"; }
            // Clients / Vendors-Ledgers: no dedicated screen exists for
            // either — the real client tools (dropdown, +New/Edit Client)
            // and per-account/party breakdowns live in the Transactions
            // tab's toolbar/summary panel, so route there.
            nav-clients      => { root.show-dashboard = false; }
            nav-vendors      => { root.show-dashboard = false; }
            nav-import       => { root.load-file(); }
            nav-reports      => { root.wiz-step = 1; root.wiz-state-idx = root.settings-state-idx; root.modal-state = "export-wizard"; }
            nav-reconcile    => { root.modal-state = "reconcile"; }
            nav-batch        => { root.modal-state = "batch-monitor"; }
            nav-settings     => { root.modal-state = "settings"; }
            change-clicked   => { root.show-dashboard = false; }
        }

        VerticalLayout {
            padding: 0px; spacing: 0px;
            horizontal-stretch: 1;

            TopHeader {
                needs-review-count: root.dash-needs-review;
                // Real window width (root here is MainScreen's own root,
                // sized by the window — not derived from TopHeader's
                // layout), so TopHeader can tell 1280px-class windows
                // apart from 1366px+ without a binding loop on its own
                // width. See compact-header in dashboard.slint.
                viewport-width: root.width;
                sidebar-collapsed <=> root.dash-sidebar-collapsed;
                search-text <=> root.dash-search-text;
                search-changed(v) => { root.dash-search-changed(v); }
                new-client-clicked => { root.modal-state = "new-client"; }
                logout-clicked => {
                    root.confirm-title = "Logout";
                    root.confirm-message = "Sign out and return to the login screen?";
                    root.confirm-action = "logout";
                    root.confirm-payload = -1;
                    root.modal-state = "confirm";
                }
                // Reuses the exact same "needs review" drill-down the
                // Summary panel's own "Needs Review" row already performs
                // (see the `SR { lbl: "Needs Review"; ... }` row above).
                notifications-clicked => { root.show-dashboard = false; root.active-filter = "needs_review"; root.drill-filter("needs_review"); }
                qa-import-clicked      => { root.load-file(); }
                qa-ai-classify-clicked => { root.ai-consent-checked = false; root.modal-state = "ai-consent"; }
                qa-rules-clicked       => { root.view-rules(); root.modal-state = "view-rules"; }
                qa-reconcile-clicked   => { root.modal-state = "reconcile"; }
                qa-reports-clicked     => { root.wiz-step = 1; root.wiz-state-idx = root.settings-state-idx; root.modal-state = "export-wizard"; }
            }

            DashboardScreen {
                vertical-stretch: 1;
                opening-balance: root.dash-opening;
                total-credits:   root.dash-credits;
                total-debits:    root.dash-debits;
                closing-balance: root.dash-closing;
                net-cash-flow:   root.dash-net-flow;
                txn-count:       root.dash-txn-count;
                vendor-count:    root.dash-vendors;
                top-expense:     root.dash-top-expense;
                top-expense-amt: root.dash-top-exp-amt;
                credit-count:    root.dash-credit-count;
                debit-count:     root.dash-debit-count;
                has-data:        root.dash-has-data;
                chart-monthly:    root.dash-chart-monthly;
                chart-expenses:   root.dash-chart-expenses;
                chart-cashflow:   root.dash-chart-cashflow;
                chart-vendors:    root.dash-chart-vendors;
                transaction-rows: root.transaction-rows;
                filter-banks:    root.dash-filter-banks;
                filter-vendors:  root.dash-filter-vendors;
                filter-heads:    root.dash-filter-heads;
                dash-from       <=> root.dash-pf-from;
                dash-to         <=> root.dash-pf-to;
                dash-bank-idx   <=> root.dash-pf-bank-idx;
                dash-vendor-idx <=> root.dash-pf-vendor-idx;
                dash-head-idx   <=> root.dash-pf-head-idx;
                search-text: root.dash-search-text;
                search-results: root.dash-search-rows;
                ins-max-dr:       root.dash-ins-max-dr;
                ins-max-dr-narr:  root.dash-ins-max-dr-narr;
                ins-max-cr:       root.dash-ins-max-cr;
                ins-max-cr-narr:  root.dash-ins-max-cr-narr;
                ins-avg-dr:       root.dash-ins-avg-dr;
                ins-avg-cr:       root.dash-ins-avg-cr;
                ins-dr-count:     root.dash-ins-dr-count;
                ins-cr-count:     root.dash-ins-cr-count;
                ins-freq-vendor:  root.dash-ins-freq-vendor;
                dash-filter-changed(f, t, b, v, h) => { root.dash-filter-changed(f, t, b, v, h); }
                dash-date-preset(p) => { return root.dash-date-preset(p); }
                card-credits-clicked => { root.show-dashboard = false; root.active-filter = "credits"; root.drill-filter("credits"); }
                card-debits-clicked  => { root.show-dashboard = false; root.active-filter = "debits";  root.drill-filter("debits"); }
                card-txns-clicked    => { root.show-dashboard = false; root.active-filter = "all";     root.drill-filter("all"); }
                view-all-clicked     => { root.show-dashboard = false; root.active-filter = "all";     root.drill-filter("all"); }
                qa-import-clicked       => { root.load-file(); }
                qa-ai-classify-clicked  => { root.ai-consent-checked = false; root.modal-state = "ai-consent"; }
                qa-rules-clicked        => { root.view-rules(); root.modal-state = "view-rules"; }
                qa-reconcile-clicked    => { root.modal-state = "reconcile"; }
                qa-reports-clicked      => { root.wiz-step = 1; root.wiz-state-idx = root.settings-state-idx; root.modal-state = "export-wizard"; }
                // No dedicated "AI Insights" screen exists — the Insights
                // strip is already part of this same Dashboard page, so
                // this reuses the one real AI feature in the app (the same
                // AI-classify consent flow as the card above it) rather
                // than inventing a second screen.
                qa-insights-clicked     => { root.ai-consent-checked = false; root.modal-state = "ai-consent"; }
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MODAL OVERLAYS
    // ═══════════════════════════════════════════════════════════════════════════
    // Wrapped in a FocusScope so Escape closes whichever modal is open, matching
    // the old app's global `document.keydown` handler (app.js:302-306). Given
    // focus whenever modal-state transitions away from "" (see `changed
    // modal-state` below); unhandled Escape from a focused LineEdit inside any
    // modal bubbles up to this ancestor scope automatically.
    modal-esc-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape && root.modal-state != "") {
                root.modal-state = "";
                accept
            } else {
                reject
            }
        }

    if root.modal-state == "new-client" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 310px) / 2;
            width: 470px; height: 310px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Add New Client"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "Client Name *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. Acme Pvt Ltd"; height: 34px;
                        text: root.new-client-name;
                        edited(v) => { root.new-client-name = v; }
                    }
                    Text { text: "Bank Ledger Name in Tally *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. HDFC Bank A/c - 5021"; height: 34px;
                        text: root.new-client-ledger;
                        edited(v) => { root.new-client-ledger = v; }
                    }
                    // .fg small { font-size:11px; color:#999; margin-top:3px }
                    Text { text: "Must exactly match the ledger name in your Tally company (case-sensitive)"; font-size: 11px; color: #999999; wrap: word-wrap; }
                }
                MFtr {
                    MBtn { text: "Save Client"; bg: #1565C0; clicked => {
                        if (root.new-client()) {
                            root.modal-state = "";
                            root.new-client-name = "";
                            root.new-client-ledger = "";
                        }
                    } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // Generic confirmation modal — matches the old app's native confirm() dialogs.
    if root.modal-state == "confirm" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        Rectangle {
            x: (parent.width - 420px) / 2; y: (parent.height - 200px) / 2;
            width: 420px; height: 200px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #C62828; }
                MHdr { title: root.confirm-title; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text {
                        text: root.confirm-message; font-size: 13px; color: #263238;
                        wrap: word-wrap; vertical-alignment: center;
                    }
                }
                MFtr {
                    MBtn {
                        text: "Yes, Continue"; bg: #C62828; clicked => {
                            if (root.confirm-action == "logout") {
                                // Reset this modal's own state first, then
                                // fire logout last — it's the only
                                // confirm-action that tears down MainScreen
                                // itself (app.slint's `logged-in = false`),
                                // so nothing should run against `root`
                                // afterward (audit fix, 2026-08-05).
                                root.confirm-action = "";
                                root.modal-state = "";
                                root.logout();
                            } else {
                                if (root.confirm-action == "reset-dedupe") { root.reset-dedupe(); }
                                else if (root.confirm-action == "clear-logs") { root.clear-logs(); }
                                else if (root.confirm-action == "delete-txn") { root.delete-txn(root.confirm-payload); }
                                else if (root.confirm-action == "delete-rule") { root.delete-rule(root.confirm-payload); }
                                else if (root.confirm-action == "delete-import") { root.delete-import(root.confirm-payload); }
                                else if (root.confirm-action == "reload-import") { root.reload-import(root.confirm-payload); }
                                root.confirm-action = "";
                                root.modal-state = "";
                            }
                        }
                    }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.confirm-action = ""; root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "ai-settings" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 360px) / 2;
            width: 470px; height: 360px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "\u{2605} AI Classifier \u{2014} Settings"; bg: #FFF8E1; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "AI Provider"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    ComboBox {
                        model: ["OpenAI (GPT-4o-mini)", "Anthropic Claude (Haiku)", "Google Gemini 1.5 Flash"];
                        current-index: root.ai-provider-idx;
                        height: 34px;
                        selected(v) => { root.ai-provider-idx = self.current-index; }
                    }
                    Text { text: "API Key"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "sk-..."; height: 34px; input-type: password;
                        text: root.ai-api-key;
                        edited(v) => { root.ai-api-key = v; }
                    }
                    Text { text: "Classify which transactions"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    ComboBox {
                        model: ["Unclassified / low-confidence only (recommended)", "All transactions"];
                        current-index: root.ai-scope-idx;
                        height: 34px;
                        selected(v) => { root.ai-scope-idx = self.current-index; }
                    }
                    Rectangle {
                        height: 40px; background: #F3E5F5; border-radius: 4px;
                        border-width: 1px; border-color: #CE93D8;
                        HorizontalBox { padding: 10px; Text { text: "\u{2139} AI suggestions are not guaranteed accurate. Always review before exporting."; font-size: 10px; color: #6A1B9A; wrap: word-wrap; vertical-alignment: center; } }
                    }
                }
                MFtr {
                    // Requirement #12 fix: `settings-save` (provider/key/
                    // enabled) had a complete, working Rust handler and DB/
                    // keyring persistence layer, but nothing in the UI ever
                    // called it — the provider and API key typed here were
                    // used for this one run and then lost, forcing the user
                    // to retype the key every session despite the app
                    // already loading a persisted key at startup. Saving
                    // here, right when the user actually uses it, closes
                    // that loop with the existing mechanism instead of
                    // inventing a new one.
                    MBtn { text: "\u{2605} Start AI Classification"; bg: #6B2FB8; fg: white; clicked => {
                        root.modal-state = "";
                        root.settings-save(
                            root.ai-provider-idx == 1 ? "1" : root.ai-provider-idx == 2 ? "2" : "0",
                            root.ai-api-key,
                            true
                        );
                        root.ai-classify();
                    } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "tally-export" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 510px) / 2;
            width: 470px; height: 510px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Quick Tally XML Export"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "Tally Company Name *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit { placeholder-text: "Must match Tally exactly (case-sensitive)"; height: 34px; text <=> root.wiz-company; }
                    Text { text: "GSTIN (optional)"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit { placeholder-text: "e.g. 27AABCU9603R1ZX"; height: 34px; text <=> root.wiz-gstin; }
                    HorizontalBox { padding: 0px; spacing: 12px;
                        VerticalBox { padding: 0px; spacing: 6px; horizontal-stretch: 1;
                            Text { text: "From Date"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            LineEdit { placeholder-text: "DD/MM/YYYY"; height: 34px; text <=> root.wiz-from; }
                        }
                        VerticalBox { padding: 0px; spacing: 6px; horizontal-stretch: 1;
                            Text { text: "To Date"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            LineEdit { placeholder-text: "DD/MM/YYYY"; height: 34px; text <=> root.wiz-to; }
                        }
                    }
                    CheckBox { text: "Export only classified transactions"; checked <=> root.wiz-opt-classified; }
                    CheckBox { text: "Auto-create ledgers in Tally"; checked <=> root.wiz-opt-ledger; }
                    CheckBox { text: "Include narrations in vouchers"; checked <=> root.wiz-opt-narr; }
                    CheckBox { text: "Include Opening Balance journal entry"; checked <=> root.wiz-opt-ob; }
                    CheckBox { text: "Skip low-confidence entries (<40%)"; checked <=> root.wiz-opt-skip-low; }
                    CheckBox { text: "Skip duplicate-flagged transactions"; checked <=> root.wiz-opt-skip-dup; }
                }
                MFtr {
                    MBtn { text: "Export Tally XML"; bg: #2E7D32; fg: white; clicked => { root.modal-state = ""; root.export-tally(); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "excel-export" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 440px) / 2; y: (parent.height - 260px) / 2;
            width: 440px; height: 260px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "\u{2193} Export to Excel"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "Choose which transactions to include:"; font-size: 13px; color: #555555; }
                    // Radio: All transactions (selected by default)
                    property <bool> xl-all-selected: true;
                    HorizontalBox { padding: 0px; spacing: 8px;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 8px;
                            background: xl-all-selected ? #1565C0 : #F5F5F5;
                            border-width: 2px;
                            border-color: xl-all-selected ? #1565C0 : #BDBDBD;
                            TouchArea { clicked => { xl-all-selected = true; } }
                        }
                        Text { text: "All transactions (" + root.fc-all + ")";
                               font-size: 12px; font-weight: 600; color: #37474F; vertical-alignment: center; }
                    }
                    HorizontalBox { padding: 0px; spacing: 8px;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 8px;
                            background: !xl-all-selected ? #1565C0 : #F5F5F5;
                            border-width: 2px;
                            border-color: !xl-all-selected ? #1565C0 : #BDBDBD;
                            TouchArea { clicked => { xl-all-selected = false; } }
                        }
                        Text { text: "Filtered transactions only";
                               font-size: 12px; color: #37474F; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 42px; background: #F0F7FF; border-radius: 6px;
                        border-width: 1px; border-color: #CCE4FF;
                        HorizontalBox { padding: 10px; Text { text: "\u{2139} Generates 7 sheets: Transactions, Summary, Ledger Analysis, GST & Tax, Duplicates, Review Required, Audit Summary."; font-size: 11px; color: #1A5276; wrap: word-wrap; } }
                    }
                }
                MFtr {
                    MBtn { text: "\u{2193} Generate Excel"; bg: #1565C0; clicked => { root.modal-state = ""; root.export-excel(); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "settings" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 520px) / 2;
            width: 700px; height: 520px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Application Settings"; close => { root.modal-state = ""; } }
                ScrollView { vertical-stretch: 1;
                    VerticalBox { padding: 18px; spacing: 12px;
                        // Narration Cleaner section
                        Rectangle {
                            height: 1px; background: #E3F2FD;
                        }
                        Text { text: "NARRATION CLEANER"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        CheckBox { text: "Enable narration cleaning"; checked <=> root.settings-narr-enabled; }
                        CheckBox { text: "Convert to Title Case"; checked <=> root.settings-narr-title-case; }
                        CheckBox { text: "Preserve original narration"; checked <=> root.settings-narr-preserve; }
                        Rectangle { height: 1px; background: #E3F2FD; }
                        Text { text: "GST ENGINE"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        CheckBox { text: "Enable GST detection"; checked <=> root.settings-gst-enabled; }
                        CheckBox { text: "Auto-suggest GST ledgers"; checked <=> root.settings-gst-auto-ledgers; }
                        HorizontalBox { padding: 0px; spacing: 8px;
                            Text { text: "Default State"; font-size: 11px; color: #546E7A; vertical-alignment: center; }
                            ComboBox { model: ["Maharashtra (MH)", "Gujarat (GJ)", "Delhi (DL)", "Karnataka (KA)", "Tamil Nadu (TN)", "Telangana (TG)", "Rajasthan (RJ)", "UP (UP)", "West Bengal (WB)"]; min-width: 200px; current-index <=> root.settings-state-idx; }
                        }
                        Rectangle { height: 1px; background: #E3F2FD; }
                        Text { text: "RECONCILIATION"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        HorizontalBox { padding: 0px; spacing: 12px;
                            VerticalBox { padding: 0px; spacing: 4px;
                                Text { text: "Date Fuzzy Window (days)"; font-size: 11px; color: #546E7A; }
                                LineEdit { text <=> root.settings-recon-days; height: 30px; min-width: 70px; max-width: 80px; }
                            }
                            VerticalBox { padding: 0px; spacing: 4px;
                                Text { text: "Amount Tolerance (%)"; font-size: 11px; color: #546E7A; }
                                LineEdit { text <=> root.settings-recon-pct; height: 30px; min-width: 70px; max-width: 80px; }
                            }
                        }
                        Rectangle { height: 1px; background: #E3F2FD; }
                        Text { text: "LOGGING"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        HorizontalBox { padding: 0px; spacing: 8px;
                            Text { text: "Log Level"; font-size: 11px; color: #546E7A; vertical-alignment: center; }
                            ComboBox { model: ["INFO", "DEBUG", "WARN", "ERROR"]; current-index <=> root.settings-log-level; min-width: 100px; }
                        }
                        Rectangle {
                            height: 30px; width: 140px;
                            background: #C62828; border-radius: 4px;
                            accessible-role: button;
                            accessible-label: "Clear All Logs";
                            TouchArea { clicked => {
                                root.confirm-title = "Clear All Logs";
                                root.confirm-message = "Clear all logs?";
                                root.confirm-action = "clear-logs";
                                root.confirm-payload = -1;
                                root.modal-state = "confirm";
                            } }
                            Text { text: "Clear All Logs"; font-size: 11px; color: white;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle { height: 1px; background: #E3F2FD; }
                        Text { text: "DATA MIGRATION"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        Text {
                            text: "Moving from the old desktop app? Import your clients, rules, ledgers, transaction history, and settings in one step.";
                            font-size: 11px; color: #546E7A; wrap: word-wrap; width: 640px;
                        }
                        Rectangle {
                            height: 30px; width: 190px;
                            background: #1565C0; border-radius: 4px;
                            accessible-role: button;
                            accessible-label: "Import Legacy Data";
                            TouchArea { clicked => { root.modal-state = "migration"; } }
                            Text { text: "Import Legacy Data\u{2026}"; font-size: 11px; color: white;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle { height: 1px; background: #E3F2FD; }
                        Text { text: "LICENSE"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        Text { text: root.license-status-text; font-size: 11px; color: #546E7A; wrap: word-wrap; width: 640px; }
                        HorizontalBox { padding: 0px; spacing: 8px;
                            LineEdit {
                                text <=> root.license-key-input;
                                placeholder-text: "License key (XXXX-XXXX-XXXX-XXXX)";
                                height: 30px; min-width: 260px;
                            }
                            Rectangle {
                                height: 30px; width: 100px;
                                background: #1565C0; border-radius: 4px;
                                accessible-role: button;
                                accessible-label: "Activate License";
                                TouchArea { clicked => { root.license-activate(); } }
                                Text { text: "Activate"; font-size: 11px; color: white;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                            // Re-checks the already-activated license
                            // without needing a key retyped (audit fix,
                            // 2026-08-05, "Subscription refresh" — see
                            // main.rs's on_do_license_refresh).
                            Rectangle {
                                height: 30px; width: 120px;
                                background: #546E7A; border-radius: 4px;
                                accessible-role: button;
                                accessible-label: "Refresh Status";
                                TouchArea { clicked => { root.license-refresh(); } }
                                Text { text: "Refresh Status"; font-size: 11px; color: white;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                            // Reuses LoginScreen's pricing/checkout page
                            // (audit fix, 2026-08-05, "Upgrade flow") — see
                            // app.slint's `change-plan` handler.
                            Rectangle {
                                height: 30px; width: 110px;
                                background: #FFFFFF; border-radius: 4px;
                                border-width: 1px; border-color: #1565C0;
                                accessible-role: button;
                                accessible-label: "Change Plan";
                                TouchArea { clicked => { root.change-plan(); } }
                                Text { text: "Change Plan"; font-size: 11px; color: #1565C0;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if root.license-activate-result != "" : Text {
                            text: root.license-activate-result; font-size: 11px;
                            color: root.license-activate-result-kind == 1 ? #2E7D32
                                : root.license-activate-result-kind == 2 ? #C62828 : #546E7A;
                            font-weight: root.license-activate-result-kind == 0 ? 400 : 700;
                            wrap: word-wrap; width: 640px;
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Save Settings"; bg: #1565C0; clicked => { root.modal-state = ""; root.settings-save-all(); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "import-history" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 400px) / 2;
            width: 700px; height: 400px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Import History"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 8px; vertical-stretch: 1;
                    Text { text: "Up to 20 imports per client are recorded in the database."; font-size: 11px; color: #888888; wrap: word-wrap; }
                    if root.import-records.length == 0 : Rectangle {
                        height: 60px; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        Text { text: "No import history for this client yet."; font-size: 13px; color: #BDBDBD; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.import-records.length > 0 : Rectangle {
                        vertical-stretch: 1;
                        // Header row
                        Rectangle {
                            y: 0; height: 28px; background: #1565C0;
                            HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px;
                                Text { text: "File / Batch"; font-size: 12px; font-weight: 600; color: white; horizontal-stretch: 2; vertical-alignment: center; }
                                Text { text: "Date"; font-size: 12px; font-weight: 600; color: white; min-width: 140px; vertical-alignment: center; }
                                Text { text: "Txns"; font-size: 12px; font-weight: 600; color: white; min-width: 50px; vertical-alignment: center; }
                            }
                        }
                        ListView {
                            y: 28px; height: parent.height - 28px;
                            for rec[i] in root.import-records : Rectangle {
                                height: 26px; background: #FFFFFF;
                                Rectangle { y: 25px; height: 1px; background: #E3F2FD; }
                                TouchArea {
                                    clicked => {
                                        if (root.transaction-rows.length > 0) {
                                            root.confirm-title = "Replace Loaded Transactions";
                                            root.confirm-message = "Loading this import will replace all currently loaded transactions. Continue?";
                                            root.confirm-action = "reload-import";
                                            root.confirm-payload = i;
                                            root.modal-state = "confirm";
                                        } else {
                                            root.modal-state = "";
                                            root.reload-import(i);
                                        }
                                    }
                                    mouse-cursor: pointer;
                                }
                                HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 8px;
                                    // Format: "FILE\tDATE\tCOUNT" — split by tab
                                    Text {
                                        text: rec;  // show full record; Rust formats nicely
                                        font-size: 12px; color: #0A1929;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center; overflow: elide;
                                    }
                                    Rectangle {
                                        width: 56px; height: 18px; border-radius: 4px;
                                        background: #FFEBEE; border-width: 1px; border-color: #EF9A9A;
                                        Text { text: "Remove"; font-size: 9px; color: #C62828; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.confirm-title = "Remove Import History Entry";
                                                root.confirm-message = "Remove this entry from import history? (The original file is not affected.)";
                                                root.confirm-action = "delete-import";
                                                root.confirm-payload = i;
                                                root.modal-state = "confirm";
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "view-rules" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 400px) / 2;
            width: 700px; height: 400px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Learned Rules"; close => { root.modal-state = ""; } }
                if root.rule-records.length == 0 : Rectangle {
                    vertical-stretch: 1; background: #F5F5F5;
                    Text { text: "No learned rules yet. Edit transactions and click \"Save & Learn\" to create rules."; font-size: 13px; color: #BDBDBD; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                }
                if root.rule-records.length > 0 : Rectangle {
                    vertical-stretch: 1;
                    Rectangle {
                        y: 0; height: 28px; background: #1565C0;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px;
                            Text { text: "Pattern"; font-size: 12px; font-weight: 600; color: white; horizontal-stretch: 2; vertical-alignment: center; }
                            Text { text: "Vendor"; font-size: 12px; font-weight: 600; color: white; min-width: 110px; vertical-alignment: center; }
                            Text { text: "Account Head"; font-size: 12px; font-weight: 600; color: white; min-width: 110px; vertical-alignment: center; }
                            Text { text: "Type"; font-size: 12px; font-weight: 600; color: white; min-width: 60px; vertical-alignment: center; }
                        }
                    }
                    ListView {
                        y: 28px; height: parent.height - 28px;
                        for rec[i] in root.rule-records : Rectangle {
                            height: 26px; background: #FFFFFF;
                            Rectangle { y: 25px; height: 1px; background: #E3F2FD; }
                            Text {
                                x: 10px; width: parent.width - 86px; height: parent.height;
                                text: rec;
                                font-size: 11px; color: #0A1929;
                                vertical-alignment: center; overflow: elide;
                            }
                            Rectangle {
                                x: parent.width - 66px; y: 4px;
                                width: 56px; height: 18px; border-radius: 4px;
                                background: #FFEBEE; border-width: 1px; border-color: #EF9A9A;
                                Text { text: "Delete"; font-size: 9px; color: #C62828; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.confirm-title = "Delete Rule";
                                        root.confirm-message = "Delete this rule?";
                                        root.confirm-action = "delete-rule";
                                        root.confirm-payload = i;
                                        root.modal-state = "confirm";
                                    }
                                }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Backup Rules"; bg: #1565C0; clicked => { root.backup-rules(); } }
                    MBtn { text: "Restore Rules"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.restore-rules(); } }
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "batch-monitor" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 820px) / 2; y: (parent.height - 480px) / 2;
            width: 820px; height: 480px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Batch Processing Monitor"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 14px; spacing: 8px; vertical-stretch: 1;
                    HorizontalBox { padding: 0px; spacing: 8px;
                        // Requirement #11 fix: this was previously labeled
                        // "Start Batch" but never started anything — it only
                        // ever re-reads the current session's results
                        // (`open-batch-monitor` → `do-batch-monitor`). Now
                        // that finish_batch/batch-start auto-refresh this
                        // table on their own, this button is purely a manual
                        // refresh, so it's labeled to match. Use the
                        // toolbar's "Batch Process Folder" to actually start
                        // a batch (per the hint text below when empty).
                        MBtn { text: "Refresh"; bg: #1565C0; clicked => { root.open-batch-monitor(); } }
                        MBtn {
                            text: root.batch-paused ? "Resume" : "Pause";
                            bg: #F5F5F5; fg: root.batch-running ? #37474F : #BDBDBD;
                            enabled: root.batch-running;
                            clicked => { root.batch-pause(); }
                        }
                        MBtn {
                            text: "Abort"; bg: root.batch-running ? #FFEBEE : #F5F5F5; fg: root.batch-running ? #C62828 : #BDBDBD;
                            enabled: root.batch-running;
                            clicked => { root.batch-abort(); }
                        }
                        MBtn { text: "Load All into Session"; bg: #2E7D32; fg: white; enabled: true; clicked => { root.load-all(); } }
                    }
                    // Summary line / empty hint
                    if root.batch-log != "" : Rectangle {
                        height: 28px; background: #E3F2FD; border-radius: 4px;
                        Text { text: root.batch-log; font-size: 12px; color: #1565C0;
                               x: 10px; y: 6px; overflow: elide; width: parent.width - 20px; }
                    }
                    if root.batch-file-rows.length == 0 : Rectangle {
                        vertical-stretch: 1; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        Text {
                            text: "Use \"Batch Process Folder\" in the toolbar to select multiple files.";
                            font-size: 12px; color: #90A4AE;
                            wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    if root.batch-file-rows.length > 0 : VerticalBox { padding: 0px; spacing: 0px; vertical-stretch: 1;
                        // Column headers
                        Rectangle {
                            height: 26px; background: #37474F; border-radius: 4px;
                            HorizontalLayout { padding: 6px; spacing: 0px;
                                Text { text: "File"; font-size: 11px; color: white; font-weight: 700; width: 180px; }
                                Text { text: "Bank"; font-size: 11px; color: white; font-weight: 700; width: 140px; }
                                Text { text: "Account"; font-size: 11px; color: white; font-weight: 700; width: 120px; }
                                Text { text: "Period"; font-size: 11px; color: white; font-weight: 700; width: 140px; }
                                Text { text: "Txns"; font-size: 11px; color: white; font-weight: 700; horizontal-alignment: right; width: 50px; }
                                Text { text: "Status"; font-size: 11px; color: white; font-weight: 700; horizontal-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                        // Per-file rows
                        ListView { vertical-stretch: 1;
                            for row[i] in root.batch-file-rows : Rectangle {
                                height: 24px;
                                background: Math.mod(i, 2) == 0 ? white : #F8F9FA;
                                Rectangle { y: 23px; height: 1px; background: #E0E0E0; width: parent.width; }
                                HorizontalLayout { padding: 6px; spacing: 0px;
                                    Text { text: row.file;    font-size: 11px; color: #37474F; overflow: elide; width: 180px; }
                                    Text { text: row.bank;    font-size: 11px; color: #37474F; overflow: elide; width: 140px; }
                                    Text { text: row.account; font-size: 11px; color: #607D8B; overflow: elide; width: 120px; }
                                    Text { text: row.period;  font-size: 11px; color: #607D8B; overflow: elide; width: 140px; }
                                    Text { text: row.txns > 0 ? row.txns : "—"; font-size: 11px; color: #37474F; horizontal-alignment: right; width: 50px; }
                                    Rectangle { horizontal-stretch: 1;
                                        Rectangle {
                                            x: (parent.width - 52px) / 2; y: 2px;
                                            width: 52px; height: 18px; border-radius: 3px;
                                            background: row.is-ok ? #E8F5E9 : #FFEBEE;
                                            Text { text: row.status; font-size: 10px; font-weight: 700;
                                                   color: row.is-ok ? #2E7D32 : #C62828;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "audit-trail" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 440px) / 2;
            width: 700px; height: 440px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Audit Trail"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 14px; spacing: 8px; vertical-stretch: 1;
                    HorizontalBox { padding: 0px; spacing: 8px;
                        ComboBox { model: ["All Actions", "Create", "Update", "Delete", "Import", "Export", "Classify", "Rule"]; min-width: 130px; current-index <=> root.audit-action-idx; }
                        ComboBox { model: ["All Types", "Transaction", "Client", "Rule", "Import", "Export"]; min-width: 130px; current-index <=> root.audit-type-idx; }
                        MBtn { text: "Refresh"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.open-audit-trail(root.audit-action-idx, root.audit-type-idx); } }
                        MBtn { text: "Undo Last Edit"; bg: #F5F5F5; fg: root.can-undo ? #546E7A : #BDBDBD; enabled: root.can-undo; clicked => { root.undo-last-edit(); } }
                    }
                    Rectangle {
                        vertical-stretch: 1; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        if root.audit-records.length == 0 : Text {
                            text: "No audit events recorded yet.";
                            font-size: 13px; color: #BDBDBD; horizontal-alignment: center; vertical-alignment: center;
                        }
                        if root.audit-records.length > 0 : ListView {
                            for entry in root.audit-records : Rectangle {
                                height: 22px;
                                Rectangle { y: 21px; height: 1px; background: #E3F2FD; }
                                Text {
                                    text: entry; font-size: 11px; color: #37474F;
                                    y: 4px; x: 8px; overflow: elide;
                                    width: parent.width - 16px;
                                }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Download Logs"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.download-logs(); } }
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Edit Transaction modal ─────────────────────────────────────────────────
    if root.modal-state == "edit-txn" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 440px) / 2;
            width: 470px; height: 440px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Edit Transaction"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    // .txn-info { background:#F0F7FF; border-radius:5px; border:1px solid #BBDEFB; padding:10px 13px; font-size:12px; line-height:1.9; color:#444 }
                    Rectangle {
                        height: 80px; background: #F0F7FF; border-radius: 5px;
                        border-width: 1px; border-color: #BBDEFB;
                        VerticalBox {
                            padding-top: 10px; padding-bottom: 10px;
                            padding-left: 13px; padding-right: 13px;
                            spacing: 3px;
                            HorizontalBox { padding: 0px; spacing: 0px;
                                Text { text: "Date: "; font-size: 12px; font-weight: 700; color: #0A1929; }
                                Text { text: root.edit-txn-date; font-size: 12px; color: #444444; horizontal-stretch: 1; }
                                Text { text: "Debit: "; font-size: 12px; font-weight: 700; color: #0A1929; }
                                Text { text: root.edit-txn-dr; font-size: 12px; color: #B71C1C; }
                                Text { text: "   Credit: "; font-size: 12px; font-weight: 700; color: #0A1929; }
                                Text { text: root.edit-txn-cr; font-size: 12px; color: #1B5E20; }
                            }
                            Text { text: root.edit-txn-narr; font-size: 12px; color: #444444; wrap: word-wrap; }
                        }
                    }
                    Rectangle { height: 1px; background: #EEEEEE; }
                    Text { text: "Vendor / Payer / Payee"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. Airtel, Self, Bank"; height: 34px;
                        text: root.etxn-vendor;
                        edited(v) => { root.etxn-vendor = v; }
                    }
                    Text { text: "Account Head"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. Telephone Expense"; height: 34px;
                        text: root.etxn-head;
                        edited(v) => { root.etxn-head = v; }
                    }
                    Text { text: "Type"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    ComboBox {
                        model: ["-- Select --", "Receipt", "Payment", "Contra"];
                        current-index: root.etxn-type-idx;
                        height: 34px;
                        selected(v) => { root.etxn-type-idx = self.current-index; }
                    }
                }
                MFtr {
                    MBtn {
                        text: "Save & Learn"; bg: #1565C0;
                        clicked => {
                            root.save-txn(root.edit-txn-idx, root.etxn-vendor, root.etxn-head,
                                ["","Receipt","Payment","Contra"][root.etxn-type-idx], true);
                            root.modal-state = "";
                        }
                    }
                    MBtn {
                        text: "Save (no learn)"; bg: #455A64; fg: white;
                        clicked => {
                            root.save-txn(root.edit-txn-idx, root.etxn-vendor, root.etxn-head,
                                ["","Receipt","Payment","Contra"][root.etxn-type-idx], false);
                            root.modal-state = "";
                        }
                    }
                    // Original: class="btn btn-orange" → background:#e65100
                    MBtn {
                        text: "Mark as Suspense"; bg: #E65100; fg: white;
                        clicked => { root.mark-suspense(root.edit-txn-idx); root.modal-state = ""; }
                    }
                    MBtn {
                        text: "Delete"; bg: #C62828; fg: white;
                        clicked => { root.request-delete-txn-confirm(root.edit-txn-idx); }
                    }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Add Transaction modal ──────────────────────────────────────────────────
    if root.modal-state == "add-txn" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 520px) / 2;
            width: 470px; height: 520px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Add Transaction Manually"; close => { root.modal-state = ""; } }
                ScrollView { vertical-stretch: 1;
                    VerticalBox { padding: 18px; spacing: 10px;
                        // Warning banner
                        Rectangle {
                            height: 40px; background: #FFF3E0; border-radius: 4px;
                            border-width: 1px; border-color: #FFB74D;
                            HorizontalBox { padding: 8px; Text { text: "\u{26A0} You are manually inserting a transaction. It will be marked Manual and will not be skipped by dedupe on future imports."; font-size: 11px; color: #6D3600; wrap: word-wrap; vertical-alignment: center; } }
                        }
                        HorizontalBox { padding: 0px; spacing: 12px;
                            VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                                Text { text: "Date * (DD/MM/YYYY)"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                                LineEdit { placeholder-text: "01/01/2024"; height: 34px; text: root.add-date; edited(v) => { root.add-date = v; } }
                            }
                            VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                                Text { text: "Reference / Cheque No."; font-size: 12px; font-weight: 600; color: #0D47A1; }
                                LineEdit { placeholder-text: "Optional"; height: 34px; text: root.add-ref; edited(v) => { root.add-ref = v; } }
                            }
                        }
                        Text { text: "Narration *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                        LineEdit { placeholder-text: "Transaction description"; height: 34px; text: root.add-narr; edited(v) => { root.add-narr = v; } }
                        HorizontalBox { padding: 0px; spacing: 12px;
                            VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                                Text { text: "Debit Amount"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                                LineEdit { placeholder-text: "0.00"; height: 34px; text: root.add-dr; edited(v) => { root.add-dr = v; } }
                            }
                            VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                                Text { text: "Credit Amount"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                                LineEdit { placeholder-text: "0.00"; height: 34px; text: root.add-cr; edited(v) => { root.add-cr = v; } }
                            }
                        }
                        Rectangle { height: 1px; background: #EEEEEE; }
                        Text { text: "Vendor / Payer / Payee"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                        LineEdit { placeholder-text: "e.g. Airtel, Self, Bank"; height: 34px; text: root.add-vendor; edited(v) => { root.add-vendor = v; } }
                        Text { text: "Account Head"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                        LineEdit { placeholder-text: "e.g. Telephone Expense"; height: 34px; text: root.add-head; edited(v) => { root.add-head = v; } }
                        Text { text: "Type"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                        ComboBox {
                            model: ["-- Select --", "Receipt", "Payment", "Contra"];
                            current-index: root.add-type-idx; height: 34px;
                            selected(v) => { root.add-type-idx = self.current-index; }
                        }
                    }
                }
                MFtr {
                    MBtn {
                        text: "Add Transaction"; bg: #1565C0;
                        clicked => {
                            root.add-txn(root.add-date, root.add-ref, root.add-narr,
                                root.add-dr, root.add-cr, root.add-vendor, root.add-head,
                                ["","Receipt","Payment","Contra"][root.add-type-idx]);
                            root.add-date = ""; root.add-ref = ""; root.add-narr = "";
                            root.add-dr = ""; root.add-cr = "";
                            root.add-vendor = ""; root.add-head = "";
                            root.add-type-idx = 0;
                            root.modal-state = "";
                        }
                    }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Reconciliation modal ───────────────────────────────────────────────────
    if root.modal-state == "reconcile" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 500px) / 2;
            width: 700px; height: 500px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Bank Reconciliation"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 14px; spacing: 8px; vertical-stretch: 1;
                    // Toolbar
                    HorizontalBox { padding: 0px; spacing: 8px; height: 36px;
                        MBtn { text: "Import Tally Export (Excel)"; bg: #F5F5F5; fg: #37474F; enabled: true; clicked => { root.reconcile(); } }
                        Text {
                            text: root.recon-file-label == "" ? "No Tally file loaded" : root.recon-file-label;
                            font-size: 12px; color: #888888; vertical-alignment: center; horizontal-stretch: 1;
                        }
                        MBtn { text: "Run Reconciliation"; bg: #1565C0; enabled: root.recon-has-vouchers; clicked => { root.run-reconciliation(); } }
                        MBtn { text: "Export CSV"; bg: #2E7D32; fg: white; enabled: root.recon-has-report; clicked => { root.export-recon-csv(); } }
                    }
                    // Summary bar — bound to Rust recon properties
                    Rectangle {
                        height: 50px; background: #E3F2FD; border-radius: 6px;
                        HorizontalBox { padding: 10px; spacing: 14px;
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-matched; font-size: 20px; font-weight: 700; color: #2E7D32; horizontal-alignment: center; }
                                Text { text: "Matched"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-likely; font-size: 20px; font-weight: 700; color: #F57F17; horizontal-alignment: center; }
                                Text { text: "Likely"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-possible; font-size: 20px; font-weight: 700; color: #8D6E63; horizontal-alignment: center; }
                                Text { text: "Possible"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-unmatched; font-size: 20px; font-weight: 700; color: #C62828; horizontal-alignment: center; }
                                Text { text: "Unmatched"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-bank-only; font-size: 20px; font-weight: 700; color: #6A1B9A; horizontal-alignment: center; }
                                Text { text: "Bank Only"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                        }
                    }
                    // Content area
                    Rectangle {
                        vertical-stretch: 1; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        if root.recon-status == "" : Text {
                            text: "Import a Tally daybook export, then click \"Run Reconciliation\" to match it against the loaded bank transactions.";
                            font-size: 13px; color: #888888; horizontal-alignment: center; vertical-alignment: center;
                            wrap: word-wrap; x: 20px; width: parent.width - 40px;
                        }
                        if root.recon-status != "" : Text {
                            text: root.recon-status;
                            font-size: 12px; color: #37474F; wrap: word-wrap;
                            x: 10px; y: 10px; width: parent.width - 20px;
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Legacy Data Migration ───────────────────────────────────────────────────
    if root.modal-state == "migration" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 520px) / 2;
            width: 700px; height: 520px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Import Legacy Data"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 14px; spacing: 8px; vertical-stretch: 1;
                    Text {
                        text: "Select the JSON export from the old desktop app's DevTools console (see the app's migration guide for the one-line export command). A full backup of this app's database is taken automatically before anything is written.";
                        font-size: 12px; color: #546E7A; wrap: word-wrap; width: parent.width;
                    }
                    HorizontalBox { padding: 0px; spacing: 8px; height: 36px;
                        MBtn {
                            text: "Select Export File\u{2026}"; bg: #F5F5F5; fg: #37474F;
                            enabled: !root.migration-running;
                            clicked => { root.migration-pick-file(); }
                        }
                        Text {
                            text: root.migration-file-label == "" ? "No file selected" : root.migration-file-label;
                            font-size: 12px; color: #888888; vertical-alignment: center; horizontal-stretch: 1;
                        }
                        MBtn {
                            text: "Start Migration"; bg: #2E7D32; fg: white;
                            enabled: root.migration-has-preview && !root.migration-running;
                            clicked => { root.migration-run(); }
                        }
                    }
                    // Progress
                    if root.migration-running : Rectangle {
                        height: 46px; background: #E3F2FD; border-radius: 6px;
                        VerticalBox { padding: 8px; spacing: 4px;
                            HorizontalBox { padding: 0px; spacing: 6px;
                                Text { text: root.migration-status; font-size: 11px; color: #1565C0; horizontal-stretch: 1; }
                                Text { text: root.migration-pct + "%"; font-size: 11px; color: #1565C0; font-weight: 700; }
                            }
                            Rectangle {
                                height: 6px; background: #C5D9F0; border-radius: 3px;
                                Rectangle {
                                    x: 0px; y: 0px; height: 100%;
                                    width: parent.width * root.migration-pct / 100;
                                    background: #1565C0; border-radius: 3px;
                                }
                            }
                        }
                    }
                    // Content area — preview counts before running, full report after
                    Rectangle {
                        vertical-stretch: 1; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        if !root.migration-has-preview && !root.migration-has-report : Text {
                            text: "Select an export file to preview what will be imported.";
                            font-size: 13px; color: #888888; horizontal-alignment: center; vertical-alignment: center;
                        }
                        if root.migration-has-preview && !root.migration-has-report : Text {
                            text: root.migration-preview-text;
                            font-size: 12px; color: #37474F; wrap: word-wrap;
                            x: 10px; y: 10px; width: parent.width - 20px;
                        }
                        if root.migration-has-report : ScrollView {
                            width: 100%; height: 100%;
                            Text {
                                text: root.migration-report-text;
                                font-size: 11px; color: root.migration-success ? #2E7D32 : #C62828;
                                wrap: word-wrap;
                                x: 10px; width: 650px;
                            }
                        }
                    }
                }
                MFtr {
                    MBtn {
                        text: "Save Full Report\u{2026}"; bg: #F5F5F5; fg: #546E7A;
                        enabled: root.migration-has-report;
                        clicked => { root.migration-save-report(); }
                    }
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Export Accounting Wizard ───────────────────────────────────────────────
    if root.modal-state == "export-wizard" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 660px) / 2; y: (parent.height - 540px) / 2;
            width: 660px; height: 540px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "\u{2193} Export for Accounting Software"; close => { root.modal-state = ""; } }

                // Step indicator
                Rectangle {
                    height: 52px; background: #F8FAFF; border-width: 1px; border-color: #E3EBF6;
                    HorizontalBox {
                        padding-left: 14px; padding-right: 14px; padding-top: 0px; padding-bottom: 0px;
                        spacing: 6px; alignment: center;
                        for step in [{n: 1, lbl: "Software"}, {n: 2, lbl: "Company"}, {n: 3, lbl: "Period"}, {n: 4, lbl: "Options"}] :
                        HorizontalBox { padding: 0px; spacing: 4px;
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 14px;
                                    background: root.wiz-step == step.n ? #1565C0 : (root.wiz-step > step.n ? #2E7D32 : #D8E4F5);
                                    Text {
                                        text: root.wiz-step > step.n ? "\u{2713}" : step.n;
                                        font-size: 12px; font-weight: 700;
                                        color: root.wiz-step >= step.n ? white : #6B8AB4;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                                Text { text: step.lbl; font-size: 10px; color: root.wiz-step == step.n ? #1565C0 : #8AA0BB; horizontal-alignment: center; }
                            }
                            if step.n < 4 : Text { text: "\u{2192}"; color: #BDD0E8; font-size: 14px; vertical-alignment: center; }
                        }
                    }
                }

                // Step 1: Software selection
                if root.wiz-step == 1 : VerticalBox { padding: 20px; spacing: 12px; vertical-stretch: 1;
                    Text { text: "SELECT ACCOUNTING SOFTWARE"; font-size: 12px; font-weight: 600; color: #1565C0; letter-spacing: 0.5px; }
                    HorizontalBox { padding: 0px; spacing: 10px;
                        for sw in [{n: 0, ico: "T", nm: "Tally Prime", sub: "ERP9 / Prime"},
                                   {n: 1, ico: "Z", nm: "Zoho Books", sub: "Journal CSV"},
                                   {n: 2, ico: "Q", nm: "QuickBooks", sub: "General Journal"}] :
                        Rectangle {
                            horizontal-stretch: 1; height: 80px;
                            background: root.wiz-sw-idx == sw.n ? #EEF4FF : #FFFFFF;
                            border-radius: 8px; border-width: 2px;
                            border-color: root.wiz-sw-idx == sw.n ? #1565C0 : #D8E4F5;
                            accessible-role: radio-button;
                            accessible-label: sw.nm + " (" + sw.sub + ")";
                            accessible-checked: root.wiz-sw-idx == sw.n;
                            TouchArea { clicked => { root.wiz-sw-idx = sw.n; } }
                            VerticalBox { padding: 10px; spacing: 3px; alignment: center;
                                Rectangle {
                                    width: 32px; height: 32px; border-radius: 6px;
                                    background: root.wiz-sw-idx == sw.n ? #1565C0 : #E3F0FF;
                                    Text { text: sw.ico; font-size: 15px; font-weight: 800; color: root.wiz-sw-idx == sw.n ? white : #1565C0; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text { text: sw.nm; font-size: 11px; font-weight: 600; color: #1A237E; horizontal-alignment: center; }
                                Text { text: sw.sub; font-size: 10px; color: #7B97B4; horizontal-alignment: center; }
                            }
                        }
                    }
                    HorizontalBox { padding: 0px; spacing: 10px;
                        for sw in [{n: 3, ico: "O", nm: "Odoo", sub: "Journal Entry"},
                                   {n: 4, ico: "\u{2616}", nm: "Excel / CSV", sub: "Generic CSV"},
                                   {n: 5, ico: "</>", nm: "Generic XML", sub: "Custom import"}] :
                        Rectangle {
                            horizontal-stretch: 1; height: 80px;
                            background: root.wiz-sw-idx == sw.n ? #EEF4FF : #FFFFFF;
                            border-radius: 8px; border-width: 2px;
                            border-color: root.wiz-sw-idx == sw.n ? #1565C0 : #D8E4F5;
                            accessible-role: radio-button;
                            accessible-label: sw.nm + " (" + sw.sub + ")";
                            accessible-checked: root.wiz-sw-idx == sw.n;
                            TouchArea { clicked => { root.wiz-sw-idx = sw.n; } }
                            VerticalBox { padding: 10px; spacing: 3px; alignment: center;
                                Rectangle {
                                    width: 32px; height: 32px; border-radius: 6px;
                                    background: root.wiz-sw-idx == sw.n ? #1565C0 : #E3F0FF;
                                    Text { text: sw.ico; font-size: 15px; font-weight: 800; color: root.wiz-sw-idx == sw.n ? white : #1565C0; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text { text: sw.nm; font-size: 11px; font-weight: 600; color: #1A237E; horizontal-alignment: center; }
                                Text { text: sw.sub; font-size: 10px; color: #7B97B4; horizontal-alignment: center; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // Step 2: Company details
                if root.wiz-step == 2 : VerticalBox { padding: 20px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "COMPANY DETAILS"; font-size: 12px; font-weight: 600; color: #1565C0; letter-spacing: 0.5px; }
                    Text { text: "Company Name *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit { placeholder-text: "Must match exactly in accounting software"; height: 34px; text: root.wiz-company; edited(v) => { root.wiz-company = v; } }
                    Text { text: "GSTIN (optional)"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit { placeholder-text: "e.g. 27AABCU9603R1ZX"; height: 34px; text: root.wiz-gstin; edited(v) => { root.wiz-gstin = v; } }
                    HorizontalBox { padding: 0px; spacing: 12px;
                        VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                            Text { text: "Financial Year"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            ComboBox { model: ["2024-25", "2023-24", "2022-23", "2021-22"]; height: 34px; current-index <=> root.wiz-fy-idx; }
                        }
                        VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                            Text { text: "State"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            ComboBox { model: ["Maharashtra (MH)", "Gujarat (GJ)", "Delhi (DL)", "Karnataka (KA)", "Tamil Nadu (TN)", "Telangana (TG)", "Rajasthan (RJ)", "UP (UP)", "West Bengal (WB)"]; height: 34px; current-index <=> root.wiz-state-idx; }
                        }
                    }
                    Rectangle {
                        height: 36px; background: #FFF8E1; border-radius: 4px;
                        border-width: 1px; border-color: #FFB300;
                        HorizontalBox { padding: 8px; Text { text: "Company name must exactly match the company name in your accounting software (case-sensitive for Tally)."; font-size: 11px; color: #5A7090; wrap: word-wrap; vertical-alignment: center; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // Step 3: Period
                if root.wiz-step == 3 : VerticalBox { padding: 20px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "SELECT EXPORT PERIOD"; font-size: 12px; font-weight: 600; color: #1565C0; letter-spacing: 0.5px; }
                    HorizontalBox { padding: 0px; spacing: 12px;
                        VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                            Text { text: "From Date"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            LineEdit { placeholder-text: "DD/MM/YYYY"; height: 34px; text: root.wiz-from; edited(v) => { root.wiz-from = v; } }
                        }
                        VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                            Text { text: "To Date"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            LineEdit { placeholder-text: "DD/MM/YYYY"; height: 34px; text: root.wiz-to; edited(v) => { root.wiz-to = v; } }
                        }
                    }
                    Rectangle {
                        height: 36px; background: #E3F2FD; border-radius: 6px;
                        HorizontalBox { padding: 10px; Text { text: "Leave dates blank to export all transactions. Use dates to export a partial period (e.g. if you have already posted some months)."; font-size: 11px; color: #0D47A1; wrap: word-wrap; vertical-alignment: center; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // Step 4: Options
                if root.wiz-step == 4 : VerticalBox { padding: 20px; spacing: 8px; vertical-stretch: 1;
                    Text { text: "EXPORT OPTIONS"; font-size: 12px; font-weight: 600; color: #1565C0; letter-spacing: 0.5px; }
                    // Export summary preview bar (also surfaces live validate() errors/warnings)
                    if root.export-preview-text != "" : Rectangle {
                        background: root.wiz-can-export ? #E3F2FD : #FFEBEE;
                        border-radius: 6px; border-width: 1px; border-color: root.wiz-can-export ? #90CAF9 : #EF9A9A;
                        HorizontalLayout { padding: 10px; spacing: 6px;
                            Text { text: "\u{1F4CA}"; font-size: 13px; vertical-alignment: top; }
                            Text { text: root.export-preview-text; font-size: 12px; color: root.wiz-can-export ? #0D47A1 : #B71C1C; font-weight: 600; wrap: word-wrap; vertical-alignment: top; horizontal-stretch: 1; }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-ob; }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Include Opening Balance entry"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Creates a Journal entry for the bank opening balance"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-gst; }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Include GST details"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Adds GST tag notes to narrations where detected"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-ledger; }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Include Ledger Creation entries"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Adds LEDGER CREATE entries before vouchers (Tally will skip if ledger exists)"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-narr; }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Include voucher narrations"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Includes original bank narration text in voucher narration field"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-classified; toggled => { root.export-preview(); } }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Export only classified transactions"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Skips unreviewed / suspense transactions — recommended for accounting import"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-skip-low; toggled => { root.export-preview(); } }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Skip low-confidence classifications"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Excludes transactions with confidence < 40% to reduce errors"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    // Requirement #10: flagged duplicates were previously
                    // always included with no way to exclude them.
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-skip-dup; toggled => { root.export-preview(); } }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Skip duplicate-flagged transactions"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Excludes rows the duplicate detector flagged — review the Duplicates filter first"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                }

                // Wizard footer
                MFtr {
                    MBtn { text: "\u{2190} Back"; bg: #F5F5F5; fg: #546E7A; enabled: root.wiz-step > 1;
                        clicked => { if root.wiz-step > 1 { root.wiz-step -= 1; } }
                    }
                    if root.wiz-step < 4 : MBtn { text: "Next \u{2192}"; bg: #1565C0;
                        clicked => { root.wiz-step += 1; if root.wiz-step == 4 { root.export-preview(); } }
                    }
                    if root.wiz-step == 4 : MBtn { text: "\u{2193} Download"; bg: #1A237E; fg: white; enabled: root.wiz-can-export;
                        clicked => { root.export-accounting(); root.modal-state = ""; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; root.wiz-step = 1; } }
                }
            }
        }
    }

    // ── AI Privacy Consent modal ───────────────────────────────────────────────
    if root.modal-state == "ai-consent" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 580px) / 2;
            width: 470px; height: 580px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                // Red header
                Rectangle {
                    height: 64px; background: #C62828; border-radius: 4px;
                    HorizontalBox { padding-left: 18px; padding-right: 12px; padding-top: 0px; padding-bottom: 0px; spacing: 12px;
                        Text { text: "\u{26A0}"; font-size: 24px; color: white; vertical-alignment: center; }
                        VerticalBox { padding: 0px; spacing: 2px; alignment: center; horizontal-stretch: 1;
                            Text { text: "AI Auto-Classify \u{2014} Confidentiality Warning"; font-size: 14px; font-weight: 700; color: white; }
                            Text { text: "Read carefully before proceeding"; font-size: 11px; color: #FFCDD2; }
                        }
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 14px; background: #00000030;
                            TouchArea { clicked => { root.modal-state = ""; } }
                            Text { text: "\u{2715}"; font-size: 13px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                ScrollView { vertical-stretch: 1;
                    VerticalBox { padding: 18px; spacing: 12px;
                        // Lead warning
                        Rectangle {
                            height: 70px; background: #FFF3E0; border-radius: 5px;
                            border-width: 1px; border-color: #E65100;
                            HorizontalBox { padding: 12px; spacing: 10px;
                                Text { text: "\u{1F512}"; font-size: 20px; vertical-alignment: center; }
                                Text { text: "This feature may send transaction narrations and related accounting data to third-party AI platforms for automated classification. Confidentiality of data may be compromised if sensitive, financial, personal, or proprietary business information is submitted to external AI systems."; font-size: 12px; color: #4E342E; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                        // What is transmitted — matches ai_classifier::classify_with_ai's
                        // actual request body exactly (narration text only; see
                        // `build_user_prompt`/the batch construction in ai_classifier.rs),
                        // so this disclosure never claims more — or less — than what is
                        // really sent.
                        Rectangle {
                            background: #FAFAFA; border-radius: 5px; border-width: 1px; border-color: #E0E0E0;
                            VerticalBox { padding: 10px; spacing: 4px;
                                Text { text: "WHAT IS TRANSMITTED"; font-size: 11px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                                Text { text: "\u{2022} Transaction narration / description text only"; font-size: 12px; color: #37474F; }
                                Rectangle { height: 28px; background: #F1F8E9; border-radius: 4px; border-width: 1px; border-color: #AED581;
                                    HorizontalBox { padding: 6px; Text { text: "\u{2713}  Amounts, vendor names, account numbers, IFSC codes, bank names and balances are not transmitted."; font-size: 11px; color: #2E7D32; vertical-alignment: center; } }
                                }
                            }
                        }
                        // Risks
                        Rectangle {
                            background: #FAFAFA; border-radius: 5px; border-width: 1px; border-color: #E0E0E0;
                            VerticalBox { padding: 10px; spacing: 4px;
                                Text { text: "\u{26A0} POTENTIAL RISKS"; font-size: 11px; font-weight: 700; color: #C62828; letter-spacing: 0.5px; }
                                Text { text: "\u{2022} Unauthorized access or interception during transmission\n\u{2022} Data leakage or retention by third-party AI platforms\n\u{2022} Exposure of confidential business or client information\n\u{2022} Regulatory, privacy, or compliance violations (GDPR, IT Act, etc.)"; font-size: 12px; color: #B71C1C; }
                            }
                        }
                        // Consent checkbox
                        Rectangle {
                            height: 50px; background: #FFF8E1; border-radius: 6px;
                            border-width: 2px; border-color: #F9A825;
                            HorizontalBox { padding: 12px; spacing: 10px;
                                CheckBox { checked <=> root.ai-consent-checked; }
                                Text { text: "I have read and understood the above. I acknowledge and accept the confidentiality and compliance risks of using AI classification."; font-size: 12px; font-weight: 600; color: #4E342E; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "\u{25BA} Continue with AI"; bg: #6B2FB8; fg: white;
                        enabled: root.ai-consent-checked;
                        clicked => { root.ai-consent-checked = false; root.modal-state = "ai-settings"; }
                    }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true;
                        clicked => { root.ai-consent-checked = false; root.modal-state = ""; }
                    }
                }
            }
        }
    }

    // ── PDF Password modal ─────────────────────────────────────────────────────
    if root.pdf-pwd-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        Rectangle {
            x: (parent.width - 380px) / 2; y: (parent.height - 200px) / 2;
            width: 380px; height: 200px; background: white; border-radius: 8px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Password Protected PDF"; close => { root.pdf-pwd-cancel(); } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: root.pdf-pwd-prompt; font-size: 13px; color: #444444; wrap: word-wrap; }
                    LineEdit {
                        placeholder-text: "Enter PDF password"; height: 34px;
                        input-type: password;
                        text: root.pdf-pwd-input;
                        edited(v) => { root.pdf-pwd-input = v; }
                        accepted => { root.pdf-pwd-confirm(root.pdf-pwd-input); }
                    }
                }
                MFtr {
                    MBtn { text: "Unlock"; bg: #1565C0; clicked => { root.pdf-pwd-confirm(root.pdf-pwd-input); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.pdf-pwd-cancel(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }

    // ── OCR Progress overlay ───────────────────────────────────────────────────
    if root.ocr-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000060;
        Rectangle {
            x: (parent.width - 360px) / 2; y: (parent.height - 180px) / 2;
            width: 360px; height: 180px; background: white; border-radius: 10px;
            drop-shadow-blur: 40px; drop-shadow-color: #0000004D; drop-shadow-offset-y: 12px;
            Rectangle { x: 0; y: 0; height: 4px; background: #1565C0; }
            VerticalBox {
                padding: 28px; spacing: 10px; alignment: center;
                Text { text: "OCR Processing"; font-size: 15px; font-weight: 700; color: #0A1929; horizontal-alignment: center; }
                Text { text: root.ocr-msg; font-size: 13px; color: #555555; horizontal-alignment: center; min-height: 18px; }
                // Progress bar
                Rectangle {
                    height: 10px; background: #E3F2FD; border-radius: 5px;
                    Rectangle {
                        width: parent.width * root.ocr-pct / 100;
                        height: parent.height; background: #1565C0; border-radius: 5px;
                    }
                }
                Text {
                    text: root.ocr-pct + "%";
                    font-size: 12px; font-weight: 600; color: #1565C0;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // ── AI Classification Progress overlay ─────────────────────────────────────
    // .ai-box { width: 380px; } from original CSS
    if root.ai-overlay-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000060;
        Rectangle {
            x: (parent.width - 380px) / 2; y: (parent.height - 220px) / 2;
            width: 380px; height: 220px; background: white; border-radius: 10px;
            drop-shadow-blur: 40px; drop-shadow-color: #0000004D; drop-shadow-offset-y: 12px;
            Rectangle { x: 0; y: 0; height: 4px; background: #6B2FB8; }
            VerticalBox {
                padding: 28px; spacing: 10px; alignment: center;
                Text { text: "\u{2605} AI Classification in Progress"; font-size: 15px; font-weight: 700; color: #0A1929; horizontal-alignment: center; }
                Text { text: root.ai-msg; font-size: 13px; color: #555555; horizontal-alignment: center; min-height: 18px; }
                // Progress bar
                Rectangle {
                    height: 10px; background: #EDE7F6; border-radius: 5px;
                    accessible-role: progress-indicator;
                    accessible-label: "AI classification progress";
                    accessible-value: root.ai-pct + "%";
                    accessible-value-minimum: 0;
                    accessible-value-maximum: 100;
                    Rectangle {
                        width: parent.width * root.ai-pct / 100;
                        height: parent.height; background: #6B2FB8; border-radius: 5px;
                    }
                }
                Text { text: root.ai-pct + "%"; font-size: 12px; font-weight: 600; color: #6B2FB8; horizontal-alignment: center; }
                Text { text: "Sending transaction narrations to AI provider…\nDo not close the window."; font-size: 11px; color: #888888; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle {
                    height: 30px; width: 100px;
                    background: #FFFFFF; border-radius: 4px; border-width: 1px; border-color: #90CAF9;
                    accessible-role: button;
                    accessible-label: "Cancel";
                    TouchArea { clicked => { root.ai-cancel(); } }
                    Text { text: "Cancel"; font-size: 12px; color: #546E7A; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }

    // ── Edit Client modal ──────────────────────────────────────────────────────
    if root.modal-state == "edit-client" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 310px) / 2;
            width: 470px; height: 310px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #0277BD; }
                MHdr { title: "Edit Client"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "Client Name *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. Acme Pvt Ltd"; height: 34px;
                        text: root.edit-client-name;
                        edited(v) => { root.edit-client-name = v; }
                    }
                    Text { text: "Bank Ledger Name in Tally *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. HDFC Bank A/c - 5021"; height: 34px;
                        text: root.edit-client-ledger;
                        edited(v) => { root.edit-client-ledger = v; }
                    }
                    Text { text: "Must exactly match the ledger name in your Tally company (case-sensitive)"; font-size: 11px; color: #999999; wrap: word-wrap; }
                }
                MFtr {
                    MBtn { text: "Save Changes"; bg: #0277BD; clicked => {
                        root.edit-client();
                        root.modal-state = "";
                    } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }
    } // end modal-esc-scope
    changed modal-state => {
        if (root.modal-state != "") {
            modal-esc-scope.focus();
        }
    }

    // ── Toast notification ─────────────────────────────────────────────────────
    toast-dismiss-timer := Timer {
        interval: 3200ms;
        running: false;
        triggered => { root.toast-display = ""; }
    }
    changed toast-msg => {
        root.toast-display = root.toast-msg;
        if (root.toast-msg != "") {
            toast-dismiss-timer.running = true;
            toast-dismiss-timer.restart();
        } else {
            toast-dismiss-timer.running = false;
        }
    }
    if root.toast-display != "" : Rectangle {
        x: (root.width - 280px) / 2;
        y: root.height - 80px;
        width: 280px; height: 36px;
        background:
            root.toast-kind == 1 ? #2E7D32 :
            root.toast-kind == 2 ? #C62828 :
            root.toast-kind == 3 ? #E65100 :
            #0D47A1;
        border-radius: 5px;
        drop-shadow-blur: 12px; drop-shadow-color: #00000030; drop-shadow-offset-y: 4px;
        Text {
            text: root.toast-display;
            font-size: 12px; font-weight: 600; color: white;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}
