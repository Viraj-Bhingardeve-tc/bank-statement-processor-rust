// main_screen.slint — Full restoration of the original Bank Statement Processor UI.
// Colors match the original Electron app exactly.

import { Button, VerticalBox, HorizontalBox, ComboBox,
         LineEdit, CheckBox, ScrollView, ListView } from "std-widgets.slint";
import { DashboardScreen, DashMonthBar, DashExpBar, DashCashPt, DashVendorBar, TxnRow, OriginColor, Sidebar, TopHeader, DashPresetRange } from "dashboard.slint";
import { Spacing, Radius, Type, FintechPalette, Badge, AppButton, Card } from "theme.slint";
import { TxnPageHeader, TxnFilterCard, TxnStatusChip, TxnActiveFilterPill, TxnTable, SummarySection, TxnActionBar } from "transactions.slint";

// ── Batch monitor per-file row ────────────────────────────────────────────────
export struct BatchFileRow {
    file:    string,
    bank:    string,
    account: string,
    period:  string,
    txns:    int,
    status:  string,
    is-ok:   bool,
    err-msg: string,
}

// ── Generic summary list row (label + value, optional color hint) ─────────────
export struct SummaryListRow {
    lbl:      string,
    val:      string,
    is-debit: bool,
    key:      string,
}

// TxnRow / OriginColor now live in dashboard.slint (imported above) — the new
// redesigned Dashboard's "Recent Transactions" card needs the exact same
// transaction-row data and origin-color convention the Transactions table
// below already uses, so this is the single shared definition for both
// instead of a second, duplicate struct.

// TBtn/QBtn/FBtn (old toolbar/date-preset/status-filter buttons) removed —
// Phase 2 UI redesign replaced every one of their call sites with
// AppButton/TxnStatusChip (theme.slint / transactions.slint); nothing
// instantiates them anymore.

// ── Custom tab button (on dark #0D47A1 background) ────────────────────────────
component VTab inherits Rectangle {
    in property <string> text:   "";
    in property <bool>   active: false;
    callback clicked();

    height: 36px; min-width: 110px;
    background: transparent; border-width: 0px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.active;

    // Active bottom border (3px, light blue)
    Rectangle {
        y: parent.height - 3px; height: 3px;
        background: root.active ? #64B5F6 : transparent;
    }
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text; font-size: 12px;
        font-weight: 700;
        color: root.active ? #FFFFFF : #90CAF9;
        letter-spacing: 0.72px;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// FootBtn (old footer action button) removed — Phase 2 replaced every call
// site with AppButton (theme.slint) inside TxnActionBar.

// ── Summary label / value row ──────────────────────────────────────────────────
component SR inherits Rectangle {
    in property <string> lbl:  "";
    in property <string> val:  "\u{2014}";
    in property <color>  vcol: #37474F;
    in property <bool>   clickable: false;
    callback clicked();
    height: 18px;
    HorizontalLayout {
        padding: 0px; spacing: 0px; width: parent.width; height: parent.height;
        Text {
            text: root.lbl; font-size: 12px; color: #607D8B;
            horizontal-stretch: 1; vertical-alignment: center;
        }
        Text {
            text: root.val; font-size: 12px; font-weight: 600;
            color: root.vcol; horizontal-alignment: right; vertical-alignment: center;
        }
    }
    if root.clickable : TouchArea {
        x: 0; y: 0; width: parent.width; height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// SDivider (old section-title divider) removed — Phase 2 replaced every
// call site with SummarySection (transactions.slint), which supplies its
// own title/card chrome; SR rows above still nest inside it unchanged.

// ── Modal action button ────────────────────────────────────────────────────────
// Original .btn: padding:5px 11px; font-size:12px; border-radius:4px; height≈27px
component MBtn inherits Rectangle {
    in property <string> text:    "";
    in property <color>  bg:      #1565C0;
    in property <color>  fg:      white;
    in property <bool>   enabled: true;
    callback clicked();

    height: 28px; min-width: 80px;
    background:    root.enabled ? root.bg : #F5F5F5;
    border-radius: 4px;
    border-width:  root.enabled ? 0px : 1px;
    border-color:  #D0D0D0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text; font-size: 12px;
        color: root.enabled ? root.fg : #BDBDBD;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ── Modal header ───────────────────────────────────────────────────────────────
component MHdr inherits Rectangle {
    in property <string> title: "";
    in property <color>  bg:    #FFFFFF;
    callback close();

    height: 46px; background: root.bg;
    border-width: 0px;

    // Bottom border only
    Rectangle { y: parent.height - 1px; height: 1px; background: #EEEEEE; }

    HorizontalBox {
        padding-left: 18px; padding-right: 12px;
        padding-top: 0px; padding-bottom: 0px;
        Text {
            text: root.title; font-size: 15px; font-weight: 700;
            color: #0A1929; vertical-alignment: center; horizontal-stretch: 1;
        }
        Rectangle {
            width: 28px; height: 28px; border-radius: 14px; background: transparent;
            accessible-role: button;
            accessible-label: "Close";
            TouchArea { clicked => { root.close(); } }
            Text {
                text: "\u{2715}"; font-size: 22px; color: #AAAAAA;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

// ── Modal footer row (always right-aligned, matching original flex-end) ────────
component MFtr inherits Rectangle {
    height: 50px; background: #FFFFFF;
    border-width: 0px;
    // Top border only
    Rectangle { y: 0; height: 1px; background: #EEEEEE; }
    HorizontalBox {
        padding-left: 18px; padding-right: 18px;
        padding-top: 0px; padding-bottom: 0px;
        spacing: 8px;
        alignment: start;
        // Auto stretch-spacer pushes all children right (flex-end equivalent)
        Rectangle { horizontal-stretch: 1; }
        @children
    }
}

