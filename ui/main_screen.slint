                                            padding: 0px; spacing: 1px; width: parent.width; height: parent.height;
                                            Text { text: a.lbl; font-size: Type.small; font-weight: 700; color: FintechPalette.primary; overflow: elide; vertical-alignment: center; }
                                            Text { text: a.val; font-size: Type.micro; color: #555555; vertical-alignment: center; }
                                        }
                                        TouchArea {
                                            x: 0; y: 0; width: parent.width; height: parent.height;
                                            mouse-cursor: pointer;
                                            clicked => { root.sel-bank = a.key; root.bank-filter-changed(a.key); }
                                        }
                                    }
                                }

                                // ── GST / Tax amounts ─────────────────────────────────────────────────
                                if root.transaction-rows.length > 0 && root.dash-gst-count != "0" : SummarySection {
                                    title: "GST / TAX";
                                    SR { lbl: "GST Paid";        val: root.dash-gst-paid; vcol: FintechPalette.danger; }
                                    SR { lbl: "GST Recv./Refund"; val: root.dash-gst-recv; vcol: FintechPalette.success; }
                                }

                                // ── Duplicates Detected card (original: .sum-card with
                                // border-color:#f48fb1, title color:#880e4f) — a standalone
                                // callout distinct from the plain "Duplicates" row above
                                // (that row stays, for its click-to-filter behavior).
                                if root.dash-duplicates != "0" : Rectangle {
                                    border-width: 1px; border-color: #F48FB1; border-radius: 6px;
                                    background: #FFFFFF;
                                    VerticalBox {
                                        padding-top: 8px; padding-bottom: 8px;
                                        padding-left: 10px; padding-right: 10px;
                                        spacing: 4px;
                                        HorizontalBox {
                                            padding: 0px; spacing: 4px;
                                            Rectangle {
                                                width: 26px; height: 13px; border-radius: 3px;
                                                background: #FCE4EC; border-width: 1px; border-color: #E91E63;
                                                Text { text: "DUP"; font-size: 8px; font-weight: 800; color: #880E4F;
                                                       horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            Text {
                                                text: "Duplicates Detected"; font-size: 9.5px; font-weight: 800;
                                                letter-spacing: 0.6px; color: #880E4F; vertical-alignment: center;
                                            }
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            Text { text: "Flagged rows"; font-size: 10px; color: #37474F; horizontal-stretch: 1; vertical-alignment: center; }
                                            Text { text: root.dash-duplicates; font-size: 10px; font-weight: 700; color: #C62828; vertical-alignment: center; }
                                        }
                                        Text { text: "Use the Duplicates filter to review"; font-size: 10px; color: #888888; }
                                    }
                                }

                                // ── Suspense card (original: .sum-card with border-color:
                                // #ba68c8, title color:#6a1b9a) — dash-suspense already IS
                                // the ₹ amount in suspense (main.rs: fmt_amt(s.suspense_amount)),
                                // not a row count, so no backend change was needed here; the
                                // plain "Suspense" row above (a count-shaped SR, reusing the
                                // same dash-suspense value) stays for its click-to-filter
                                // behavior.
                                if root.dash-has-suspense : Rectangle {
                                    border-width: 1px; border-color: #BA68C8; border-radius: 6px;
                                    background: #FFFFFF;
                                    VerticalBox {
                                        padding-top: 8px; padding-bottom: 8px;
                                        padding-left: 10px; padding-right: 10px;
                                        spacing: 4px;
                                        Text {
                                            text: "Suspense"; font-size: 9.5px; font-weight: 800;
                                            letter-spacing: 0.6px; color: #6A1B9A;
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            Text { text: "Amount in suspense"; font-size: 10px; color: #37474F; horizontal-stretch: 1; vertical-alignment: center; }
                                            Text { text: root.dash-suspense; font-size: 10px; font-weight: 700; color: #7B1FA2; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // ── Recurring parties ─────────────────────────────────────────────────
                                if root.dash-parties.length > 0 : SummarySection {
                                    title: "RECURRING PARTIES";
                                    for p in root.dash-parties : Rectangle {
                                        height: 20px;
                                        HorizontalLayout {
                                            padding: 0px; spacing: Spacing.xs; width: parent.width; height: parent.height;
                                            Text { text: p.lbl; font-size: Type.small; color: FintechPalette.primary; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                            Text { text: p.val; font-size: Type.micro; color: #555555; vertical-alignment: center; }
                                        }
                                        TouchArea {
                                            x: 0; y: 0; width: parent.width; height: parent.height;
                                            mouse-cursor: pointer;
                                            clicked => { root.sel-vendor = p.key; root.vendor-filter-changed(p.key); }
                                        }
                                    }
                                }

                                // ── Receipts by Ledger ────────────────────────────────────────────────
                                if root.dash-rec-ledgers.length > 0 : SummarySection {
                                    title: "RECEIPTS BY LEDGER";
                                    for r in root.dash-rec-ledgers : Rectangle {
                                        height: 20px;
                                        HorizontalLayout {
                                            padding: 0px; spacing: Spacing.xs; width: parent.width; height: parent.height;
                                            Text { text: r.lbl; font-size: Type.micro; color: #37474F; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                            Text { text: r.val; font-size: Type.micro; color: FintechPalette.success; font-weight: 600; vertical-alignment: center; }
                                        }
                                        TouchArea {
                                            x: 0; y: 0; width: parent.width; height: parent.height;
                                            mouse-cursor: pointer;
                                            clicked => { root.sel-head = r.key; root.head-filter-changed(r.key); }
                                        }
                                    }
                                }

                                // ── Payments by Ledger ────────────────────────────────────────────────
                                if root.dash-pay-ledgers.length > 0 : SummarySection {
                                    title: "PAYMENTS BY LEDGER";
                                    for p in root.dash-pay-ledgers : Rectangle {
                                        height: 20px;
                                        HorizontalLayout {
                                            padding: 0px; spacing: Spacing.xs; width: parent.width; height: parent.height;
                                            Text { text: p.lbl; font-size: Type.micro; color: #37474F; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                            Text { text: p.val; font-size: Type.micro; color: FintechPalette.danger; font-weight: 600; vertical-alignment: center; }
                                        }
                                        TouchArea {
                                            x: 0; y: 0; width: parent.width; height: parent.height;
                                            mouse-cursor: pointer;
                                            clicked => { root.sel-head = p.key; root.head-filter-changed(p.key); }
                                        }
                                    }
                                }

                                if root.status-bank != "" : Text {
                                    text: root.status-bank; font-size: Type.micro;
                                    color: FintechPalette.text-muted; horizontal-alignment: center; wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }

