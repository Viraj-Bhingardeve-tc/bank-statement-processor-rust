// ── Custom transaction table row ───────────────────────────────────────────────
component TxnTableRow inherits Rectangle {
    in property <TxnRow> data;
    in property <int>    row-idx;
    in property <bool>   compact: false;
    callback clicked(int);

    height: root.compact ? 22px : 26px;
    background:
        root.data.row-color == 1 ? #E8F5E9 :
        root.data.row-color == 2 ? #FFFDE7 :
        root.data.row-color == 3 ? #FFEBEE :
        root.data.row-color == 4 ? #F3E5F5 :
        root.data.row-color == 5 ? #FCE4EC :
        root.data.row-color == 6 ? #E3F2FD :
        #FFFFFF;
    accessible-role: list-item;
    accessible-label: root.data.date + ", " + root.data.narration
        + (root.data.debit != "" ? ", Debit " + root.data.debit : "")
        + (root.data.credit != "" ? ", Credit " + root.data.credit : "")
        + ", Balance " + root.data.balance
        + ", " + root.data.status-text;

    // Bottom row separator
    Rectangle { y: parent.height - 1px; height: 1px; background: #E3F2FD; }

    ta := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.clicked(root.row-idx); }
    }

    HorizontalBox {
        padding: 0px; spacing: 0px;

        // Bank Name 90px (matches header)
        Rectangle { width: 90px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.bank-name; font-size: 11px; color: #555555;
                   vertical-alignment: center; overflow: elide; }
        }
        // Account No 90px (matches header)
        Rectangle { width: 90px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.account-no; font-size: 11px; color: #555555;
                   vertical-alignment: center; overflow: elide; }
        }
        // Date 82px
        Rectangle { width: 82px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.date; font-size: 12px; color: #0A1929;
                   vertical-alignment: center; overflow: elide; }
        }
        // Narration stretch
        Rectangle { horizontal-stretch: 1; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.narration; font-size: 12px; color: #0A1929;
                   vertical-alignment: center; overflow: elide; }
        }
        // Ref 95px
        Rectangle { width: 95px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.ref-no; font-size: 11px; color: #546E7A;
                   vertical-alignment: center; overflow: elide; }
        }
        // Debit 92px right-aligned red
        Rectangle { width: 92px; clip: true;
            Text { x: 0px; width: parent.width - 9px; height: parent.height;
                   text: root.data.debit;
                   font-size: 12px; font-weight: root.data.debit != "" ? 600 : 400;
                   color: root.data.debit != "" ? #B71C1C : #CCCCCC;
                   horizontal-alignment: right; vertical-alignment: center; }
        }
        // Credit 92px right-aligned green
        Rectangle { width: 92px; clip: true;
            Text { x: 0px; width: parent.width - 9px; height: parent.height;
                   text: root.data.credit;
                   font-size: 12px; font-weight: root.data.credit != "" ? 600 : 400;
                   color: root.data.credit != "" ? #1B5E20 : #CCCCCC;
                   horizontal-alignment: right; vertical-alignment: center; }
        }
        // Balance 100px right-aligned blue
        Rectangle { width: 100px; clip: true;
            Text { x: 0px; width: parent.width - 9px; height: parent.height;
                   text: root.data.balance; font-size: 12px; font-weight: 600;
                   color: #0D47A1;
                   horizontal-alignment: right; vertical-alignment: center; }
        }
        // Vendor 120px
        Rectangle { width: 120px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.vendor; font-size: 12px; color: #0D47A1; font-weight: 600;
                   vertical-alignment: center; overflow: elide; }
        }
        // Ledger 120px
        Rectangle { width: 120px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.ledger; font-size: 12px; color: #0D47A1; font-weight: 600;
                   vertical-alignment: center; overflow: elide; }
        }
        // Expense Head 100px
        Rectangle { width: 100px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.expense-head; font-size: 11px; color: #455A64;
                   vertical-alignment: center; overflow: elide; }
        }
        // Status 75px — chip rendering
        Rectangle { width: 75px; clip: true;
            HorizontalBox {
                padding-left: 4px; padding-right: 4px;
                padding-top: 0px; padding-bottom: 0px;
                spacing: 2px; alignment: start;
                if root.data.row-color == 1 : Rectangle {
                    height: 14px; min-width: 34px; background: #C8E6C9;
                    border-radius: 7px; border-width: 1px; border-color: #81C784;
                    Text { text: "HIGH"; font-size: 9px; font-weight: 800; color: #1B5E20;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 3 : Rectangle {
                    height: 14px; min-width: 42px; background: #FFCDD2;
                    border-radius: 7px; border-width: 1px; border-color: #EF9A9A;
                    Text { text: "REVIEW"; font-size: 9px; font-weight: 800; color: #B71C1C;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 4 : Rectangle {
                    height: 14px; min-width: 56px; background: #E1BEE7;
                    border-radius: 7px; border-width: 1px; border-color: #BA68C8;
                    Text { text: "SUSPENSE"; font-size: 9px; font-weight: 800; color: #6A1B9A;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 5 : Rectangle {
                    height: 14px; min-width: 30px; background: #FCE4EC;
                    border-radius: 7px; border-width: 1px; border-color: #E91E63;
                    Text { text: "DUP"; font-size: 9px; font-weight: 800; color: #880E4F;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 6 : Rectangle {
                    height: 14px; min-width: 38px; background: #BBDEFB;
                    border-radius: 7px; border-width: 1px; border-color: #64B5F6;
                    Text { text: "MANUAL"; font-size: 9px; font-weight: 800; color: #0D47A1;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 0 : Text {
                    text: root.data.status-text; font-size: 10px; color: #888888;
                    vertical-alignment: center;
                }
            }
        }
        // Tags 80px — GST/TAX/DUP badges (original: min-width:80px)
        Rectangle { width: 80px; clip: true;
            HorizontalBox {
                padding-left: 3px; padding-right: 3px;
                padding-top: 0px; padding-bottom: 0px;
                spacing: 2px; alignment: start;
                if root.data.has-gst : Rectangle {
                    height: 14px; min-width: 26px; background: #C8E6C9;
                    border-radius: 3px; border-width: 1px; border-color: #66BB6A;
                    Text { text: "GST"; font-size: 9px; font-weight: 800; color: #1B5E20;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.has-tax : Rectangle {
                    height: 14px; min-width: 26px; background: #FFE0B2;
                    border-radius: 3px; border-width: 1px; border-color: #FFA726;
                    Text { text: "TAX"; font-size: 9px; font-weight: 800; color: #BF360C;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.has-dup-tag : Rectangle {
                    height: 14px; min-width: 26px; background: #FCE4EC;
                    border-radius: 3px; border-width: 1px; border-color: #E91E63;
                    Text { text: "DUP"; font-size: 9px; font-weight: 800; color: #880E4F;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        // Review 60px (original: .review-ok #2e7d32 checkmark, .review-reason
        // #bf360c failure text — two colors, not one flat grey)
        Rectangle { width: 60px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.review; font-size: 11px;
                   color: root.data.review == "\u{2713}" ? #2E7D32
                        : root.data.review == "" ? #546E7A
                        : #BF360C;
                   vertical-alignment: center; overflow: elide; }
        }
    }
}
