// main_screen.slint — Main application window after login.
// Phase 4: file picker wired, StandardTableView shows parsed transactions,
//          summary panel shows live data from Rust parser.

import { Button, TabWidget, VerticalBox, HorizontalBox, ComboBox,
         StandardTableView } from "std-widgets.slint";
import { DashboardScreen } from "dashboard.slint";

// ── Reusable summary row ──────────────────────────────────────────────────────
component SummaryRow inherits HorizontalBox {
    in property <string> label:     "Label";
    in property <string> value:     "—";
    in property <color>  val-color: #37474F;

    Text {
        text:               root.label;
        font-size:          11px;
        color:              #546E7A;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    Text {
        text:                root.value;
        font-size:           11px;
        font-weight:         600;
        color:               root.val-color;
        horizontal-alignment: right;
        vertical-alignment:  center;
    }
}

// ── Main screen ───────────────────────────────────────────────────────────────
export component MainScreen inherits Rectangle {

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback logout();
    callback load-file();
    callback batch-folder();

    // ── Input properties ──────────────────────────────────────────────────────
    in property <[string]> client-names: ["-- Select Client --"];

    in property <string> status-bank: "";
    in property <string> status-file: "";

    // Transaction table rows  (each inner [StandardListViewItem] = one row)
    in property <[[StandardListViewItem]]> transaction-rows: [];

    // Dashboard / summary data
    in property <string> dash-bank-name:  "";
    in property <string> dash-opening:    "₹ —";
    in property <string> dash-credits:    "₹ —";
    in property <string> dash-debits:     "₹ —";
    in property <string> dash-closing:    "₹ —";
    in property <string> dash-txn-count:  "—";
    in property <string> dash-vendors:    "—";

    background: #F0F2F5;

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // ── Toolbar ───────────────────────────────────────────────────────────
        Rectangle {
            height:     48px;
            background: #1565C0;

            HorizontalBox {
                padding-left:   14px;
                padding-right:  14px;
                padding-top:    0px;
                padding-bottom: 0px;
                spacing:        10px;

                Text {
                    text:               "A S Havaldar";
                    color:              #FFFFFF;
                    font-size:          14px;
                    font-weight:        700;
                    vertical-alignment: center;
                }
                Text {
                    text:               "—";
                    color:              #90CAF9;
                    font-size:          14px;
                    vertical-alignment: center;
                }
                // Bank name shown after load; falls back to app subtitle
                Text {
                    text: root.dash-bank-name != ""
                        ? root.dash-bank-name
                        : "Bank Statement Processor";
                    color:              #90CAF9;
                    font-size:          12px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // File name status
                if root.status-file != "" : Text {
                    text:               root.status-file;
                    color:              #BBDEFB;
                    font-size:          11px;
                    vertical-alignment: center;
                    max-width:          280px;
                }

                ComboBox {
                    model:         root.client-names;
                    current-index: 0;
                }

                Button {
                    text:    "Open File";
                    clicked => { root.load-file(); }
                }

                Button {
                    text:    "Batch Folder";
                    enabled: false;
                    clicked => { root.batch-folder(); }
                }

                Button {
                    text:    "Logout";
                    clicked => { root.logout(); }
                }
            }
        }

        // ── Tab view ──────────────────────────────────────────────────────────
        TabWidget {
            vertical-stretch: 1;

            // ─── Transactions tab ─────────────────────────────────────────────
            Tab {
                title: "Transactions";

                Rectangle {
                    background: #F0F2F5;

                    VerticalBox {
                        padding:  0px;
                        spacing:  0px;

                        // Filter bar
                        Rectangle {
                            height:       44px;
                            background:   #FFFFFF;
                            border-width: 1px;
                            border-color: #E0E0E0;

                            HorizontalBox {
                                padding-left:  12px;
                                padding-right: 12px;
                                padding-top:   0px;
                                padding-bottom: 0px;
                                spacing:        8px;

                                Text {
                                    text:               "Filters — Phase 5";
                                    color:              #B0BEC5;
                                    font-size:          12px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.dash-txn-count != "—"
                                        ? root.dash-txn-count + " transactions"
                                        : "No file loaded";
                                    color:              #546E7A;
                                    font-size:          12px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Table + summary panel
                        HorizontalBox {
                            padding:          0px;
                            spacing:          0px;
                            vertical-stretch: 1;

                            // ── Transaction table ─────────────────────────────
                            Rectangle {
                                horizontal-stretch: 4;
                                background:         #FFFFFF;

                                if root.transaction-rows.length == 0 : VerticalBox {
                                    alignment: center;
                                    spacing:   12px;

                                    Text {
                                        text:                 "No transactions loaded";
                                        font-size:            18px;
                                        font-weight:          700;
                                        color:                #CFD8DC;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text:                 "Click \"Open File\" to load a PDF or Excel bank statement.";
                                        font-size:            13px;
                                        color:                #90A4AE;
                                        horizontal-alignment: center;
                                        wrap:                 word-wrap;
                                    }
                                }

                                if root.transaction-rows.length > 0 : StandardTableView {
                                    columns: [
                                        { title: "Date",      width: 90px  },
                                        { title: "Narration", horizontal-stretch: 1 },
                                        { title: "Debit",     width: 110px },
                                        { title: "Credit",    width: 110px },
                                        { title: "Balance",   width: 120px },
                                        { title: "Reference", width: 130px },
                                    ];
                                    rows: root.transaction-rows;
                                }
                            }

                            // ── Summary panel ─────────────────────────────────
                            Rectangle {
                                horizontal-stretch: 0;
                                min-width:          220px;
                                max-width:          240px;
                                background:         #F8F9FA;
                                border-width:       1px;
                                border-color:       #E0E0E0;

                                VerticalBox {
                                    padding: 16px;
                                    spacing: 8px;

                                    Text {
                                        text:        "Summary";
                                        font-size:   13px;
                                        font-weight: 700;
                                        color:       #37474F;
                                    }

                                    Rectangle { height: 1px; background: #E0E0E0; }

                                    SummaryRow {
                                        label:     "Opening Balance";
                                        value:     root.dash-opening;
                                        val-color: #1565C0;
                                    }
                                    SummaryRow {
                                        label:     "Total Credits";
                                        value:     root.dash-credits;
                                        val-color: #2E7D32;
                                    }
                                    SummaryRow {
                                        label:     "Total Debits";
                                        value:     root.dash-debits;
                                        val-color: #C62828;
                                    }
                                    SummaryRow {
                                        label:     "Closing Balance";
                                        value:     root.dash-closing;
                                        val-color: #1565C0;
                                    }

                                    Rectangle { height: 1px; background: #E0E0E0; }

                                    SummaryRow {
                                        label:     "Transactions";
                                        value:     root.dash-txn-count;
                                        val-color: #546E7A;
                                    }
                                    SummaryRow {
                                        label:     "Vendors";
                                        value:     root.dash-vendors;
                                        val-color: #546E7A;
                                    }

                                    Rectangle { vertical-stretch: 1; }

                                    if root.status-bank != "" : Text {
                                        text:                root.status-bank;
                                        font-size:           10px;
                                        color:               #90A4AE;
                                        horizontal-alignment: center;
                                        wrap:                word-wrap;
                                    }
                                }
                            }
                        }

                        // Export bar
                        Rectangle {
                            height:       44px;
                            background:   #FFFFFF;
                            border-width: 1px;
                            border-color: #E0E0E0;

                            HorizontalBox {
                                padding-left:   12px;
                                padding-right:  12px;
                                padding-top:    0px;
                                padding-bottom: 0px;
                                spacing:         8px;
                                alignment:       center;

                                Button { text: "Export to Excel";    enabled: false; }
                                Button { text: "Export Tally XML";   enabled: false; }
                                Button { text: "Export Accounting…"; enabled: false; }
                                Button { text: "Post to Tally";      enabled: false; }
                            }
                        }
                    }
                }
            }

            // ─── Dashboard tab ────────────────────────────────────────────────
            Tab {
                title: "Dashboard";

                DashboardScreen {
                    opening-balance: root.dash-opening;
                    total-credits:   root.dash-credits;
                    total-debits:    root.dash-debits;
                    closing-balance: root.dash-closing;
                    txn-count:       root.dash-txn-count;
                    vendor-count:    root.dash-vendors;
                }
            }
        }
    }
}
