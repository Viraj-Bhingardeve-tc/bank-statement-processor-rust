// main_screen.slint — Full restoration of the original Bank Statement Processor UI.
// Colors match the original Electron app exactly.

import { Button, VerticalBox, HorizontalBox, ComboBox,
         LineEdit, CheckBox, ScrollView, ListView } from "std-widgets.slint";
import { DashboardScreen, DashMonthBar, DashExpBar, DashCashPt, DashVendorBar } from "dashboard.slint";

// ── Batch monitor per-file row ────────────────────────────────────────────────
export struct BatchFileRow {
    file:    string,
    bank:    string,
    account: string,
    period:  string,
    txns:    int,
    status:  string,
    is-ok:   bool,
    err-msg: string,
}

// ── Transaction row data struct ────────────────────────────────────────────────
export struct TxnRow {
    bank-name:    string,
    account-no:   string,
    date:         string,
    narration:    string,
    ref-no:       string,
    debit:        string,
    credit:       string,
    balance:      string,
    vendor:       string,
    ledger:       string,
    expense-head: string,
    status-text:  string,
    tags:         string,
    review:       string,
    // 0=white 1=hi-green 2=med-yellow 3=review-red 4=suspense-purple 5=dup-pink 6=manual-blue
    row-color:    int,
    has-gst:      bool,
    has-tax:      bool,
    has-dup-tag:  bool,
}

// ── Compact toolbar button (white bg, blue border — matches original .btn in toolbar) ─────
// btn-primary: bg #1565C0 fg white. btn-ai: bg #6B2FB8 fg white font-weight 700.
component TBtn inherits Rectangle {
    in property <string> text:    "";
    in property <bool>   enabled: true;
    in property <color>  bg:      #FFFFFF;
    in property <color>  fg:      #0A1929;
    in property <int>    fw:      500;   // font-weight override (btn-ai needs 700)
    callback clicked();

    height: 28px; min-width: 58px;
    background:    root.enabled ? root.bg : #FFFFFF28;
    border-radius: 4px;
    border-width:  1px;
    border-color:  root.enabled ? (root.bg == #FFFFFF ? #90CAF9 : root.bg) : #FFFFFF20;
    opacity:       root.enabled ? 1.0 : 0.4;

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text; font-size: 12px; font-weight: root.fw;
        color: root.enabled ? root.fg : root.fg;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ── Date-preset quick button ───────────────────────────────────────────────────
component QBtn inherits Rectangle {
    in property <string> text:    "";
    in property <bool>   active:  false;
    in property <bool>   enabled: true;
    callback clicked();

    height: 24px; min-width: 62px;
    background:    root.active ? #D4E8FF : #FFFFFF;
    border-radius: 4px;
    border-width:  1px;
    border-color:  root.active ? #1565C0 : #B0C8E8;

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text; font-size: 10px;
        color: root.active ? #1565C0 : (root.enabled ? #1565C0 : #90A8C0);
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ── Transaction status filter button ──────────────────────────────────────────
component FBtn inherits Rectangle {
    in property <string> label:    "";
    in property <string> count:    "";
    in property <bool>   active:   false;
    in property <color>  a-bg:     #1565C0;
    in property <color>  a-fg:     white;
    in property <color>  i-border: #90CAF9;
    in property <color>  i-fg:     #555555;
    callback clicked();

    height: 22px; min-width: 50px;
    background:    root.active ? root.a-bg : #FFFFFF;
    border-radius: 3px;
    border-width:  1px;
    border-color:  root.active ? root.a-bg : root.i-border;

    TouchArea { clicked => { root.clicked(); } }
    HorizontalBox {
        padding-left: 7px; padding-right: 7px;
        padding-top: 0px; padding-bottom: 0px;
        spacing: 3px; alignment: center;
        Text {
            text: root.label; font-size: 11px;
            color: root.active ? root.a-fg : root.i-fg;
            vertical-alignment: center;
        }
        // count badge: inactive=rgba(0,0,0,.15)=#00000026, active=rgba(255,255,255,.28)=#FFFFFF47
        if root.count != "" : Rectangle {
            height: 16px; min-width: 20px;
            background:    root.active ? #FFFFFF47 : #00000026;
            border-radius: 8px;
            Text {
                text: root.count; font-size: 9px; font-weight: 800;
                color: root.active ? white : #37474F;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

// ── Custom tab button (on dark #0D47A1 background) ────────────────────────────
component VTab inherits Rectangle {
    in property <string> text:   "";
    in property <bool>   active: false;
    callback clicked();

    height: 36px; min-width: 110px;
    background: transparent; border-width: 0px;

    // Active bottom border (3px, light blue)
    Rectangle {
        y: parent.height - 3px; height: 3px;
        background: root.active ? #64B5F6 : transparent;
    }
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text; font-size: 12px;
        font-weight: 700;
        color: root.active ? #FFFFFF : #90CAF9;
        letter-spacing: 0.72px;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ── Footer action button ───────────────────────────────────────────────────────
// Original .btn: padding:5px 11px; font-size:12px; font-weight:500; border:1px solid #90CAF9; border-radius:4px; height≈27px
component FootBtn inherits Rectangle {
    in property <string> text:       "";
    in property <bool>   enabled:    false;
    in property <color>  bg:         #FFFFFF;
    in property <color>  border-clr: #90CAF9;
    in property <color>  fg:         #0A1929;
    callback clicked();

    height: 28px; min-width: 82px;
    background:    root.enabled ? root.bg : #F5F5F5;
    border-radius: 4px;
    border-width:  1px;
    border-color:  root.enabled ? root.border-clr : #E0E0E0;
    opacity:       root.enabled ? 1.0 : 0.4;

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text; font-size: 12px; font-weight: 500;
        color: root.enabled ? root.fg : #BDBDBD;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ── Summary label / value row ──────────────────────────────────────────────────
component SR inherits Rectangle {
    in property <string> lbl:  "";
    in property <string> val:  "\u{2014}";
    in property <color>  vcol: #37474F;
    in property <bool>   clickable: false;
    callback clicked();
    height: 18px;
    HorizontalLayout {
        padding: 0px; spacing: 0px; width: parent.width; height: parent.height;
        Text {
            text: root.lbl; font-size: 12px; color: #607D8B;
            horizontal-stretch: 1; vertical-alignment: center;
        }
        Text {
            text: root.val; font-size: 12px; font-weight: 600;
            color: root.vcol; horizontal-alignment: right; vertical-alignment: center;
        }
    }
    if root.clickable : TouchArea {
        x: 0; y: 0; width: parent.width; height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Summary section title ──────────────────────────────────────────────────────
// Original .sec-title: margin-top:11px; margin-bottom:3px; font-size:10px; font-weight:700; color:#1565C0; letter-spacing:.6px
component SDivider inherits VerticalBox {
    in property <string> title: "";
    padding: 0px; spacing: 3px; height: 24px;
    Rectangle { height: 1px; background: #BBDEFB; }
    Text {
        text: root.title; font-size: 10px; font-weight: 700;
        color: #1565C0; letter-spacing: 0.6px;
    }
}

// ── Modal action button ────────────────────────────────────────────────────────
// Original .btn: padding:5px 11px; font-size:12px; border-radius:4px; height≈27px
component MBtn inherits Rectangle {
    in property <string> text:    "";
    in property <color>  bg:      #1565C0;
    in property <color>  fg:      white;
    in property <bool>   enabled: true;
    callback clicked();

    height: 28px; min-width: 80px;
    background:    root.enabled ? root.bg : #F5F5F5;
    border-radius: 4px;
    border-width:  root.enabled ? 0px : 1px;
    border-color:  #D0D0D0;

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text; font-size: 12px;
        color: root.enabled ? root.fg : #BDBDBD;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ── Modal header ───────────────────────────────────────────────────────────────
component MHdr inherits Rectangle {
    in property <string> title: "";
    in property <color>  bg:    #FFFFFF;
    callback close();

    height: 46px; background: root.bg;
    border-width: 0px;

    // Bottom border only
    Rectangle { y: parent.height - 1px; height: 1px; background: #EEEEEE; }

    HorizontalBox {
        padding-left: 18px; padding-right: 12px;
        padding-top: 0px; padding-bottom: 0px;
        Text {
            text: root.title; font-size: 15px; font-weight: 700;
            color: #0A1929; vertical-alignment: center; horizontal-stretch: 1;
        }
        Rectangle {
            width: 28px; height: 28px; border-radius: 14px; background: transparent;
            TouchArea { clicked => { root.close(); } }
            Text {
                text: "\u{2715}"; font-size: 22px; color: #AAAAAA;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

// ── Modal footer row (always right-aligned, matching original flex-end) ────────
component MFtr inherits Rectangle {
    height: 50px; background: #FFFFFF;
    border-width: 0px;
    // Top border only
    Rectangle { y: 0; height: 1px; background: #EEEEEE; }
    HorizontalBox {
        padding-left: 18px; padding-right: 18px;
        padding-top: 0px; padding-bottom: 0px;
        spacing: 8px;
        alignment: start;
        // Auto stretch-spacer pushes all children right (flex-end equivalent)
        Rectangle { horizontal-stretch: 1; }
        @children
    }
}

// ── Transaction table header ───────────────────────────────────────────────────
// Original: thead { background:#1565C0; } th { padding:7px 9px; font-weight:600; white-space:nowrap; border-right:1px solid #1976D2; }
// Generated columns have font-style:italic. Debit header color:#FFCDD2, Credit:#C8E6C9
component TxnHeader inherits Rectangle {
    height: 32px; background: #1565C0;
    Rectangle { y: 31px; height: 1px; background: #1976D2; }

    HorizontalBox {
        padding: 0px; spacing: 0px;
        // Bank Name 90px (raw)
        Rectangle { width: 90px; clip: true;
            Rectangle { x: 89px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 72px; height: parent.height; text: "Bank Name"; font-size: 12px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; }
        }
        // Account No 90px (raw)
        Rectangle { width: 90px; clip: true;
            Rectangle { x: 89px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 72px; height: parent.height; text: "Account No"; font-size: 12px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; }
        }
        // Date 82px (raw)
        Rectangle { width: 82px; clip: true;
            Rectangle { x: 81px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 64px; height: parent.height; text: "Date"; font-size: 12px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; }
        }
        // Narration stretch (raw)
        Rectangle { horizontal-stretch: 1; clip: true;
            Rectangle { x: parent.width - 1px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: parent.width - 18px; height: parent.height; text: "Narration"; font-size: 12px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; }
        }
        // Ref 95px (raw)
        Rectangle { width: 95px; clip: true;
            Rectangle { x: 94px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 77px; height: parent.height; text: "Ref"; font-size: 12px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; }
        }
        // Debit 92px (raw) — pink tint header
        Rectangle { width: 92px; clip: true;
            Rectangle { x: 91px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 0px; width: 83px; height: parent.height; text: "Debit"; font-size: 12px; font-weight: 600; color: #FFCDD2; letter-spacing: 0.2px; horizontal-alignment: right; vertical-alignment: center; }
        }
        // Credit 92px (raw) — green tint header
        Rectangle { width: 92px; clip: true;
            Rectangle { x: 91px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 0px; width: 83px; height: parent.height; text: "Credit"; font-size: 12px; font-weight: 600; color: #C8E6C9; letter-spacing: 0.2px; horizontal-alignment: right; vertical-alignment: center; }
        }
        // Balance 100px (raw)
        Rectangle { width: 100px; clip: true;
            Rectangle { x: 99px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 0px; width: 91px; height: parent.height; text: "Balance"; font-size: 12px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.2px; horizontal-alignment: right; vertical-alignment: center; }
        }
        // Vendor/Customer 120px (generated — italic)
        Rectangle { width: 120px; clip: true;
            Rectangle { x: 119px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 102px; height: parent.height; text: "Vendor/Customer"; font-size: 12px; font-weight: 600; font-italic: true; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; }
        }
        // Ledger for Posting 120px (generated — italic)
        Rectangle { width: 120px; clip: true;
            Rectangle { x: 119px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 102px; height: parent.height; text: "Ledger for Posting"; font-size: 12px; font-weight: 600; font-italic: true; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; overflow: elide; }
        }
        // Expense Head 100px (generated — italic)
        Rectangle { width: 100px; clip: true;
            Rectangle { x: 99px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 82px; height: parent.height; text: "Expense Head"; font-size: 12px; font-weight: 600; font-italic: true; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; overflow: elide; }
        }
        // Type/Status 75px (generated — italic)
        Rectangle { width: 75px; clip: true;
            Rectangle { x: 74px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 57px; height: parent.height; text: "Type/Status"; font-size: 12px; font-weight: 600; font-italic: true; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; overflow: elide; }
        }
        // Tags 80px (generated — italic, min-width:80px in original)
        Rectangle { width: 80px; clip: true;
            Rectangle { x: 79px; y: 8px; width: 1px; height: 16px; background: #1976D2; }
            Text { x: 9px; width: 62px; height: parent.height; text: "Tags"; font-size: 12px; font-weight: 600; font-italic: true; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; }
        }
        // Review 60px (generated — italic)
        Rectangle { width: 60px; clip: true;
            Text { x: 9px; width: 42px; height: parent.height; text: "Review"; font-size: 12px; font-weight: 600; font-italic: true; color: #FFFFFF; letter-spacing: 0.2px; vertical-alignment: center; }
        }
    }
}

// ── Custom transaction table row ───────────────────────────────────────────────
component TxnTableRow inherits Rectangle {
    in property <TxnRow> data;
    in property <int>    row-idx;
    in property <bool>   compact: false;
    callback clicked(int);

    height: root.compact ? 22px : 26px;
    background:
        root.data.row-color == 1 ? #E8F5E9 :
        root.data.row-color == 2 ? #FFFDE7 :
        root.data.row-color == 3 ? #FFEBEE :
        root.data.row-color == 4 ? #F3E5F5 :
        root.data.row-color == 5 ? #FCE4EC :
        root.data.row-color == 6 ? #E3F2FD :
        #FFFFFF;

    // Bottom row separator
    Rectangle { y: parent.height - 1px; height: 1px; background: #E3F2FD; }

    ta := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.clicked(root.row-idx); }
    }

    HorizontalBox {
        padding: 0px; spacing: 0px;

        // Bank Name 90px (matches header)
        Rectangle { width: 90px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.bank-name; font-size: 11px; color: #555555;
                   vertical-alignment: center; overflow: elide; }
        }
        // Account No 90px (matches header)
        Rectangle { width: 90px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.account-no; font-size: 11px; color: #555555;
                   vertical-alignment: center; overflow: elide; }
        }
        // Date 82px
        Rectangle { width: 82px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.date; font-size: 12px; color: #0A1929;
                   vertical-alignment: center; overflow: elide; }
        }
        // Narration stretch
        Rectangle { horizontal-stretch: 1; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.narration; font-size: 12px; color: #0A1929;
                   vertical-alignment: center; overflow: elide; }
        }
        // Ref 95px
        Rectangle { width: 95px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.ref-no; font-size: 11px; color: #546E7A;
                   vertical-alignment: center; overflow: elide; }
        }
        // Debit 92px right-aligned red
        Rectangle { width: 92px; clip: true;
            Text { x: 0px; width: parent.width - 9px; height: parent.height;
                   text: root.data.debit;
                   font-size: 12px; font-weight: root.data.debit != "" ? 600 : 400;
                   color: root.data.debit != "" ? #B71C1C : #CCCCCC;
                   horizontal-alignment: right; vertical-alignment: center; }
        }
        // Credit 92px right-aligned green
        Rectangle { width: 92px; clip: true;
            Text { x: 0px; width: parent.width - 9px; height: parent.height;
                   text: root.data.credit;
                   font-size: 12px; font-weight: root.data.credit != "" ? 600 : 400;
                   color: root.data.credit != "" ? #1B5E20 : #CCCCCC;
                   horizontal-alignment: right; vertical-alignment: center; }
        }
        // Balance 100px right-aligned blue
        Rectangle { width: 100px; clip: true;
            Text { x: 0px; width: parent.width - 9px; height: parent.height;
                   text: root.data.balance; font-size: 12px; font-weight: 600;
                   color: #0D47A1;
                   horizontal-alignment: right; vertical-alignment: center; }
        }
        // Vendor 120px
        Rectangle { width: 120px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.vendor; font-size: 12px; color: #0D47A1; font-weight: 600;
                   vertical-alignment: center; overflow: elide; }
        }
        // Ledger 120px
        Rectangle { width: 120px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.ledger; font-size: 12px; color: #0D47A1; font-weight: 600;
                   vertical-alignment: center; overflow: elide; }
        }
        // Expense Head 100px
        Rectangle { width: 100px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.expense-head; font-size: 11px; color: #455A64;
                   vertical-alignment: center; overflow: elide; }
        }
        // Status 75px — chip rendering
        Rectangle { width: 75px; clip: true;
            HorizontalBox {
                padding-left: 4px; padding-right: 4px;
                padding-top: 0px; padding-bottom: 0px;
                spacing: 2px; alignment: start;
                if root.data.row-color == 1 : Rectangle {
                    height: 14px; min-width: 34px; background: #C8E6C9;
                    border-radius: 7px; border-width: 1px; border-color: #81C784;
                    Text { text: "HIGH"; font-size: 9px; font-weight: 800; color: #1B5E20;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 3 : Rectangle {
                    height: 14px; min-width: 42px; background: #FFCDD2;
                    border-radius: 7px; border-width: 1px; border-color: #EF9A9A;
                    Text { text: "REVIEW"; font-size: 9px; font-weight: 800; color: #B71C1C;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 4 : Rectangle {
                    height: 14px; min-width: 56px; background: #E1BEE7;
                    border-radius: 7px; border-width: 1px; border-color: #BA68C8;
                    Text { text: "SUSPENSE"; font-size: 9px; font-weight: 800; color: #6A1B9A;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 5 : Rectangle {
                    height: 14px; min-width: 30px; background: #FCE4EC;
                    border-radius: 7px; border-width: 1px; border-color: #E91E63;
                    Text { text: "DUP"; font-size: 9px; font-weight: 800; color: #880E4F;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 6 : Rectangle {
                    height: 14px; min-width: 38px; background: #BBDEFB;
                    border-radius: 7px; border-width: 1px; border-color: #64B5F6;
                    Text { text: "MANUAL"; font-size: 9px; font-weight: 800; color: #0D47A1;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.row-color == 0 : Text {
                    text: root.data.status-text; font-size: 10px; color: #888888;
                    vertical-alignment: center;
                }
            }
        }
        // Tags 80px — GST/TAX/DUP badges (original: min-width:80px)
        Rectangle { width: 80px; clip: true;
            HorizontalBox {
                padding-left: 3px; padding-right: 3px;
                padding-top: 0px; padding-bottom: 0px;
                spacing: 2px; alignment: start;
                if root.data.has-gst : Rectangle {
                    height: 14px; min-width: 26px; background: #C8E6C9;
                    border-radius: 3px; border-width: 1px; border-color: #66BB6A;
                    Text { text: "GST"; font-size: 9px; font-weight: 800; color: #1B5E20;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.has-tax : Rectangle {
                    height: 14px; min-width: 26px; background: #FFE0B2;
                    border-radius: 3px; border-width: 1px; border-color: #FFA726;
                    Text { text: "TAX"; font-size: 9px; font-weight: 800; color: #BF360C;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.data.has-dup-tag : Rectangle {
                    height: 14px; min-width: 26px; background: #FCE4EC;
                    border-radius: 3px; border-width: 1px; border-color: #E91E63;
                    Text { text: "DUP"; font-size: 9px; font-weight: 800; color: #880E4F;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        // Review 60px
        Rectangle { width: 60px; clip: true;
            Text { x: 6px; width: parent.width - 12px; height: parent.height;
                   text: root.data.review; font-size: 11px; color: #546E7A;
                   vertical-alignment: center; overflow: elide; }
        }
    }
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MainScreen
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
export component MainScreen inherits Rectangle {
    background: #F0F7FF;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback logout();
    callback load-file();
    callback batch-folder();
    callback new-client();
    callback auto-classify();
    callback ai-classify();
    callback view-rules();
    callback import-history();
    callback import-ledgers();
    callback filter-changed(string);
    callback date-filter-apply(string, string);
    callback date-preset(string);
    callback bank-filter-changed(string);
    callback drill-filter(string);  // dashboard stat row drill-down: sets filter + switches to txns view
    callback export-excel();
    callback export-tally();
    callback export-accounting();
    callback export-preview();    // recomputes the export summary line for wizard step 4
    callback toggle-status(string);  // multi-status filter toggle
    callback reimport-excel();
    callback reset-dedupe();
    callback reconcile();
    callback open-batch-monitor();
    callback open-audit-trail(int, int);
    callback open-settings();
    callback add-row();
    callback load-all();
    callback download-logs();
    callback export-recon-csv();
    // Row editing
    callback row-click(int);
    callback save-txn(int, string, string, string, bool);
    callback delete-txn(int);
    callback mark-suspense(int);
    callback add-txn(string, string, string, string, string, string, string, string);
    // Client management
    callback select-client(string);
    callback delete-client();
    callback edit-client();
    // Import history reload
    callback reload-import(int);
    // Settings save (provider, api-key, enabled)
    callback settings-save(string, string, bool);
    // Rules backup / restore
    callback backup-rules();
    callback restore-rules();

    // ── Data ──────────────────────────────────────────────────────────────────
    in property <[string]> client-names: ["-- Select Client --"];
    // New client fields — in-out so Rust can read them back in do-new-client
    in-out property <string> new-client-name:   "";
    in-out property <string> new-client-ledger: "";
    // AI settings fields — in-out so Rust can read provider + key after modal closes
    in-out property <int>    ai-provider-idx: 0;
    in-out property <string> ai-api-key:      "";
    // Import history + rules records set by Rust
    in property <[string]> import-records: [];
    in property <[string]> rule-records:   [];
    in property <string>   status-bank:  "";
    in property <string>   status-file:  "";
    in property <[TxnRow]>  transaction-rows: [];
    in property <[string]> bank-names: ["All Banks"];

    in property <string> dash-bank-name:    "";
    in property <string> dash-opening:      "\u{20B9} \u{2014}";
    in property <string> dash-credits:      "\u{20B9} \u{2014}";
    in property <string> dash-debits:       "\u{20B9} \u{2014}";
    in property <string> dash-closing:      "\u{20B9} \u{2014}";
    in property <string> dash-txn-count:    "\u{2014}";
    in property <string> dash-vendors:      "\u{2014}";
    in property <string> dash-client-name:  "";
    in property <string> dash-account-no:   "";
    in property <string> dash-period:       "\u{2014}";
    in property <string> dash-credit-count: "\u{2014}";
    in property <string> dash-debit-count:  "\u{2014}";
    in property <string> dash-unreviewed:   "0";
    in property <string> dash-suspense:     "0";
    in property <string> dash-needs-review: "0";
    in property <string> dash-duplicates:   "0";
    in property <string> dash-gst-count:    "0";
    in property <string> dash-calc-closing: "\u{20B9} \u{2014}";
    in property <bool>   dash-has-mismatch: false;
    in property <string> dash-mismatch:     "";

    // ── Dashboard chart data ──────────────────────────────────────────────────
    in property <string> dash-net-flow:       "₹ —";
    in property <string> dash-top-expense:    "—";
    in property <string> dash-top-exp-amt:    "";
    in property <bool>   dash-has-data:       false;
    in property <[DashMonthBar]>  dash-chart-monthly:  [];
    in property <[DashExpBar]>    dash-chart-expenses: [];
    in property <[DashCashPt]>    dash-chart-cashflow: [];
    in property <[DashVendorBar]> dash-chart-vendors:  [];
    in property <[string]> dash-filter-banks:   ["All Banks"];
    in property <[string]> dash-filter-vendors: ["All Vendors"];
    in property <[string]> dash-filter-heads:   ["All Expense Heads"];
    // Insight strip
    in property <string> dash-ins-max-dr:      "—";
    in property <string> dash-ins-max-dr-narr: "";
    in property <string> dash-ins-max-cr:      "—";
    in property <string> dash-ins-max-cr-narr: "";
    in property <string> dash-ins-avg-dr:      "—";
    in property <string> dash-ins-avg-cr:      "—";
    in property <string> dash-ins-dr-count:    "";
    in property <string> dash-ins-cr-count:    "";
    in property <string> dash-ins-freq-vendor: "—";
    // Dashboard filter callbacks
    callback dash-filter-changed(string, string, string, string, string);

    in property <string> fc-all:        "0";
    in property <string> fc-unreviewed: "0";
    in property <string> fc-suspense:   "0";
    in property <string> fc-high:       "0";
    in property <string> fc-duplicates: "0";
    in property <string> fc-gst:        "0";
    in property <string> fc-review:     "0";

    // ── Toast / overlays ─────────────────────────────────────────────────────
    in property <string> toast-msg:           "";
    in property <int>    toast-kind:          0;  // 0=info, 1=success, 2=error, 3=warning
    in property <bool>   ocr-visible:         false;
    in property <string> ocr-msg:             "Initialising…";
    in property <int>    ocr-pct:             0;
    in property <bool>   ai-overlay-visible:  false;
    in property <string> ai-msg:              "Preparing…";
    in property <int>    ai-pct:              0;
    in property <bool>   pdf-pwd-visible:     false;
    in property <string> pdf-pwd-prompt:      "";
    in-out property <string> pdf-pwd-input:   "";
    callback pdf-pwd-confirm(string);
    callback pdf-pwd-cancel();
    callback ai-cancel();

    // ── Edit transaction (read-only display data set by Rust) ────────────────
    in property <string> edit-txn-date: "";
    in property <string> edit-txn-narr: "";
    in property <string> edit-txn-dr:   "";
    in property <string> edit-txn-cr:   "";
    in property <string> edit-txn-bank: "";
    in property <int>    edit-txn-idx:  -1;

    // ── Internal state ─────────────────────────────────────────────────────────
    in-out property <bool>   show-dashboard:  true;
    in-out property <string> active-filter:   "all";
    // Multi-status filter toggle state (set by Rust after toggle-status callback)
    in property <bool> fs-unreviewed: false;
    in property <bool> fs-suspense:   false;
    in property <bool> fs-high:       false;
    in property <bool> fs-dups:       false;
    in property <bool> fs-gst:        false;
    in property <bool> fs-review:     false;
    in property <bool> fs-credits:    false;
    in property <bool> fs-debits:     false;
    in-out property <bool>   dedup-enabled:       true;
    in-out property <bool>   ai-consent-checked:  false;
    in-out property <string> date-from:      "";
    in-out property <string> date-to:        "";
    in-out property <string> active-preset:  "";
    in-out property <string> modal-state:    "";
    // Edit transaction editable fields
    in-out property <string> etxn-vendor: "";
    in-out property <string> etxn-head:   "";
    in-out property <int>    etxn-type-idx: 0;
    // Add transaction fields
    in-out property <string> add-date:   "";
    in-out property <string> add-ref:    "";
    in-out property <string> add-narr:   "";
    in-out property <string> add-dr:     "";
    in-out property <string> add-cr:     "";
    in-out property <string> add-vendor: "";
    in-out property <string> add-head:   "";
    in-out property <int>    add-type-idx: 0;
    // Compact mode + double-click state
    in-out property <bool>   compact-mode:      false;
    in-out property <int>    dclick-pending-idx: -1;
    // Export wizard state
    in-out property <int>    wiz-step:      1;
    in-out property <int>    wiz-sw-idx:    0;   // selected software 0=Tally 1=Zoho 2=QB 3=Odoo 4=Excel 5=XML
    in-out property <string> wiz-company:   "";
    in-out property <string> wiz-gstin:     "";
    in-out property <string> wiz-from:      "";
    in-out property <string> wiz-to:        "";
    // Export wizard step 4 option flags
    in-out property <bool>   wiz-opt-ob:           false;  // include opening balance entry
    in-out property <bool>   wiz-opt-gst:          true;   // include GST details
    in-out property <bool>   wiz-opt-ledger:       true;   // include ledger creation entries
    in-out property <bool>   wiz-opt-narr:         true;   // include voucher narrations
    in-out property <bool>   wiz-opt-classified:   true;   // export only classified transactions
    in-out property <bool>   wiz-opt-skip-low:     false;  // skip low-confidence (<40%)

    // Edit client fields — in-out so Rust can read them back
    in-out property <string> edit-client-name:   "";
    in-out property <string> edit-client-ledger: "";
    // Current client ledger name shown in summary (used to pre-fill edit modal)
    in property <string>     dash-client-ledger: "";
    // Batch monitor status line set by Rust after processing
    in property <string>          batch-log: "";
    in property <[BatchFileRow]>  batch-file-rows: [];
    // Export wizard step 4 preview (set by Rust via do-export-preview callback)
    in property <string>          export-preview-text: "";
    // Reconcile counters set by Rust after reconcile()
    in property <string>     recon-matched:    "0";
    in property <string>     recon-likely:     "0";
    in property <string>     recon-unmatched:  "0";
    in property <string>     recon-bank-only:  "0";
    in property <string>     recon-status:     "";
    // Audit trail records (set by Rust in do-audit-trail)
    in property <[string]>   audit-records: [];
    in-out property <int>    audit-action-idx: 0;
    in-out property <int>    audit-type-idx:   0;

    // ── Application Settings fields (persisted via settings-save-all) ──────────
    in-out property <bool>   settings-narr-enabled:    true;
    in-out property <bool>   settings-narr-title-case: true;
    in-out property <bool>   settings-narr-preserve:   false;
    in-out property <bool>   settings-gst-enabled:     true;
    in-out property <bool>   settings-gst-auto-ledgers:true;
    in-out property <string> settings-recon-days:      "3";
    in-out property <string> settings-recon-pct:       "0.5";
    in-out property <int>    settings-log-level:       0;  // 0=INFO 1=DEBUG 2=WARN 3=ERROR
    callback settings-save-all();
    callback clear-logs();

    // ── MAIN LAYOUT ───────────────────────────────────────────────────────────
    VerticalLayout {
        padding: 0px; spacing: 0px;
        width: root.width; height: root.height;

        // ─────────────────────────── TOOLBAR ──────────────────────────────────
        // background: #1565C0, box-shadow: 0 2px 8px rgba(13,71,161,.40), border-bottom: 2px solid #0D47A1
        Rectangle {
            height: 50px; background: #1565C0;
            drop-shadow-blur: 8px;
            drop-shadow-color: #0D47A166;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 2px;

            // Bottom border
            Rectangle {
                y: 48px; height: 2px; background: #0D47A1;
            }

            HorizontalBox {
                padding-left: 14px; padding-right: 14px;
                padding-top: 0px; padding-bottom: 0px;
                spacing: 10px; height: 48px;

                // Firm block — stacked vertically
                VerticalBox {
                    padding: 0px; spacing: 0px; alignment: center;
                    min-width: 155px; max-width: 155px;
                    Text {
                        text: "A S Havaldar";
                        color: #FFFFFF; font-size: 16px; font-weight: 800;
                        letter-spacing: 0.4px;
                    }
                    Text {
                        text: "Bank Statement Processor";
                        color: #BBDEFB; font-size: 11px; font-weight: 500;
                        letter-spacing: 0.3px;
                    }
                }

                // Client dropdown
                Text { text: "Client:"; font-size: 12px; color: #E3F2FD; vertical-alignment: center; font-weight: 600; }
                ComboBox {
                    model: root.client-names; current-index: 0;
                    height: 28px; min-width: 160px;
                    selected(v) => { root.select-client(v); }
                }
                // btn-primary: background #1565C0, color #fff (blue-on-blue in toolbar)
                TBtn { text: "+ New Client"; bg: #1565C0; fg: #FFFFFF; clicked => { root.modal-state = "new-client"; } }
                TBtn { text: "Edit Client"; bg: #0277BD; fg: #FFFFFF; clicked => {
                    root.edit-client-name   = root.dash-client-name;
                    root.edit-client-ledger = root.dash-client-ledger;
                    root.modal-state = "edit-client";
                } }

                Rectangle { width: 1px; height: 28px; background: #FFFFFF30; }

                TBtn { text: "Load Single File"; clicked => { root.load-file(); } }
                TBtn { text: "Batch Process Folder"; enabled: true; clicked => { root.batch-folder(); } }

                Rectangle { width: 1px; height: 28px; background: #FFFFFF30; }

                TBtn {
                    text: "Auto-Classify All";
                    enabled: root.transaction-rows.length > 0;
                    clicked => { root.auto-classify(); }
                }
                // .btn-ai { background: linear-gradient(#5C35C5,#7B1FA2); color:#fff; font-weight:700; letter-spacing:.04em }
                TBtn {
                    text: "\u{2605} AI Classify";
                    bg: #6B2FB8; fg: #FFFFFF; fw: 700;
                    enabled: root.transaction-rows.length > 0;
                    clicked => { root.ai-consent-checked = false; root.modal-state = "ai-consent"; }
                }

                Rectangle { width: 1px; height: 28px; background: #FFFFFF30; }

                TBtn { text: "View Rules"; enabled: true; clicked => { root.view-rules(); root.modal-state = "view-rules"; } }
                TBtn {
                    text: "Import History";
                    enabled: root.transaction-rows.length > 0;
                    clicked => { root.modal-state = "import-history"; }
                }
                TBtn { text: "Import Ledgers"; enabled: false; clicked => { root.import-ledgers(); } }

                Rectangle { width: 1px; height: 28px; background: #FFFFFF30; }

                HorizontalBox {
                    padding: 0px; spacing: 4px;
                    CheckBox { text: "Dedupe"; checked <=> root.dedup-enabled; }
                }

                // .loaded-file { font-size:11px; color:#BBDEFB; font-style:italic }
                if root.status-file != "" : Text {
                    text: root.status-file; color: #BBDEFB; font-size: 11px; font-italic: true;
                    vertical-alignment: center; max-width: 180px;
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ─────────────────────────── DATE RANGE BAR ───────────────────────────
        // background: #EBF3FF, border-bottom: 1px solid #C5D9F0
        Rectangle {
            height: 36px; background: #EBF3FF;

            // Bottom border
            Rectangle { y: 35px; height: 1px; background: #C5D9F0; }

            HorizontalBox {
                padding-left: 12px; padding-right: 12px;
                padding-top: 0px; padding-bottom: 0px;
                spacing: 6px; height: 35px;

                // .dr-label: font-size:11px; font-weight:700; color:#1565C0; text-transform:uppercase → "PERIOD:"
                Text {
                    text: "PERIOD:"; font-size: 11px;
                    color: #1565C0; font-weight: 700; letter-spacing: 0.55px;
                    vertical-alignment: center;
                }

                LineEdit {
                    placeholder-text: "DD/MM/YYYY"; text: root.date-from;
                    height: 26px; min-width: 100px; max-width: 100px; font-size: 11px;
                    edited(v) => { root.date-from = v; }
                }
                Text { text: "\u{2013}"; color: #7B97B4; vertical-alignment: center; font-size: 13px; }
                LineEdit {
                    placeholder-text: "DD/MM/YYYY"; text: root.date-to;
                    height: 26px; min-width: 100px; max-width: 100px; font-size: 11px;
                    edited(v) => { root.date-to = v; }
                }

                // Apply: .btn.btn-sm.btn-primary → font-size:10px; padding:2px 7px; height:~24px
                Rectangle {
                    height: 24px; width: 52px;
                    background: #1565C0; border-radius: 4px;
                    TouchArea { clicked => { root.date-filter-apply(root.date-from, root.date-to); } }
                    Text { text: "Apply"; font-size: 10px; font-weight: 500; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }
                // Clear: .btn.btn-sm → font-size:10px; padding:2px 7px; height:~24px
                Rectangle {
                    height: 24px; width: 46px;
                    background: #FFFFFF; border-radius: 4px;
                    border-width: 1px; border-color: #B0C8E8;
                    TouchArea { clicked => { root.date-from = ""; root.date-to = ""; root.active-preset = ""; root.date-filter-apply("", ""); } }
                    Text { text: "Clear"; font-size: 10px; color: #546E7A; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle { width: 1px; height: 18px; background: #C5D9F0; }

                QBtn { text: "Today";      active: root.active-preset == "today";      enabled: root.transaction-rows.length > 0; clicked => { root.active-preset = "today";      root.date-preset("today"); } }
                QBtn { text: "This Month"; active: root.active-preset == "this_month"; enabled: root.transaction-rows.length > 0; clicked => { root.active-preset = "this_month"; root.date-preset("this_month"); } }
                QBtn { text: "Last Month"; active: root.active-preset == "last_month"; enabled: root.transaction-rows.length > 0; clicked => { root.active-preset = "last_month"; root.date-preset("last_month"); } }
                QBtn { text: "Current FY"; active: root.active-preset == "current_fy"; enabled: root.transaction-rows.length > 0; clicked => { root.active-preset = "current_fy"; root.date-preset("current_fy"); } }
                QBtn { text: "Prev FY";    active: root.active-preset == "prev_fy";    enabled: root.transaction-rows.length > 0; clicked => { root.active-preset = "prev_fy";    root.date-preset("prev_fy"); } }

                // Active range chip — .dr-active-chip { background:#FF8F00; border-radius:12px }
                if root.active-preset != "" : Rectangle {
                    height: 20px;
                    background: #FF8F00; border-radius: 10px;
                    HorizontalBox {
                        padding-left: 8px; padding-right: 6px;
                        padding-top: 0px; padding-bottom: 0px; spacing: 4px;
                        Text {
                            text: root.active-preset == "today"      ? "Today" :
                                  root.active-preset == "this_month" ? "This Month" :
                                  root.active-preset == "last_month" ? "Last Month" :
                                  root.active-preset == "current_fy" ? "Current FY" :
                                  root.active-preset == "prev_fy"    ? "Prev FY" : root.active-preset;
                            font-size: 10px; font-weight: 700; color: white;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 14px; height: 14px; border-radius: 7px;
                            background: #FFFFFF30;
                            TouchArea { clicked => { root.active-preset = ""; root.date-filter-apply("", ""); } }
                            Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ─────────────────────────── VIEW TABS ────────────────────────────────
        // background: #0D47A1 (deep blue), border-bottom: 2px solid #1565C0
        Rectangle {
            height: 38px; background: #0D47A1;

            // Bottom border
            Rectangle { y: 36px; height: 2px; background: #1565C0; }

            HorizontalBox {
                padding-left: 14px; padding-right: 14px;
                padding-top: 0px; padding-bottom: 0px;
                spacing: 0px; height: 36px;
                VTab { text: "TRANSACTIONS"; active: !root.show-dashboard; clicked => { root.show-dashboard = false; } }
                VTab { text: "DASHBOARD";    active:  root.show-dashboard;  clicked => { root.show-dashboard = true;  } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ─────────────────────────── CONTENT AREA (stretch wrapper) ─────────────
        Rectangle {
            vertical-stretch: 1; clip: true;

        // ─────────────────────────── TRANSACTIONS PANEL ───────────────────────
        if !root.show-dashboard : VerticalBox {
            padding: 0px; spacing: 0px;
            width: parent.width; height: parent.height;

                // Panel header — .panel-hdr { padding:7px 12px; font-size:12px; background:#E3F2FD; }
                Rectangle {
                    height: 36px; background: #E3F2FD;

                    // Bottom border
                    Rectangle { y: 35px; height: 1px; background: #BBDEFB; }

                    HorizontalBox {
                        padding-left: 12px; padding-right: 12px;
                        padding-top: 0px; padding-bottom: 0px;
                        spacing: 4px; height: 35px;

                        Text {
                            text: "Transactions"; font-size: 12px; font-weight: 600;
                            color: #0D47A1; vertical-alignment: center;
                        }
                        Text {
                            text: "(double-click to edit)"; font-size: 10px;
                            color: #888888; vertical-alignment: center;
                        }

                        Rectangle {
                            height: 24px; width: 68px;
                            background: #FFFFFF; border-radius: 4px;
                            border-width: 1px; border-color: #90CAF9;
                            TouchArea {
                                enabled: root.transaction-rows.length > 0;
                                clicked => {
                                    root.add-date = ""; root.add-ref = ""; root.add-narr = "";
                                    root.add-dr = ""; root.add-cr = "";
                                    root.add-vendor = ""; root.add-head = "";
                                    root.add-type-idx = 0;
                                    root.add-row();
                                    root.modal-state = "add-txn";
                                }
                            }
                            Text {
                                text: "+ Add Row"; font-size: 11px; color: #0A1929;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }

                        Rectangle { width: 1px; height: 26px; background: #BBDEFB; }

                        // Inactive colors: border from .fbtn-* class; text from .fbtn { color:#555 } default
                        // Except Needs Review: inline style="border-color:#e67e22;color:#e67e22"
                        FBtn { label: "All";         count: root.fc-all;        active: !root.fs-unreviewed && !root.fs-suspense && !root.fs-high && !root.fs-dups && !root.fs-gst && !root.fs-review && !root.fs-credits && !root.fs-debits; a-bg: #1565C0; a-fg: white; i-border: #90CAF9; i-fg: #555555; clicked => { root.active-filter = "all"; root.filter-changed("all"); } }
                        FBtn { label: "Unreviewed";  count: root.fc-unreviewed; active: root.fs-unreviewed; a-bg: #E65100; a-fg: white; i-border: #FFA726; i-fg: #555555; clicked => { root.toggle-status("unreviewed"); } }
                        FBtn { label: "Suspense";    count: root.fc-suspense;   active: root.fs-suspense;   a-bg: #7B1FA2; a-fg: white; i-border: #90CAF9; i-fg: #555555; clicked => { root.toggle-status("suspense"); } }
                        FBtn { label: "High Conf.";  count: root.fc-high;       active: root.fs-high;       a-bg: #1B5E20; a-fg: white; i-border: #43A047; i-fg: #555555; clicked => { root.toggle-status("high"); } }
                        FBtn { label: "Duplicates";  count: root.fc-duplicates; active: root.fs-dups;       a-bg: #880E4F; a-fg: white; i-border: #E91E63; i-fg: #555555; clicked => { root.toggle-status("duplicates"); } }
                        FBtn { label: "GST/Tax";     count: root.fc-gst;        active: root.fs-gst;        a-bg: #2E7D32; a-fg: white; i-border: #66BB6A; i-fg: #555555; clicked => { root.toggle-status("gst"); } }
                        FBtn { label: "Needs Review"; count: root.fc-review;    active: root.fs-review;     a-bg: #E65100; a-fg: white; i-border: #E67E22; i-fg: #E67E22; clicked => { root.toggle-status("needs_review"); } }

                        Rectangle { width: 1px; height: 26px; background: #BBDEFB; }
                        Text { text: "Bank:"; font-size: 11px; color: #607D8B; vertical-alignment: center; }
                        ComboBox {
                            model: root.bank-names; height: 26px; min-width: 100px;
                            selected(v) => { root.bank-filter-changed(v); }
                        }

                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.fc-all != "0" ? root.fc-all + " transactions" : "No file loaded";
                            font-size: 11px; color: #90A4AE; vertical-alignment: center;
                        }

                        Rectangle {
                            height: 24px; width: 60px;
                            background: #FFFFFF; border-radius: 4px;
                            border-width: 1px; border-color: #90CAF9;
                            TouchArea { clicked => { root.compact-mode = !root.compact-mode; } }
                            Text { text: "Compact"; font-size: 11px;
                                   color: root.compact-mode ? #1565C0 : #546E7A;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // ── Active filter chip bar (shown when any status filter is on) ──────
                if root.fs-unreviewed || root.fs-suspense || root.fs-high || root.fs-dups || root.fs-gst || root.fs-review || root.fs-credits || root.fs-debits : Rectangle {
                    height: 32px; background: #F8F9FA; border-width: 0px;
                    Rectangle { y: 0px; height: 1px; background: #E0E0E0; width: parent.width; }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; padding-top: 0px; padding-bottom: 0px; spacing: 6px; alignment: start;
                        Text { text: "Filters:"; font-size: 10px; font-weight: 700; color: #607D8B; vertical-alignment: center; }
                        if root.fs-unreviewed : Rectangle {
                            height: 20px; border-radius: 10px; background: #E65100;
                            HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px;
                                Text { text: "Unreviewed"; font-size: 10px; color: white; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #FFFFFF30; TouchArea { clicked => { root.toggle-status("unreviewed"); } } Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                        if root.fs-suspense : Rectangle {
                            height: 20px; border-radius: 10px; background: #7B1FA2;
                            HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px;
                                Text { text: "Suspense"; font-size: 10px; color: white; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #FFFFFF30; TouchArea { clicked => { root.toggle-status("suspense"); } } Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                        if root.fs-high : Rectangle {
                            height: 20px; border-radius: 10px; background: #1B5E20;
                            HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px;
                                Text { text: "High Conf."; font-size: 10px; color: white; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #FFFFFF30; TouchArea { clicked => { root.toggle-status("high"); } } Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                        if root.fs-dups : Rectangle {
                            height: 20px; border-radius: 10px; background: #880E4F;
                            HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px;
                                Text { text: "Duplicates"; font-size: 10px; color: white; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #FFFFFF30; TouchArea { clicked => { root.toggle-status("duplicates"); } } Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                        if root.fs-gst : Rectangle {
                            height: 20px; border-radius: 10px; background: #2E7D32;
                            HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px;
                                Text { text: "GST/Tax"; font-size: 10px; color: white; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #FFFFFF30; TouchArea { clicked => { root.toggle-status("gst"); } } Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                        if root.fs-review : Rectangle {
                            height: 20px; border-radius: 10px; background: #E65100;
                            HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px;
                                Text { text: "Needs Review"; font-size: 10px; color: white; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #FFFFFF30; TouchArea { clicked => { root.toggle-status("needs_review"); } } Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                        if root.fs-credits : Rectangle {
                            height: 20px; border-radius: 10px; background: #2E7D32;
                            HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px;
                                Text { text: "Credits Only"; font-size: 10px; color: white; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #FFFFFF30; TouchArea { clicked => { root.toggle-status("credits"); } } Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                        if root.fs-debits : Rectangle {
                            height: 20px; border-radius: 10px; background: #C62828;
                            HorizontalLayout { padding-left: 8px; padding-right: 6px; spacing: 4px;
                                Text { text: "Debits Only"; font-size: 10px; color: white; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 14px; height: 14px; border-radius: 7px; background: #FFFFFF30; TouchArea { clicked => { root.toggle-status("debits"); } } Text { text: "\u{2715}"; font-size: 9px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            height: 20px; border-radius: 10px; background: #ECEFF1; border-width: 1px; border-color: #B0BEC5;
                            HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 0px;
                                Text { text: "Clear All"; font-size: 10px; color: #546E7A; font-weight: 600; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.active-filter = "all"; root.filter-changed("all"); } }
                        }
                    }
                }

                // Table + Summary
                HorizontalBox {
                    padding: 0px; spacing: 0px; vertical-stretch: 1;

                    // Transaction table — white background
                    Rectangle {
                        horizontal-stretch: 4; background: #FFFFFF; clip: true;

                        VerticalBox {
                            padding: 0px; spacing: 0px;

                            if root.transaction-rows.length == 0 : VerticalBox {
                                alignment: center; spacing: 12px;
                                Text {
                                    text: "Select a client, then load a bank statement (Excel .xlsx / .xls)";
                                    font-size: 13px; color: #AAAAAA; font-italic: true;
                                    horizontal-alignment: center; wrap: word-wrap;
                                }
                            }

                            if root.transaction-rows.length > 0 : VerticalBox {
                                vertical-stretch: 1; padding: 0px; spacing: 0px;
                                // Sticky table header
                                TxnHeader { }
                                // Scrollable body with colored rows
                                ListView {
                                    vertical-stretch: 1;
                                    for row[idx] in root.transaction-rows : TxnTableRow {
                                        width: parent.width;
                                        data: row;
                                        row-idx: idx;
                                        compact: root.compact-mode;
                                        clicked(i) => {
                                            if root.dclick-pending-idx == i {
                                                root.row-click(i);
                                                root.etxn-vendor = "";
                                                root.etxn-head   = "";
                                                root.etxn-type-idx = 0;
                                                root.modal-state = "edit-txn";
                                                root.dclick-pending-idx = -1;
                                            } else {
                                                root.dclick-pending-idx = i;
                                            }
                                        }
                                    }
                                }
                            }

                            // Colour key — .colour-key { gap:18px; padding:5px 12px; background:#E3F2FD; font-size:11px; color:#0D47A1 }
                            // .k { display:flex; align-items:center; gap:5px; }
                            // .k::before { width:11px; height:11px; border-radius:2px; background:[color] }
                            Rectangle {
                                height: 28px; background: #E3F2FD;
                                border-width: 0px;
                                Rectangle { y: 0px; height: 1px; background: #BBDEFB; }

                                HorizontalBox {
                                    padding-left: 12px; padding-right: 12px;
                                    padding-top: 5px; padding-bottom: 5px;
                                    spacing: 18px;

                                    // Row-colour key items: coloured square dot + dark text label
                                    for item in [
                                        {lbl: "High Conf.", dot: #A5D6A7},
                                        {lbl: "Medium",     dot: #FFF176},
                                        {lbl: "Needs Review", dot: #EF9A9A},
                                        {lbl: "Suspense",   dot: #CE93D8},
                                        {lbl: "Manual",     dot: #90CAF9},
                                        {lbl: "Duplicate",  dot: #F8BBD0},
                                    ] : HorizontalBox {
                                        padding: 0px; spacing: 5px; alignment: center;
                                        Rectangle { width: 11px; height: 11px; border-radius: 2px; background: item.dot; }
                                        Text { text: item.lbl; font-size: 11px; color: #0D47A1; vertical-alignment: center; }
                                    }

                                    // Pipe separator text
                                    Text { text: "|"; font-size: 11px; color: #90CAF9; vertical-alignment: center; }

                                    // Tag badges: .txn-tag style (font-size:9.5px; background+border)
                                    for tag in [
                                        {lbl: "GST", bg: #C8E6C9, fg: #1B5E20, bc: #66BB6A},
                                        {lbl: "TAX", bg: #FFE0B2, fg: #BF360C, bc: #FFA726},
                                        {lbl: "DUP", bg: #FCE4EC, fg: #880E4F, bc: #E91E63},
                                    ] : Rectangle {
                                        height: 16px; min-width: 28px;
                                        background: tag.bg; border-radius: 3px;
                                        border-width: 1px; border-color: tag.bc;
                                        Text { text: tag.lbl; font-size: 10px; color: tag.fg; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Pipe separator text
                                    Text { text: "|"; font-size: 11px; color: #90CAF9; vertical-alignment: center; }

                                    // Status chips: .status-chip style (rounded pills)
                                    for chip in [
                                        {lbl: "HIGH",     bg: #C8E6C9, fg: #1B5E20, bc: #81C784},
                                        {lbl: "REVIEW",   bg: #FFCDD2, fg: #B71C1C, bc: #EF9A9A},
                                        {lbl: "SUSPENSE", bg: #E1BEE7, fg: #6A1B9A, bc: #BA68C8},
                                    ] : Rectangle {
                                        height: 16px; min-width: 34px;
                                        background: chip.bg; border-radius: 8px;
                                        border-width: 1px; border-color: chip.bc;
                                        Text { text: chip.lbl; font-size: 9px; color: chip.fg; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }

                    // Summary panel — background: #F0F7FF, width: 270px
                    Rectangle {
                        width: 270px;
                        background: #F0F7FF;
                        clip: true;
                        // Left border only (matches original border-left: 1px solid #BBDEFB)
                        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: #BBDEFB; }

                        ScrollView {
                            width: parent.width; height: parent.height;

                            VerticalBox {
                                padding: 12px; spacing: 5px; width: 258px;

                                // .sum-hdr { font-weight:800; font-size:13px; color:#0A1929; padding-bottom:8px; border-bottom:3px solid #1565C0; margin-bottom:10px }
                                Text {
                                    text: "Summary"; font-size: 13px; font-weight: 800;
                                    color: #0A1929;
                                }
                                Rectangle { height: 8px; }  // padding-bottom:8px before border
                                Rectangle { height: 3px; background: #1565C0; }

                                // .sum-placeholder { color:#aaa; font-style:italic; font-size:12px; margin-top:20px; text-align:center }
                                if root.transaction-rows.length == 0 : Rectangle { height: 20px; }
                                if root.transaction-rows.length == 0 : Text {
                                    text: "No data loaded";
                                    font-size: 12px; color: #AAAAAA; font-italic: true;
                                    horizontal-alignment: center; wrap: word-wrap;
                                }

                                if root.transaction-rows.length > 0 : SDivider { title: "CLIENT"; }
                                SR { lbl: "Name";    val: root.dash-client-name != "" ? root.dash-client-name : "\u{2014}"; vcol: #37474F; }
                                SR { lbl: "Bank";    val: root.dash-bank-name   != "" ? root.dash-bank-name   : "\u{2014}"; vcol: #37474F; }
                                SR { lbl: "Account"; val: root.dash-account-no  != "" ? root.dash-account-no  : "\u{2014}"; vcol: #37474F; }
                                SR { lbl: "Period";  val: root.dash-period;  vcol: #546E7A; }

                                SDivider { title: "BALANCES"; }
                                SR { lbl: "Opening Balance"; val: root.dash-opening;      vcol: #1565C0; }
                                SR { lbl: "Total Receipts";  val: root.dash-credits;      vcol: #2E7D32; clickable: true; clicked => { root.show-dashboard = false; root.active-filter = "credits";      root.drill-filter("credits"); } }
                                SR { lbl: "Total Payments";  val: root.dash-debits;       vcol: #C62828; clickable: true; clicked => { root.show-dashboard = false; root.active-filter = "debits";       root.drill-filter("debits"); } }
                                SR { lbl: "Closing Balance"; val: root.dash-closing;      vcol: #1565C0; }
                                SR { lbl: "Calc. Closing";   val: root.dash-calc-closing; vcol: #546E7A; }

                                // .recon-card.mismatch { background:#ffebee; border-left:4px solid #c62828; border-radius:6px; padding:10px 12px }
                                if root.dash-has-mismatch : Rectangle {
                                    height: 36px; background: #FFEBEE;
                                    border-radius: 6px;
                                    // Left accent border (4px)
                                    Rectangle { x: 0; y: 0; width: 4px; height: parent.height; background: #C62828; border-radius: 6px; }
                                    HorizontalBox {
                                        padding-left: 14px; padding-right: 12px;
                                        padding-top: 0px; padding-bottom: 0px; spacing: 6px;
                                        Text {
                                            text: "\u{2717} MISMATCH"; font-size: 13px; font-weight: 800;
                                            color: #B71C1C; vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.dash-mismatch; font-size: 11px; font-weight: 700;
                                            color: #C62828; vertical-alignment: center;
                                        }
                                    }
                                }
                                // .recon-card.ok { background:#e8f5e9; border-left:4px solid #2e7d32; border-radius:6px; padding:10px 12px }
                                if !root.dash-has-mismatch && root.transaction-rows.length > 0 : Rectangle {
                                    height: 36px; background: #E8F5E9;
                                    border-radius: 6px;
                                    // Left accent border (4px)
                                    Rectangle { x: 0; y: 0; width: 4px; height: parent.height; background: #2E7D32; border-radius: 6px; }
                                    HorizontalBox {
                                        padding-left: 14px; padding-right: 12px;
                                        padding-top: 0px; padding-bottom: 0px;
                                        Text {
                                            text: "\u{2713} RECONCILED"; font-size: 13px; font-weight: 800;
                                            color: #1B5E20; vertical-alignment: center;
                                        }
                                    }
                                }

                                SDivider { title: "TRANSACTIONS"; }
                                HorizontalBox {
                                    padding: 0px; spacing: 6px;
                                    // sum-stat: padding:7px 8px; text-align:center; border-radius:6px
                                    // sum-stat-val: font-size:15px; font-weight:800; color:#0D47A1
                                    // sum-stat-lbl: font-size:9px; color:#888; text-transform:uppercase; letter-spacing:.4px
                                    for s in [
                                        {v: root.dash-txn-count,    lbl: "TOTAL"},
                                        {v: root.dash-credit-count, lbl: "CREDITS"},
                                        {v: root.dash-debit-count,  lbl: "DEBITS"},
                                    ] : Rectangle {
                                        horizontal-stretch: 1; height: 46px;
                                        background: #FFFFFF; border-radius: 6px;
                                        border-width: 1px; border-color: #BBDEFB;
                                        VerticalBox {
                                            padding-top: 7px; padding-bottom: 7px;
                                            padding-left: 8px; padding-right: 8px;
                                            spacing: 2px; alignment: center;
                                            Text { text: s.v; font-size: 15px; font-weight: 800; color: #0D47A1; horizontal-alignment: center; }
                                            Text { text: s.lbl; font-size: 9px; color: #888888; letter-spacing: 0.4px; horizontal-alignment: center; }
                                        }
                                    }
                                }

                                SDivider { title: "REVIEW STATUS"; }
                                SR { lbl: "Unreviewed";   val: root.dash-unreviewed;   vcol: #EF5350; clickable: true; clicked => { root.show-dashboard = false; root.active-filter = "unreviewed";   root.drill-filter("unreviewed"); } }
                                SR { lbl: "Needs Review"; val: root.dash-needs-review; vcol: #E65100; clickable: true; clicked => { root.show-dashboard = false; root.active-filter = "needs_review"; root.drill-filter("needs_review"); } }
                                SR { lbl: "Suspense";     val: root.dash-suspense;     vcol: #7B1FA2; clickable: true; clicked => { root.show-dashboard = false; root.active-filter = "suspense";     root.drill-filter("suspense"); } }

                                SDivider { title: "OTHER"; }
                                SR { lbl: "Duplicates"; val: root.dash-duplicates; vcol: #C2185B; clickable: true; clicked => { root.show-dashboard = false; root.active-filter = "duplicates"; root.drill-filter("duplicates"); } }
                                SR { lbl: "GST / Tax";  val: root.dash-gst-count;  vcol: #6A1B9A; clickable: true; clicked => { root.show-dashboard = false; root.active-filter = "gst";        root.drill-filter("gst"); } }
                                SR { lbl: "Vendors";    val: root.dash-vendors;    vcol: #546E7A; }

                                Rectangle { height: 6px; }
                                if root.status-bank != "" : Text {
                                    text: root.status-bank; font-size: 10px;
                                    color: #90A4AE; horizontal-alignment: center; wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }

        // ─────────────────────────── DASHBOARD ────────────────────────────────
        if root.show-dashboard : DashboardScreen {
            width: parent.width; height: parent.height;
            // Summary
            opening-balance: root.dash-opening;
            total-credits:   root.dash-credits;
            total-debits:    root.dash-debits;
            closing-balance: root.dash-closing;
            net-cash-flow:   root.dash-net-flow;
            txn-count:       root.dash-txn-count;
            vendor-count:    root.dash-vendors;
            top-expense:     root.dash-top-expense;
            top-expense-amt: root.dash-top-exp-amt;
            has-data:        root.dash-has-data;
            // Charts
            chart-monthly:   root.dash-chart-monthly;
            chart-expenses:  root.dash-chart-expenses;
            chart-cashflow:  root.dash-chart-cashflow;
            chart-vendors:   root.dash-chart-vendors;
            // Filter options
            filter-banks:    root.dash-filter-banks;
            filter-vendors:  root.dash-filter-vendors;
            filter-heads:    root.dash-filter-heads;
            // Insights
            ins-max-dr:       root.dash-ins-max-dr;
            ins-max-dr-narr:  root.dash-ins-max-dr-narr;
            ins-max-cr:       root.dash-ins-max-cr;
            ins-max-cr-narr:  root.dash-ins-max-cr-narr;
            ins-avg-dr:       root.dash-ins-avg-dr;
            ins-avg-cr:       root.dash-ins-avg-cr;
            ins-dr-count:     root.dash-ins-dr-count;
            ins-cr-count:     root.dash-ins-cr-count;
            ins-freq-vendor:  root.dash-ins-freq-vendor;
            // Callbacks
            dash-filter-changed(f, t, b, v, h) => {
                root.dash-filter-changed(f, t, b, v, h);
            }
            card-credits-clicked => {
                root.show-dashboard = false;
                root.active-filter = "credits";
                root.drill-filter("credits");
            }
            card-debits-clicked => {
                root.show-dashboard = false;
                root.active-filter = "debits";
                root.drill-filter("debits");
            }
            card-txns-clicked => {
                root.show-dashboard = false;
                root.active-filter = "all";
                root.drill-filter("all");
            }
        }

        } // end content wrapper Rectangle

        // ─────────────────────────── FOOTER ───────────────────────────────────
        // background: #E3F2FD, border-top: 2px solid #BBDEFB
        Rectangle {
            height: 44px; background: #E3F2FD;

            // Top border
            Rectangle { y: 0px; height: 2px; background: #BBDEFB; }

            HorizontalBox {
                padding-left: 14px; padding-right: 14px;
                padding-top: 0px; padding-bottom: 0px;
                spacing: 8px; y: 2px; height: 42px;

                // Green buttons
                FootBtn { text: "Export to Excel";        enabled: root.transaction-rows.length > 0; bg: #2E7D32; border-clr: #2E7D32; fg: #FFFFFF; clicked => { root.modal-state = "excel-export"; } }
                // &#8659; = ⇓ (U+21D3 DOWNWARDS DOUBLE ARROW) from original HTML
                FootBtn { text: "\u{21D3} Export for Accounting"; enabled: root.transaction-rows.length > 0; bg: #1A237E; border-clr: #1A237E; fg: #FFFFFF; clicked => { root.wiz-step = 1; root.modal-state = "export-wizard"; } }
                FootBtn { text: "Quick Tally XML";        enabled: root.transaction-rows.length > 0; bg: #2E7D32; border-clr: #2E7D32; fg: #FFFFFF; clicked => { root.modal-state = "tally-export"; } }
                FootBtn { text: "Re-import Excel";        enabled: false; clicked => { root.reimport-excel(); } }
                FootBtn { text: "Reset Dedupe History";   enabled: root.transaction-rows.length > 0; bg: #C62828; border-clr: #C62828; fg: #FFFFFF; clicked => { root.reset-dedupe(); } }

                Rectangle { width: 1px; height: 28px; background: #90CAF9; }

                FootBtn { text: "Reconcile";     enabled: root.transaction-rows.length > 0; bg: #7E57C2; border-clr: #7E57C2; fg: #FFFFFF; clicked => { root.modal-state = "reconcile"; } }
                FootBtn { text: "Batch Monitor"; enabled: true; clicked => { root.modal-state = "batch-monitor"; } }
                FootBtn { text: "Audit Trail";   enabled: true; clicked => { root.modal-state = "audit-trail";  } }
                FootBtn { text: "Settings";      enabled: true; clicked => { root.modal-state = "settings";     } }

                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MODAL OVERLAYS
    // ═══════════════════════════════════════════════════════════════════════════

    if root.modal-state == "new-client" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 310px) / 2;
            width: 470px; height: 310px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Add New Client"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "Client Name *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. Acme Pvt Ltd"; height: 34px;
                        text: root.new-client-name;
                        edited(v) => { root.new-client-name = v; }
                    }
                    Text { text: "Bank Ledger Name in Tally *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. HDFC Bank A/c - 5021"; height: 34px;
                        text: root.new-client-ledger;
                        edited(v) => { root.new-client-ledger = v; }
                    }
                    // .fg small { font-size:11px; color:#999; margin-top:3px }
                    Text { text: "Must exactly match the ledger name in your Tally company (case-sensitive)"; font-size: 11px; color: #999999; wrap: word-wrap; }
                }
                MFtr {
                    MBtn { text: "Save Client"; bg: #1565C0; clicked => {
                        root.new-client();
                        root.modal-state = "";
                        root.new-client-name = "";
                        root.new-client-ledger = "";
                    } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "ai-settings" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 360px) / 2;
            width: 470px; height: 360px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "\u{2605} AI Classifier \u{2014} Settings"; bg: #FFF8E1; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "AI Provider"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    ComboBox {
                        model: ["OpenAI (GPT-4o-mini)", "Anthropic Claude (Haiku)", "Google Gemini 1.5 Flash"];
                        current-index: root.ai-provider-idx;
                        height: 34px;
                        selected(v) => { root.ai-provider-idx = self.current-index; }
                    }
                    Text { text: "API Key"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "sk-..."; height: 34px; input-type: password;
                        text: root.ai-api-key;
                        edited(v) => { root.ai-api-key = v; }
                    }
                    Text { text: "Classify which transactions"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    ComboBox { model: ["Unclassified / low-confidence only (recommended)", "All transactions"]; height: 34px; }
                    Rectangle {
                        height: 40px; background: #F3E5F5; border-radius: 4px;
                        border-width: 1px; border-color: #CE93D8;
                        HorizontalBox { padding: 10px; Text { text: "\u{2139} AI suggestions are not guaranteed accurate. Always review before exporting."; font-size: 10px; color: #6A1B9A; wrap: word-wrap; vertical-alignment: center; } }
                    }
                }
                MFtr {
                    MBtn { text: "\u{2605} Start AI Classification"; bg: #6B2FB8; fg: white; clicked => { root.modal-state = ""; root.ai-classify(); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "tally-export" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 480px) / 2;
            width: 470px; height: 480px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Quick Tally XML Export"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "Tally Company Name *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit { placeholder-text: "Must match Tally exactly (case-sensitive)"; height: 34px; text <=> root.wiz-company; }
                    Text { text: "GSTIN (optional)"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit { placeholder-text: "e.g. 27AABCU9603R1ZX"; height: 34px; text <=> root.wiz-gstin; }
                    HorizontalBox { padding: 0px; spacing: 12px;
                        VerticalBox { padding: 0px; spacing: 6px; horizontal-stretch: 1;
                            Text { text: "From Date"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            LineEdit { placeholder-text: "DD/MM/YYYY"; height: 34px; text <=> root.wiz-from; }
                        }
                        VerticalBox { padding: 0px; spacing: 6px; horizontal-stretch: 1;
                            Text { text: "To Date"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            LineEdit { placeholder-text: "DD/MM/YYYY"; height: 34px; text <=> root.wiz-to; }
                        }
                    }
                    CheckBox { text: "Export only classified transactions"; checked <=> root.wiz-opt-classified; }
                    CheckBox { text: "Auto-create ledgers in Tally"; checked <=> root.wiz-opt-ledger; }
                    CheckBox { text: "Include narrations in vouchers"; checked <=> root.wiz-opt-narr; }
                    CheckBox { text: "Include Opening Balance journal entry"; checked <=> root.wiz-opt-ob; }
                    CheckBox { text: "Skip low-confidence entries (<40%)"; checked <=> root.wiz-opt-skip-low; }
                }
                MFtr {
                    MBtn { text: "Export Tally XML"; bg: #2E7D32; fg: white; clicked => { root.modal-state = ""; root.export-tally(); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "excel-export" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 440px) / 2; y: (parent.height - 260px) / 2;
            width: 440px; height: 260px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "\u{2193} Export to Excel"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "Choose which transactions to include:"; font-size: 13px; color: #555555; }
                    // Radio: All transactions (selected by default)
                    property <bool> xl-all-selected: true;
                    HorizontalBox { padding: 0px; spacing: 8px;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 8px;
                            background: xl-all-selected ? #1565C0 : #F5F5F5;
                            border-width: 2px;
                            border-color: xl-all-selected ? #1565C0 : #BDBDBD;
                            TouchArea { clicked => { xl-all-selected = true; } }
                        }
                        Text { text: "All transactions (" + root.fc-all + ")";
                               font-size: 12px; font-weight: 600; color: #37474F; vertical-alignment: center; }
                    }
                    HorizontalBox { padding: 0px; spacing: 8px;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 8px;
                            background: !xl-all-selected ? #1565C0 : #F5F5F5;
                            border-width: 2px;
                            border-color: !xl-all-selected ? #1565C0 : #BDBDBD;
                            TouchArea { clicked => { xl-all-selected = false; } }
                        }
                        Text { text: "Filtered transactions only";
                               font-size: 12px; color: #37474F; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 42px; background: #F0F7FF; border-radius: 6px;
                        border-width: 1px; border-color: #CCE4FF;
                        HorizontalBox { padding: 10px; Text { text: "\u{2139} Generates 7 sheets: Transactions, Summary, Ledger Analysis, GST & Tax, Duplicates, Review Required, Audit Summary."; font-size: 11px; color: #1A5276; wrap: word-wrap; } }
                    }
                }
                MFtr {
                    MBtn { text: "\u{2193} Generate Excel"; bg: #1565C0; clicked => { root.modal-state = ""; root.export-excel(); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "settings" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 520px) / 2;
            width: 700px; height: 520px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Application Settings"; close => { root.modal-state = ""; } }
                ScrollView { vertical-stretch: 1;
                    VerticalBox { padding: 18px; spacing: 12px;
                        // Narration Cleaner section
                        Rectangle {
                            height: 1px; background: #E3F2FD;
                        }
                        Text { text: "NARRATION CLEANER"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        CheckBox { text: "Enable narration cleaning"; checked <=> root.settings-narr-enabled; }
                        CheckBox { text: "Convert to Title Case"; checked <=> root.settings-narr-title-case; }
                        CheckBox { text: "Preserve original narration"; checked <=> root.settings-narr-preserve; }
                        Rectangle { height: 1px; background: #E3F2FD; }
                        Text { text: "GST ENGINE"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        CheckBox { text: "Enable GST detection"; checked <=> root.settings-gst-enabled; }
                        CheckBox { text: "Auto-suggest GST ledgers"; checked <=> root.settings-gst-auto-ledgers; }
                        HorizontalBox { padding: 0px; spacing: 8px;
                            Text { text: "Default State"; font-size: 11px; color: #546E7A; vertical-alignment: center; }
                            ComboBox { model: ["Maharashtra (MH)", "Gujarat (GJ)", "Delhi (DL)", "Karnataka (KA)"]; min-width: 160px; }
                        }
                        Rectangle { height: 1px; background: #E3F2FD; }
                        Text { text: "RECONCILIATION"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        HorizontalBox { padding: 0px; spacing: 12px;
                            VerticalBox { padding: 0px; spacing: 4px;
                                Text { text: "Date Fuzzy Window (days)"; font-size: 11px; color: #546E7A; }
                                LineEdit { text <=> root.settings-recon-days; height: 30px; min-width: 70px; max-width: 80px; }
                            }
                            VerticalBox { padding: 0px; spacing: 4px;
                                Text { text: "Amount Tolerance (%)"; font-size: 11px; color: #546E7A; }
                                LineEdit { text <=> root.settings-recon-pct; height: 30px; min-width: 70px; max-width: 80px; }
                            }
                        }
                        Rectangle { height: 1px; background: #E3F2FD; }
                        Text { text: "LOGGING"; font-size: 12px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                        HorizontalBox { padding: 0px; spacing: 8px;
                            Text { text: "Log Level"; font-size: 11px; color: #546E7A; vertical-alignment: center; }
                            ComboBox { model: ["INFO", "DEBUG", "WARN", "ERROR"]; current-index <=> root.settings-log-level; min-width: 100px; }
                        }
                        Rectangle {
                            height: 30px; width: 140px;
                            background: #C62828; border-radius: 4px;
                            TouchArea { clicked => { root.clear-logs(); } }
                            Text { text: "Clear All Logs"; font-size: 11px; color: white;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Save Settings"; bg: #1565C0; clicked => { root.modal-state = ""; root.settings-save-all(); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "import-history" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 400px) / 2;
            width: 700px; height: 400px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Import History"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 8px; vertical-stretch: 1;
                    Text { text: "Up to 20 imports per client are recorded in the database."; font-size: 11px; color: #888888; wrap: word-wrap; }
                    if root.import-records.length == 0 : Rectangle {
                        height: 60px; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        Text { text: "No import history for this client yet."; font-size: 13px; color: #BDBDBD; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.import-records.length > 0 : Rectangle {
                        vertical-stretch: 1;
                        // Header row
                        Rectangle {
                            y: 0; height: 28px; background: #1565C0;
                            HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px;
                                Text { text: "File / Batch"; font-size: 12px; font-weight: 600; color: white; horizontal-stretch: 2; vertical-alignment: center; }
                                Text { text: "Date"; font-size: 12px; font-weight: 600; color: white; min-width: 140px; vertical-alignment: center; }
                                Text { text: "Txns"; font-size: 12px; font-weight: 600; color: white; min-width: 50px; vertical-alignment: center; }
                            }
                        }
                        ListView {
                            y: 28px; height: parent.height - 28px;
                            for rec[i] in root.import-records : Rectangle {
                                height: 26px; background: #FFFFFF;
                                Rectangle { y: 25px; height: 1px; background: #E3F2FD; }
                                TouchArea {
                                    clicked => { root.modal-state = ""; root.reload-import(i); }
                                    mouse-cursor: pointer;
                                }
                                HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px;
                                    // Format: "FILE\tDATE\tCOUNT" — split by tab
                                    Text {
                                        text: rec;  // show full record; Rust formats nicely
                                        font-size: 12px; color: #0A1929;
                                        vertical-alignment: center; overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "view-rules" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 400px) / 2;
            width: 700px; height: 400px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Learned Rules"; close => { root.modal-state = ""; } }
                if root.rule-records.length == 0 : Rectangle {
                    vertical-stretch: 1; background: #F5F5F5;
                    Text { text: "No learned rules yet. Edit transactions and click \"Save & Learn\" to create rules."; font-size: 13px; color: #BDBDBD; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                }
                if root.rule-records.length > 0 : Rectangle {
                    vertical-stretch: 1;
                    Rectangle {
                        y: 0; height: 28px; background: #1565C0;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px;
                            Text { text: "Pattern"; font-size: 12px; font-weight: 600; color: white; horizontal-stretch: 2; vertical-alignment: center; }
                            Text { text: "Vendor"; font-size: 12px; font-weight: 600; color: white; min-width: 110px; vertical-alignment: center; }
                            Text { text: "Account Head"; font-size: 12px; font-weight: 600; color: white; min-width: 110px; vertical-alignment: center; }
                            Text { text: "Type"; font-size: 12px; font-weight: 600; color: white; min-width: 60px; vertical-alignment: center; }
                        }
                    }
                    ListView {
                        y: 28px; height: parent.height - 28px;
                        for rec in root.rule-records : Rectangle {
                            height: 26px; background: #FFFFFF;
                            Rectangle { y: 25px; height: 1px; background: #E3F2FD; }
                            Text {
                                x: 10px; width: parent.width - 20px; height: parent.height;
                                text: rec;
                                font-size: 11px; color: #0A1929;
                                vertical-alignment: center; overflow: elide;
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Backup Rules"; bg: #1565C0; clicked => { root.backup-rules(); } }
                    MBtn { text: "Restore Rules"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.restore-rules(); } }
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "batch-monitor" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 820px) / 2; y: (parent.height - 480px) / 2;
            width: 820px; height: 480px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Batch Processing Monitor"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 14px; spacing: 8px; vertical-stretch: 1;
                    HorizontalBox { padding: 0px; spacing: 8px;
                        MBtn { text: "Start Batch"; bg: #1565C0; clicked => { root.open-batch-monitor(); } }
                        MBtn { text: "Pause"; bg: #F5F5F5; fg: #BDBDBD; enabled: false; }
                        MBtn { text: "Abort"; bg: #F5F5F5; fg: #BDBDBD; enabled: false; }
                        MBtn { text: "Load All into Session"; bg: #2E7D32; fg: white; enabled: true; clicked => { root.load-all(); } }
                    }
                    // Summary line / empty hint
                    if root.batch-log != "" : Rectangle {
                        height: 28px; background: #E3F2FD; border-radius: 4px;
                        Text { text: root.batch-log; font-size: 12px; color: #1565C0;
                               x: 10px; y: 6px; overflow: elide; width: parent.width - 20px; }
                    }
                    if root.batch-file-rows.length == 0 : Rectangle {
                        vertical-stretch: 1; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        Text {
                            text: "Use \"Batch Process Folder\" in the toolbar to select multiple files.";
                            font-size: 12px; color: #90A4AE;
                            wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    if root.batch-file-rows.length > 0 : VerticalBox { padding: 0px; spacing: 0px; vertical-stretch: 1;
                        // Column headers
                        Rectangle {
                            height: 26px; background: #37474F; border-radius: 4px;
                            HorizontalLayout { padding: 6px; spacing: 0px;
                                Text { text: "File"; font-size: 11px; color: white; font-weight: 700; width: 180px; }
                                Text { text: "Bank"; font-size: 11px; color: white; font-weight: 700; width: 140px; }
                                Text { text: "Account"; font-size: 11px; color: white; font-weight: 700; width: 120px; }
                                Text { text: "Period"; font-size: 11px; color: white; font-weight: 700; width: 140px; }
                                Text { text: "Txns"; font-size: 11px; color: white; font-weight: 700; horizontal-alignment: right; width: 50px; }
                                Text { text: "Status"; font-size: 11px; color: white; font-weight: 700; horizontal-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                        // Per-file rows
                        ListView { vertical-stretch: 1;
                            for row[i] in root.batch-file-rows : Rectangle {
                                height: 24px;
                                background: Math.mod(i, 2) == 0 ? white : #F8F9FA;
                                Rectangle { y: 23px; height: 1px; background: #E0E0E0; width: parent.width; }
                                HorizontalLayout { padding: 6px; spacing: 0px;
                                    Text { text: row.file;    font-size: 11px; color: #37474F; overflow: elide; width: 180px; }
                                    Text { text: row.bank;    font-size: 11px; color: #37474F; overflow: elide; width: 140px; }
                                    Text { text: row.account; font-size: 11px; color: #607D8B; overflow: elide; width: 120px; }
                                    Text { text: row.period;  font-size: 11px; color: #607D8B; overflow: elide; width: 140px; }
                                    Text { text: row.txns > 0 ? row.txns : "—"; font-size: 11px; color: #37474F; horizontal-alignment: right; width: 50px; }
                                    Rectangle { horizontal-stretch: 1;
                                        Rectangle {
                                            x: (parent.width - 52px) / 2; y: 2px;
                                            width: 52px; height: 18px; border-radius: 3px;
                                            background: row.is-ok ? #E8F5E9 : #FFEBEE;
                                            Text { text: row.status; font-size: 10px; font-weight: 700;
                                                   color: row.is-ok ? #2E7D32 : #C62828;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    if root.modal-state == "audit-trail" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 440px) / 2;
            width: 700px; height: 440px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Audit Trail"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 14px; spacing: 8px; vertical-stretch: 1;
                    HorizontalBox { padding: 0px; spacing: 8px;
                        ComboBox { model: ["All Actions", "Create", "Update", "Delete", "Import", "Export", "Classify", "Rule"]; min-width: 130px; current-index <=> root.audit-action-idx; }
                        ComboBox { model: ["All Types", "Transaction", "Client", "Rule", "Import", "Export"]; min-width: 130px; current-index <=> root.audit-type-idx; }
                        MBtn { text: "Refresh"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.open-audit-trail(root.audit-action-idx, root.audit-type-idx); } }
                        MBtn { text: "Undo Last Edit"; bg: #F5F5F5; fg: #BDBDBD; enabled: false; }
                    }
                    Rectangle {
                        vertical-stretch: 1; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        if root.audit-records.length == 0 : Text {
                            text: "No audit events recorded yet.";
                            font-size: 13px; color: #BDBDBD; horizontal-alignment: center; vertical-alignment: center;
                        }
                        if root.audit-records.length > 0 : ListView {
                            for entry in root.audit-records : Rectangle {
                                height: 22px;
                                Rectangle { y: 21px; height: 1px; background: #E3F2FD; }
                                Text {
                                    text: entry; font-size: 11px; color: #37474F;
                                    y: 4px; x: 8px; overflow: elide;
                                    width: parent.width - 16px;
                                }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Download Logs"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.download-logs(); } }
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Edit Transaction modal ─────────────────────────────────────────────────
    if root.modal-state == "edit-txn" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 440px) / 2;
            width: 470px; height: 440px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Edit Transaction"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    // .txn-info { background:#F0F7FF; border-radius:5px; border:1px solid #BBDEFB; padding:10px 13px; font-size:12px; line-height:1.9; color:#444 }
                    Rectangle {
                        height: 80px; background: #F0F7FF; border-radius: 5px;
                        border-width: 1px; border-color: #BBDEFB;
                        VerticalBox {
                            padding-top: 10px; padding-bottom: 10px;
                            padding-left: 13px; padding-right: 13px;
                            spacing: 3px;
                            HorizontalBox { padding: 0px; spacing: 0px;
                                Text { text: "Date: "; font-size: 12px; font-weight: 700; color: #0A1929; }
                                Text { text: root.edit-txn-date; font-size: 12px; color: #444444; horizontal-stretch: 1; }
                                Text { text: "Debit: "; font-size: 12px; font-weight: 700; color: #0A1929; }
                                Text { text: root.edit-txn-dr; font-size: 12px; color: #B71C1C; }
                                Text { text: "   Credit: "; font-size: 12px; font-weight: 700; color: #0A1929; }
                                Text { text: root.edit-txn-cr; font-size: 12px; color: #1B5E20; }
                            }
                            Text { text: root.edit-txn-narr; font-size: 12px; color: #444444; wrap: word-wrap; }
                        }
                    }
                    Rectangle { height: 1px; background: #EEEEEE; }
                    Text { text: "Vendor / Payer / Payee"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. Airtel, Self, Bank"; height: 34px;
                        text: root.etxn-vendor;
                        edited(v) => { root.etxn-vendor = v; }
                    }
                    Text { text: "Account Head"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. Telephone Expense"; height: 34px;
                        text: root.etxn-head;
                        edited(v) => { root.etxn-head = v; }
                    }
                    Text { text: "Type"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    ComboBox {
                        model: ["-- Select --", "Receipt", "Payment", "Contra"];
                        current-index: root.etxn-type-idx;
                        height: 34px;
                        selected(v) => { root.etxn-type-idx = self.current-index; }
                    }
                }
                MFtr {
                    MBtn {
                        text: "Save & Learn"; bg: #1565C0;
                        clicked => {
                            root.save-txn(root.edit-txn-idx, root.etxn-vendor, root.etxn-head,
                                ["","Receipt","Payment","Contra"][root.etxn-type-idx], true);
                            root.modal-state = "";
                        }
                    }
                    MBtn {
                        text: "Save (no learn)"; bg: #455A64; fg: white;
                        clicked => {
                            root.save-txn(root.edit-txn-idx, root.etxn-vendor, root.etxn-head,
                                ["","Receipt","Payment","Contra"][root.etxn-type-idx], false);
                            root.modal-state = "";
                        }
                    }
                    // Original: class="btn btn-orange" → background:#e65100
                    MBtn {
                        text: "Mark as Suspense"; bg: #E65100; fg: white;
                        clicked => { root.mark-suspense(root.edit-txn-idx); root.modal-state = ""; }
                    }
                    MBtn {
                        text: "Delete"; bg: #C62828; fg: white;
                        clicked => { root.delete-txn(root.edit-txn-idx); root.modal-state = ""; }
                    }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Add Transaction modal ──────────────────────────────────────────────────
    if root.modal-state == "add-txn" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 520px) / 2;
            width: 470px; height: 520px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Add Transaction Manually"; close => { root.modal-state = ""; } }
                ScrollView { vertical-stretch: 1;
                    VerticalBox { padding: 18px; spacing: 10px;
                        // Warning banner
                        Rectangle {
                            height: 40px; background: #FFF3E0; border-radius: 4px;
                            border-width: 1px; border-color: #FFB74D;
                            HorizontalBox { padding: 8px; Text { text: "\u{26A0} You are manually inserting a transaction. It will be marked Manual and will not be skipped by dedupe on future imports."; font-size: 11px; color: #6D3600; wrap: word-wrap; vertical-alignment: center; } }
                        }
                        HorizontalBox { padding: 0px; spacing: 12px;
                            VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                                Text { text: "Date * (DD/MM/YYYY)"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                                LineEdit { placeholder-text: "01/01/2024"; height: 34px; text: root.add-date; edited(v) => { root.add-date = v; } }
                            }
                            VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                                Text { text: "Reference / Cheque No."; font-size: 12px; font-weight: 600; color: #0D47A1; }
                                LineEdit { placeholder-text: "Optional"; height: 34px; text: root.add-ref; edited(v) => { root.add-ref = v; } }
                            }
                        }
                        Text { text: "Narration *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                        LineEdit { placeholder-text: "Transaction description"; height: 34px; text: root.add-narr; edited(v) => { root.add-narr = v; } }
                        HorizontalBox { padding: 0px; spacing: 12px;
                            VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                                Text { text: "Debit Amount"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                                LineEdit { placeholder-text: "0.00"; height: 34px; text: root.add-dr; edited(v) => { root.add-dr = v; } }
                            }
                            VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                                Text { text: "Credit Amount"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                                LineEdit { placeholder-text: "0.00"; height: 34px; text: root.add-cr; edited(v) => { root.add-cr = v; } }
                            }
                        }
                        Rectangle { height: 1px; background: #EEEEEE; }
                        Text { text: "Vendor / Payer / Payee"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                        LineEdit { placeholder-text: "e.g. Airtel, Self, Bank"; height: 34px; text: root.add-vendor; edited(v) => { root.add-vendor = v; } }
                        Text { text: "Account Head"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                        LineEdit { placeholder-text: "e.g. Telephone Expense"; height: 34px; text: root.add-head; edited(v) => { root.add-head = v; } }
                        Text { text: "Type"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                        ComboBox {
                            model: ["-- Select --", "Receipt", "Payment", "Contra"];
                            current-index: root.add-type-idx; height: 34px;
                            selected(v) => { root.add-type-idx = self.current-index; }
                        }
                    }
                }
                MFtr {
                    MBtn {
                        text: "Add Transaction"; bg: #1565C0;
                        clicked => {
                            root.add-txn(root.add-date, root.add-ref, root.add-narr,
                                root.add-dr, root.add-cr, root.add-vendor, root.add-head,
                                ["","Receipt","Payment","Contra"][root.add-type-idx]);
                            root.add-date = ""; root.add-ref = ""; root.add-narr = "";
                            root.add-dr = ""; root.add-cr = "";
                            root.add-vendor = ""; root.add-head = "";
                            root.add-type-idx = 0;
                            root.modal-state = "";
                        }
                    }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Reconciliation modal ───────────────────────────────────────────────────
    if root.modal-state == "reconcile" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 700px) / 2; y: (parent.height - 500px) / 2;
            width: 700px; height: 500px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Bank Reconciliation"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 14px; spacing: 8px; vertical-stretch: 1;
                    // Toolbar
                    HorizontalBox { padding: 0px; spacing: 8px; height: 36px;
                        MBtn { text: "Import Tally Export (Excel)"; bg: #F5F5F5; fg: #37474F; enabled: true; clicked => { root.reconcile(); } }
                        Text { text: "No Tally file loaded"; font-size: 12px; color: #888888; vertical-alignment: center; horizontal-stretch: 1; }
                        MBtn { text: "Run Reconciliation"; bg: #1565C0; enabled: false; }
                        MBtn { text: "Export CSV"; bg: #2E7D32; fg: white; enabled: root.recon-status != ""; clicked => { root.export-recon-csv(); } }
                    }
                    // Summary bar — bound to Rust recon properties
                    Rectangle {
                        height: 50px; background: #E3F2FD; border-radius: 6px;
                        HorizontalBox { padding: 10px; spacing: 16px;
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-matched; font-size: 20px; font-weight: 700; color: #2E7D32; horizontal-alignment: center; }
                                Text { text: "Matched"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-likely; font-size: 20px; font-weight: 700; color: #F57F17; horizontal-alignment: center; }
                                Text { text: "Likely"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-unmatched; font-size: 20px; font-weight: 700; color: #C62828; horizontal-alignment: center; }
                                Text { text: "Unmatched"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Text { text: root.recon-bank-only; font-size: 20px; font-weight: 700; color: #6A1B9A; horizontal-alignment: center; }
                                Text { text: "Bank Only"; font-size: 10px; color: #64B5F6; horizontal-alignment: center; }
                            }
                        }
                    }
                    // Content area
                    Rectangle {
                        vertical-stretch: 1; background: #F5F5F5;
                        border-radius: 4px; border-width: 1px; border-color: #E0E0E0;
                        if root.recon-status == "" : Text {
                            text: "Load a Tally daybook export to begin matching.";
                            font-size: 13px; color: #888888; horizontal-alignment: center; vertical-alignment: center;
                        }
                        if root.recon-status != "" : Text {
                            text: root.recon-status;
                            font-size: 12px; color: #37474F; wrap: word-wrap;
                            x: 10px; y: 10px; width: parent.width - 20px;
                        }
                    }
                }
                MFtr {
                    MBtn { text: "Close"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Export Accounting Wizard ───────────────────────────────────────────────
    if root.modal-state == "export-wizard" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 660px) / 2; y: (parent.height - 540px) / 2;
            width: 660px; height: 540px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "\u{2193} Export for Accounting Software"; close => { root.modal-state = ""; } }

                // Step indicator
                Rectangle {
                    height: 52px; background: #F8FAFF; border-width: 1px; border-color: #E3EBF6;
                    HorizontalBox {
                        padding-left: 14px; padding-right: 14px; padding-top: 0px; padding-bottom: 0px;
                        spacing: 6px; alignment: center;
                        for step in [{n: 1, lbl: "Software"}, {n: 2, lbl: "Company"}, {n: 3, lbl: "Period"}, {n: 4, lbl: "Options"}] :
                        HorizontalBox { padding: 0px; spacing: 4px;
                            VerticalBox { padding: 0px; spacing: 2px; alignment: center;
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 14px;
                                    background: root.wiz-step == step.n ? #1565C0 : (root.wiz-step > step.n ? #2E7D32 : #D8E4F5);
                                    Text {
                                        text: root.wiz-step > step.n ? "\u{2713}" : step.n;
                                        font-size: 12px; font-weight: 700;
                                        color: root.wiz-step >= step.n ? white : #6B8AB4;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                                Text { text: step.lbl; font-size: 10px; color: root.wiz-step == step.n ? #1565C0 : #8AA0BB; horizontal-alignment: center; }
                            }
                            if step.n < 4 : Text { text: "\u{2192}"; color: #BDD0E8; font-size: 14px; vertical-alignment: center; }
                        }
                    }
                }

                // Step 1: Software selection
                if root.wiz-step == 1 : VerticalBox { padding: 20px; spacing: 12px; vertical-stretch: 1;
                    Text { text: "SELECT ACCOUNTING SOFTWARE"; font-size: 12px; font-weight: 600; color: #1565C0; letter-spacing: 0.5px; }
                    HorizontalBox { padding: 0px; spacing: 10px;
                        for sw in [{n: 0, ico: "T", nm: "Tally Prime", sub: "ERP9 / Prime"},
                                   {n: 1, ico: "Z", nm: "Zoho Books", sub: "Journal CSV"},
                                   {n: 2, ico: "Q", nm: "QuickBooks", sub: "General Journal"}] :
                        Rectangle {
                            horizontal-stretch: 1; height: 80px;
                            background: root.wiz-sw-idx == sw.n ? #EEF4FF : #FFFFFF;
                            border-radius: 8px; border-width: 2px;
                            border-color: root.wiz-sw-idx == sw.n ? #1565C0 : #D8E4F5;
                            TouchArea { clicked => { root.wiz-sw-idx = sw.n; } }
                            VerticalBox { padding: 10px; spacing: 3px; alignment: center;
                                Rectangle {
                                    width: 32px; height: 32px; border-radius: 6px;
                                    background: root.wiz-sw-idx == sw.n ? #1565C0 : #E3F0FF;
                                    Text { text: sw.ico; font-size: 15px; font-weight: 800; color: root.wiz-sw-idx == sw.n ? white : #1565C0; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text { text: sw.nm; font-size: 11px; font-weight: 600; color: #1A237E; horizontal-alignment: center; }
                                Text { text: sw.sub; font-size: 10px; color: #7B97B4; horizontal-alignment: center; }
                            }
                        }
                    }
                    HorizontalBox { padding: 0px; spacing: 10px;
                        for sw in [{n: 3, ico: "O", nm: "Odoo", sub: "Journal Entry"},
                                   {n: 4, ico: "\u{2616}", nm: "Excel / CSV", sub: "Generic CSV"},
                                   {n: 5, ico: "</>", nm: "Generic XML", sub: "Custom import"}] :
                        Rectangle {
                            horizontal-stretch: 1; height: 80px;
                            background: root.wiz-sw-idx == sw.n ? #EEF4FF : #FFFFFF;
                            border-radius: 8px; border-width: 2px;
                            border-color: root.wiz-sw-idx == sw.n ? #1565C0 : #D8E4F5;
                            TouchArea { clicked => { root.wiz-sw-idx = sw.n; } }
                            VerticalBox { padding: 10px; spacing: 3px; alignment: center;
                                Rectangle {
                                    width: 32px; height: 32px; border-radius: 6px;
                                    background: root.wiz-sw-idx == sw.n ? #1565C0 : #E3F0FF;
                                    Text { text: sw.ico; font-size: 15px; font-weight: 800; color: root.wiz-sw-idx == sw.n ? white : #1565C0; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text { text: sw.nm; font-size: 11px; font-weight: 600; color: #1A237E; horizontal-alignment: center; }
                                Text { text: sw.sub; font-size: 10px; color: #7B97B4; horizontal-alignment: center; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // Step 2: Company details
                if root.wiz-step == 2 : VerticalBox { padding: 20px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "COMPANY DETAILS"; font-size: 12px; font-weight: 600; color: #1565C0; letter-spacing: 0.5px; }
                    Text { text: "Company Name *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit { placeholder-text: "Must match exactly in accounting software"; height: 34px; text: root.wiz-company; edited(v) => { root.wiz-company = v; } }
                    Text { text: "GSTIN (optional)"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit { placeholder-text: "e.g. 27AABCU9603R1ZX"; height: 34px; text: root.wiz-gstin; edited(v) => { root.wiz-gstin = v; } }
                    HorizontalBox { padding: 0px; spacing: 12px;
                        VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                            Text { text: "Financial Year"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            ComboBox { model: ["2024-25", "2023-24", "2022-23", "2021-22"]; height: 34px; }
                        }
                        VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                            Text { text: "State"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            ComboBox { model: ["Maharashtra (MH)", "Gujarat (GJ)", "Delhi (DL)", "Karnataka (KA)", "Tamil Nadu (TN)", "Telangana (TG)", "Rajasthan (RJ)", "UP (UP)", "West Bengal (WB)"]; height: 34px; }
                        }
                    }
                    Rectangle {
                        height: 36px; background: #FFF8E1; border-radius: 4px;
                        border-width: 1px; border-color: #FFB300;
                        HorizontalBox { padding: 8px; Text { text: "Company name must exactly match the company name in your accounting software (case-sensitive for Tally)."; font-size: 11px; color: #5A7090; wrap: word-wrap; vertical-alignment: center; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // Step 3: Period
                if root.wiz-step == 3 : VerticalBox { padding: 20px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "SELECT EXPORT PERIOD"; font-size: 12px; font-weight: 600; color: #1565C0; letter-spacing: 0.5px; }
                    HorizontalBox { padding: 0px; spacing: 12px;
                        VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                            Text { text: "From Date"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            LineEdit { placeholder-text: "DD/MM/YYYY"; height: 34px; text: root.wiz-from; edited(v) => { root.wiz-from = v; } }
                        }
                        VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                            Text { text: "To Date"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                            LineEdit { placeholder-text: "DD/MM/YYYY"; height: 34px; text: root.wiz-to; edited(v) => { root.wiz-to = v; } }
                        }
                    }
                    Rectangle {
                        height: 36px; background: #E3F2FD; border-radius: 6px;
                        HorizontalBox { padding: 10px; Text { text: "Leave dates blank to export all transactions. Use dates to export a partial period (e.g. if you have already posted some months)."; font-size: 11px; color: #0D47A1; wrap: word-wrap; vertical-alignment: center; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // Step 4: Options
                if root.wiz-step == 4 : VerticalBox { padding: 20px; spacing: 8px; vertical-stretch: 1;
                    Text { text: "EXPORT OPTIONS"; font-size: 12px; font-weight: 600; color: #1565C0; letter-spacing: 0.5px; }
                    // Export summary preview bar
                    if root.export-preview-text != "" : Rectangle {
                        height: 32px; background: #E3F2FD; border-radius: 6px; border-width: 1px; border-color: #90CAF9;
                        HorizontalLayout { padding: 10px; spacing: 6px; alignment: center;
                            Text { text: "\u{1F4CA}"; font-size: 13px; vertical-alignment: center; }
                            Text { text: root.export-preview-text; font-size: 12px; color: #0D47A1; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-ob; }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Include Opening Balance entry"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Creates a Journal entry for the bank opening balance"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-gst; }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Include GST details"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Adds GST tag notes to narrations where detected"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-ledger; }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Include Ledger Creation entries"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Adds LEDGER CREATE entries before vouchers (Tally will skip if ledger exists)"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-narr; }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Include voucher narrations"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Includes original bank narration text in voucher narration field"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-classified; toggled => { root.export-preview(); } }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Export only classified transactions"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Skips unreviewed / suspense transactions — recommended for accounting import"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                    Rectangle {
                        height: 44px; background: #F8FAFF; border-radius: 7px; border-width: 1px; border-color: #E0EBF5;
                        HorizontalBox { padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 0px; spacing: 10px;
                            CheckBox { checked <=> root.wiz-opt-skip-low; toggled => { root.export-preview(); } }
                            VerticalBox { padding: 0px; spacing: 1px; alignment: center; horizontal-stretch: 1;
                                Text { text: "Skip low-confidence classifications"; font-size: 12px; font-weight: 600; color: #1A237E; }
                                Text { text: "Excludes transactions with confidence < 40% to reduce errors"; font-size: 10px; color: #6B84A0; }
                            }
                        }
                    }
                }

                // Wizard footer
                MFtr {
                    MBtn { text: "\u{2190} Back"; bg: #F5F5F5; fg: #546E7A; enabled: root.wiz-step > 1;
                        clicked => { if root.wiz-step > 1 { root.wiz-step -= 1; } }
                    }
                    if root.wiz-step < 4 : MBtn { text: "Next \u{2192}"; bg: #1565C0;
                        clicked => { root.wiz-step += 1; if root.wiz-step == 4 { root.export-preview(); } }
                    }
                    if root.wiz-step == 4 : MBtn { text: "\u{2193} Download"; bg: #1A237E; fg: white;
                        clicked => { root.export-accounting(); root.modal-state = ""; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; root.wiz-step = 1; } }
                }
            }
        }
    }

    // ── AI Privacy Consent modal ───────────────────────────────────────────────
    if root.modal-state == "ai-consent" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 580px) / 2;
            width: 470px; height: 580px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                // Red header
                Rectangle {
                    height: 64px; background: #C62828; border-radius: 4px;
                    HorizontalBox { padding-left: 18px; padding-right: 12px; padding-top: 0px; padding-bottom: 0px; spacing: 12px;
                        Text { text: "\u{26A0}"; font-size: 24px; color: white; vertical-alignment: center; }
                        VerticalBox { padding: 0px; spacing: 2px; alignment: center; horizontal-stretch: 1;
                            Text { text: "AI Auto-Classify \u{2014} Confidentiality Warning"; font-size: 14px; font-weight: 700; color: white; }
                            Text { text: "Read carefully before proceeding"; font-size: 11px; color: #FFCDD2; }
                        }
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 14px; background: #00000030;
                            TouchArea { clicked => { root.modal-state = ""; } }
                            Text { text: "\u{2715}"; font-size: 13px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                ScrollView { vertical-stretch: 1;
                    VerticalBox { padding: 18px; spacing: 12px;
                        // Lead warning
                        Rectangle {
                            height: 70px; background: #FFF3E0; border-radius: 5px;
                            border-width: 1px; border-color: #E65100;
                            HorizontalBox { padding: 12px; spacing: 10px;
                                Text { text: "\u{1F512}"; font-size: 20px; vertical-alignment: center; }
                                Text { text: "This feature may send transaction narrations and related accounting data to third-party AI platforms for automated classification. Confidentiality of data may be compromised if sensitive, financial, personal, or proprietary business information is submitted to external AI systems."; font-size: 12px; color: #4E342E; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                        // What is transmitted
                        Rectangle {
                            background: #FAFAFA; border-radius: 5px; border-width: 1px; border-color: #E0E0E0;
                            VerticalBox { padding: 10px; spacing: 4px;
                                Text { text: "WHAT IS TRANSMITTED"; font-size: 11px; font-weight: 700; color: #1565C0; letter-spacing: 0.5px; }
                                Text { text: "\u{2022} Transaction narration / description text\n\u{2022} Transaction amounts (debit / credit values)\n\u{2022} Extracted vendor or party names"; font-size: 12px; color: #37474F; }
                                Rectangle { height: 28px; background: #F1F8E9; border-radius: 4px; border-width: 1px; border-color: #AED581;
                                    HorizontalBox { padding: 6px; Text { text: "\u{2713}  Account numbers, IFSC codes, bank names and balances are not transmitted."; font-size: 11px; color: #2E7D32; vertical-alignment: center; } }
                                }
                            }
                        }
                        // Risks
                        Rectangle {
                            background: #FAFAFA; border-radius: 5px; border-width: 1px; border-color: #E0E0E0;
                            VerticalBox { padding: 10px; spacing: 4px;
                                Text { text: "\u{26A0} POTENTIAL RISKS"; font-size: 11px; font-weight: 700; color: #C62828; letter-spacing: 0.5px; }
                                Text { text: "\u{2022} Unauthorized access or interception during transmission\n\u{2022} Data leakage or retention by third-party AI platforms\n\u{2022} Exposure of confidential business or client information\n\u{2022} Regulatory, privacy, or compliance violations (GDPR, IT Act, etc.)"; font-size: 12px; color: #B71C1C; }
                            }
                        }
                        // Consent checkbox
                        Rectangle {
                            height: 50px; background: #FFF8E1; border-radius: 6px;
                            border-width: 2px; border-color: #F9A825;
                            HorizontalBox { padding: 12px; spacing: 10px;
                                CheckBox { checked <=> root.ai-consent-checked; }
                                Text { text: "I have read and understood the above. I acknowledge and accept the confidentiality and compliance risks of using AI classification."; font-size: 12px; font-weight: 600; color: #4E342E; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                MFtr {
                    MBtn { text: "\u{25BA} Continue with AI"; bg: #6B2FB8; fg: white;
                        enabled: root.ai-consent-checked;
                        clicked => { root.ai-consent-checked = false; root.modal-state = "ai-settings"; }
                    }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true;
                        clicked => { root.ai-consent-checked = false; root.modal-state = ""; }
                    }
                }
            }
        }
    }

    // ── PDF Password modal ─────────────────────────────────────────────────────
    if root.pdf-pwd-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        Rectangle {
            x: (parent.width - 380px) / 2; y: (parent.height - 200px) / 2;
            width: 380px; height: 200px; background: white; border-radius: 8px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #1565C0; }
                MHdr { title: "Password Protected PDF"; close => { root.pdf-pwd-cancel(); } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: root.pdf-pwd-prompt; font-size: 13px; color: #444444; wrap: word-wrap; }
                    LineEdit {
                        placeholder-text: "Enter PDF password"; height: 34px;
                        input-type: password;
                        text: root.pdf-pwd-input;
                        edited(v) => { root.pdf-pwd-input = v; }
                        accepted => { root.pdf-pwd-confirm(root.pdf-pwd-input); }
                    }
                }
                MFtr {
                    MBtn { text: "Unlock"; bg: #1565C0; clicked => { root.pdf-pwd-confirm(root.pdf-pwd-input); } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.pdf-pwd-cancel(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }

    // ── OCR Progress overlay ───────────────────────────────────────────────────
    if root.ocr-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000060;
        Rectangle {
            x: (parent.width - 360px) / 2; y: (parent.height - 180px) / 2;
            width: 360px; height: 180px; background: white; border-radius: 10px;
            drop-shadow-blur: 40px; drop-shadow-color: #0000004D; drop-shadow-offset-y: 12px;
            Rectangle { x: 0; y: 0; height: 4px; background: #1565C0; }
            VerticalBox {
                padding: 28px; spacing: 10px; alignment: center;
                Text { text: "OCR Processing"; font-size: 15px; font-weight: 700; color: #0A1929; horizontal-alignment: center; }
                Text { text: root.ocr-msg; font-size: 13px; color: #555555; horizontal-alignment: center; min-height: 18px; }
                // Progress bar
                Rectangle {
                    height: 10px; background: #E3F2FD; border-radius: 5px;
                    Rectangle {
                        width: parent.width * root.ocr-pct / 100;
                        height: parent.height; background: #1565C0; border-radius: 5px;
                    }
                }
                Text {
                    text: root.ocr-pct + "%";
                    font-size: 12px; font-weight: 600; color: #1565C0;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // ── AI Classification Progress overlay ─────────────────────────────────────
    // .ai-box { width: 380px; } from original CSS
    if root.ai-overlay-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000060;
        Rectangle {
            x: (parent.width - 380px) / 2; y: (parent.height - 220px) / 2;
            width: 380px; height: 220px; background: white; border-radius: 10px;
            drop-shadow-blur: 40px; drop-shadow-color: #0000004D; drop-shadow-offset-y: 12px;
            Rectangle { x: 0; y: 0; height: 4px; background: #6B2FB8; }
            VerticalBox {
                padding: 28px; spacing: 10px; alignment: center;
                Text { text: "\u{2605} AI Classification in Progress"; font-size: 15px; font-weight: 700; color: #0A1929; horizontal-alignment: center; }
                Text { text: root.ai-msg; font-size: 13px; color: #555555; horizontal-alignment: center; min-height: 18px; }
                // Progress bar
                Rectangle {
                    height: 10px; background: #EDE7F6; border-radius: 5px;
                    Rectangle {
                        width: parent.width * root.ai-pct / 100;
                        height: parent.height; background: #6B2FB8; border-radius: 5px;
                    }
                }
                Text { text: root.ai-pct + "%"; font-size: 12px; font-weight: 600; color: #6B2FB8; horizontal-alignment: center; }
                Text { text: "Sending transaction narrations to AI provider…\nDo not close the window."; font-size: 11px; color: #888888; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle {
                    height: 30px; width: 100px;
                    background: #FFFFFF; border-radius: 4px; border-width: 1px; border-color: #90CAF9;
                    TouchArea { clicked => { root.ai-cancel(); } }
                    Text { text: "Cancel"; font-size: 12px; color: #546E7A; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }

    // ── Edit Client modal ──────────────────────────────────────────────────────
    if root.modal-state == "edit-client" : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #00000072;
        TouchArea { clicked => { root.modal-state = ""; } }
        Rectangle {
            x: (parent.width - 470px) / 2; y: (parent.height - 310px) / 2;
            width: 470px; height: 310px; background: white; border-radius: 8px;
            border-width: 0px;
            drop-shadow-blur: 36px; drop-shadow-color: #00000048; drop-shadow-offset-y: 10px;
            TouchArea { width: 100%; height: 100%; }
            VerticalBox { padding: 0px; spacing: 0px;
                Rectangle { height: 4px; background: #0277BD; }
                MHdr { title: "Edit Client"; close => { root.modal-state = ""; } }
                VerticalBox { padding: 18px; spacing: 10px; vertical-stretch: 1;
                    Text { text: "Client Name *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. Acme Pvt Ltd"; height: 34px;
                        text: root.edit-client-name;
                        edited(v) => { root.edit-client-name = v; }
                    }
                    Text { text: "Bank Ledger Name in Tally *"; font-size: 12px; font-weight: 600; color: #0D47A1; }
                    LineEdit {
                        placeholder-text: "e.g. HDFC Bank A/c - 5021"; height: 34px;
                        text: root.edit-client-ledger;
                        edited(v) => { root.edit-client-ledger = v; }
                    }
                    Text { text: "Must exactly match the ledger name in your Tally company (case-sensitive)"; font-size: 11px; color: #999999; wrap: word-wrap; }
                }
                MFtr {
                    MBtn { text: "Save Changes"; bg: #0277BD; clicked => {
                        root.edit-client();
                        root.modal-state = "";
                    } }
                    MBtn { text: "Cancel"; bg: #F5F5F5; fg: #546E7A; enabled: true; clicked => { root.modal-state = ""; } }
                }
            }
        }
    }

    // ── Toast notification ─────────────────────────────────────────────────────
    if root.toast-msg != "" : Rectangle {
        x: (root.width - 280px) / 2;
        y: root.height - 80px;
        width: 280px; height: 36px;
        background:
            root.toast-kind == 1 ? #2E7D32 :
            root.toast-kind == 2 ? #C62828 :
            root.toast-kind == 3 ? #E65100 :
            #0D47A1;
        border-radius: 5px;
        drop-shadow-blur: 12px; drop-shadow-color: #00000030; drop-shadow-offset-y: 4px;
        Text {
            text: root.toast-msg;
            font-size: 12px; font-weight: 600; color: white;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}
