// dashboard.slint — Native dashboard with real charts, filters, insights.
// Matches the original Electron dashboard: 8 stat cards, 4 charts (2×2), insights strip.

import { VerticalBox, HorizontalBox, ScrollView, ComboBox, LineEdit } from "std-widgets.slint";

// ── Data structs ───────────────────────────────────────────────────────────────
export struct DashMonthBar {
    label:      string,   // "Jan 2024"
    credit-h:   float,    // 0..1 normalised to max
    debit-h:    float,
    credit-str: string,
    debit-str:  string,
    range-from: string,   // "01/MM/YYYY" — first day of this month
    range-to:   string,   // "DD/MM/YYYY" — last day of this month
}

export struct DashExpBar {
    label:      string,
    w:          float,    // 0..1 normalised
    amount-str: string,
    color-idx:  int,      // 0-9 → PIE_PALETTE
    pct:        int,      // integer percent
    // Cumulative donut-arc angles in degrees (0deg = 12 o'clock, clockwise),
    // pre-computed in Rust from the same `amount` each entry's `w`/`pct`/
    // `amount-str` above already come from (main.rs, push_dashboard) — added
    // so "EXPENSE HEAD BREAKDOWN" can be drawn as the donut chart the ZIP
    // reference screenshot shows (verified via pixel sampling: its legend
    // swatch colors are this exact `PiePalette`, in this exact `color-idx`
    // order), rather than a bar list. Slint's `Path` can't accumulate a
    // running total across a `for` loop itself, so the cumulative sum is
    // done once here instead.
    start-angle: float,
    sweep-angle: float,
}

export struct DashCashPt {
    h: float,             // 0..1 normalised (min-max scaled)
}

export struct DashVendorBar {
    label:      string,
    debit-w:    float,
    credit-w:   float,
    debit-str:  string,
    credit-str: string,
}

// ── Palette helper (matches JS PIE_PALETTE) ───────────────────────────────────
global PiePalette {
    pure public function color(idx: int) -> color {
        idx == 0 ? #1565C0 :
        idx == 1 ? #2E7D32 :
        idx == 2 ? #6A1B9A :
        idx == 3 ? #AD1457 :
        idx == 4 ? #BF360C :
        idx == 5 ? #00695C :
        idx == 6 ? #E65100 :
        idx == 7 ? #F57F17 :
        idx == 8 ? #0277BD :
        #4E342E
    }
}

// ── Stat card ──────────────────────────────────────────────────────────────────
// Original: border-radius:10px; padding:13px 15px; border-left:4px solid; box-shadow:0 2px 6px rgba(0,0,0,.07)
// dash-card-lbl: font-size:10px; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:.07em; margin-bottom:5px
// dash-card-val: font-size:15px; font-weight:700; color:#0D47A1
component StatCard inherits Rectangle {
    in property <string> title:     "Label";
    in property <string> value:     "₹ —";
    in property <string> sub:       "";
    in property <color>  accent:    #1565C0;
    in property <bool>   clickable: false;
    callback clicked();

    background:    #FFFFFF;
    border-radius: 10px;
    min-height:    78px;
    // `clip: true` (2026-08-24) — runtime-verified fix. Confirmed by
    // actually running the app: an unusually long value (this card's own
    // test data included some absurdly long ₹ figures) wrapped to a second
    // line whose height wasn't accounted for by the row's own layout pass,
    // so that second line rendered *below* this card's rounded white
    // background instead of growing it — text visibly spilling onto the
    // plain page background outside the card. `clip: true` is the safety
    // net: whatever happens inside this card's box now can never paint
    // outside its rounded boundary, matching every other card-like
    // component in this file (`ChartCard`, `InsCard`'s effective clipping
    // via its rectangular children) which already clips.
    clip: true;
    drop-shadow-blur:     6px;
    drop-shadow-color:    #00000012;
    drop-shadow-offset-y: 2px;

    ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalBox {
        padding-top: 13px; padding-bottom: 13px;
        padding-left: 15px; padding-right: 15px;
        spacing: 10px;
        // Left accent border (4px strip)
        Rectangle { width: 4px; background: root.accent; border-radius: 2px; }
        VerticalBox {
            spacing: 5px; alignment: center;
            Text {
                text: root.title; color: #888888;
                font-size: 10px; font-weight: 700;
                letter-spacing: 0.7px;
                overflow: elide;
            }
            // Single line + elide (2026-08-24), not `wrap: word-wrap` — see
            // `clip`'s doc comment above for what wrapping did wrong here.
            // Eliding keeps every card's natural height stable (matching
            // the ZIP reference's own clean single-line card values) while
            // still guaranteeing an arbitrarily long ₹ figure never grows
            // past, or spills outside of, this card's box — it just
            // truncates with "…" instead.
            Text {
                text: root.value; color: #0D47A1; font-size: 15px; font-weight: 700;
                overflow: elide;
            }
            if root.sub != "" : Text {
                text: root.sub; color: #999999; font-size: 10px;
                overflow: elide;
            }
        }
    }
}

// ── Chart card wrapper ─────────────────────────────────────────────────────────
// Original: border-radius:10px; padding:14px; box-shadow:0 2px 6px rgba(0,0,0,.07)
// dash-chart-title: font-size:11px; font-weight:700; color:#37474F; text-transform:uppercase; letter-spacing:.07em; margin-bottom:10px
component ChartCard inherits Rectangle {
    in property <string> chart-title: "";
    background:    #FFFFFF;
    border-radius: 10px;
    drop-shadow-blur:     6px;
    drop-shadow-color:    #00000012;
    drop-shadow-offset-y: 2px;
    clip: true;

    VerticalBox {
        padding: 14px; spacing: 10px;
        Text {
            text: root.chart-title;
            font-size: 11px; font-weight: 700; color: #37474F;
            letter-spacing: 0.7px;
        }
        @children
    }
}

// ── Insight card ───────────────────────────────────────────────────────────────
// Original: border-radius:8px; padding:11px 14px; border-top:3px solid #0D47A1; box-shadow:0 1px 4px rgba(0,0,0,.07)
// dash-ins-lbl: font-size:10px; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:.06em; margin-bottom:4px
// dash-ins-val: font-size:13px; font-weight:700; color:#0D47A1
// dash-ins-sub: font-size:9px; color:#aaa
component InsCard inherits Rectangle {
    in property <string> label: "Label";
    in property <string> value: "—";
    in property <string> sub:   "";
    in property <color>  vcol:  #0D47A1;

    background:    #FFFFFF;
    border-radius: 8px;
    horizontal-stretch: 1;
    drop-shadow-blur:     4px;
    drop-shadow-color:    #00000012;
    drop-shadow-offset-y: 1px;

    // Top border: 3px solid #0D47A1
    Rectangle {
        x: 0; y: 0; width: parent.width; height: 3px;
        background: #0D47A1;
        border-radius: 8px;  // only top corners
    }

    VerticalBox {
        padding-top: 14px;   // 11px content + 3px for top border
        padding-bottom: 11px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        Text {
            text: root.label; font-size: 10px; font-weight: 700;
            color: #888888; letter-spacing: 0.6px;
        }
        Text {
            text: root.value; font-size: 13px; font-weight: 700;
            color: root.vcol;
        }
        if root.sub != "" : Text {
            text: root.sub; font-size: 9px; color: #AAAAAA; wrap: word-wrap;
        }
    }
}

// ── Monthly bar chart ──────────────────────────────────────────────────────────
component MonthlyChart inherits Rectangle {
    in property <[DashMonthBar]> data: [];
    // 5 "₹NK" labels, index 0 = bottom (₹0K) … index 4 = top (nice-rounded
    // max) — matching the 0/25/50/75/100% positions the grid lines below
    // are already drawn at (original: Chart.js y-axis, dashboard.js:111).
    in property <[string]> y-ticks: [];
    callback month-clicked(string, string);  // (range-from, range-to)

    HorizontalBox {
        padding: 0px; spacing: 4px;

        // Y-axis label gutter — same vertical split (flexible area + 18px
        // bottom spacer) as the chart body on the right, so labels line
        // up with the grid lines instead of the x-axis month row.
        VerticalBox {
            padding: 0px; spacing: 0px;
            width: 32px;
            Rectangle {
                vertical-stretch: 1;
                for frac[i] in [0.0, 0.25, 0.5, 0.75, 1.0] : Text {
                    x: 0px; width: parent.width; height: 12px;
                    y: max(0px, min(parent.height - 12px, parent.height * (1 - frac) - 6px));
                    text: root.y-ticks.length > i ? root.y-ticks[i] : "";
                    font-size: 8px; color: #90A4AE;
                    horizontal-alignment: right; vertical-alignment: center;
                }
            }
            Rectangle { height: 18px; }
        }

    VerticalBox {
        padding: 0px; spacing: 0px;
        vertical-stretch: 1;
        horizontal-stretch: 1;

        // Y-axis grid lines + bars
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Grid lines at 25%, 50%, 75%, 100%
            for pct in [0.25, 0.5, 0.75, 1.0] : Rectangle {
                x: 0px; width: parent.width;
                y: parent.height * (1 - pct);
                height: 1px;
                background: #E3F2FD;
            }

            // Bars
            if data.length > 0 : HorizontalBox {
                padding: 0px; spacing: 2px;
                for bar in root.data : Rectangle {
                    horizontal-stretch: 1;
                    accessible-role: button;
                    accessible-label: bar.label + ": credit " + bar.credit-str + ", debit " + bar.debit-str;

                    // Credit bar (left, green)
                    Rectangle {
                        x: 1px;
                        width: (parent.width / 2) - 2px;
                        height: bar.credit-h * (parent.height - 2px);
                        y: parent.height - self.height - 1px;
                        background: #2E7D32;
                        border-radius: 2px;
                        opacity: 0.75;
                    }
                    // Debit bar (right, red)
                    Rectangle {
                        x: parent.width / 2 + 1px;
                        width: (parent.width / 2) - 2px;
                        height: bar.debit-h * (parent.height - 2px);
                        y: parent.height - self.height - 1px;
                        background: #C62828;
                        border-radius: 2px;
                        opacity: 0.75;
                    }
                    TouchArea {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.month-clicked(bar.range-from, bar.range-to); }
                    }
                }
            }
        }

        // X-axis labels row
        Rectangle {
            height: 18px;
            HorizontalBox {
                padding: 0px; spacing: 2px;
                for bar in root.data : Text {
                    horizontal-stretch: 1;
                    text: bar.label;
                    font-size: 9px; color: #78909C;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }
    }
}

// ── Expense head donut chart ────────────────────────────────────────────────────
// Ring (drawn via `Path`/`ArcTo` — Slint has no built-in chart types) + a
// plain label-only legend to the right, matching the ZIP reference
// screenshot's "EXPENSE HEAD BREAKDOWN" exactly (verified by pixel-sampling
// the screenshot: legend swatches are this same `PiePalette`, in this same
// `color-idx` order; the legend shows only a swatch + label, no count/
// percent alongside it). `start-angle`/`sweep-angle` come pre-computed on
// `DashExpBar` itself (see its own doc comment) from the same real
// `data.expenses` the old bar-chart form used — same data, different chart
// type only.
// ── Chart hover tooltip ──────────────────────────────────────────────────────
// Small dark bubble showing "<label> — <amount>" (UI addition, 2026-08-27),
// shared by the donut ring segments and the legend rows below it — same
// look either way, caller only sets label/amount and positions it via x/y.
// `width` binds to the inner HorizontalBox's own preferred-width rather
// than being left implicit — an unconstrained-width plain Rectangle nested
// another level inside a plain (non-layout) parent silently defaults to
// "fill parent" instead of "size to content" here (hit this as a real
// binding-loop error earlier fixing the Period-filter chip; same fix).
component ChartTooltip inherits Rectangle {
    in property <string> label: "";
    in property <string> amount: "";
    height: 24px;
    background: #263238;
    border-radius: 4px;
    drop-shadow-blur: 6px; drop-shadow-color: #00000040; drop-shadow-offset-y: 2px;
    width: tipContent.preferred-width;
    tipContent := HorizontalBox {
        padding-left: 8px; padding-right: 8px; padding-top: 0px; padding-bottom: 0px;
        Text {
            text: root.label + " \u{2014} " + root.amount;
            font-size: 11px; font-weight: 600; color: white;
            vertical-alignment: center;
        }
    }
}

component DonutChart inherits Rectangle {
    in property <[DashExpBar]> data: [];

    if data.length == 0 : Text {
        text: "No expense data — classify transactions";
        font-size: 11px; color: #B0BEC5;
        horizontal-alignment: center; vertical-alignment: center;
    }

    if data.length > 0 : HorizontalBox {
        padding: 0px; spacing: 14px;

        ring := Rectangle {
            width: min(self.height, 260px);
            property <float> cx: ring.width / 2 / 1px;
            property <float> cy: ring.height / 2 / 1px;
            property <float> r-outer: min(ring.width, ring.height) / 2 / 1px - 2;
            property <float> r-inner: ring.r-outer * 0.55;

            for item in root.data : Path {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                viewbox-width: ring.width / 1px; viewbox-height: ring.height / 1px;
                fill: PiePalette.color(item.color-idx);

                property <float> a0: (item.start-angle - 90) * 3.14159265 / 180;
                property <float> a1: (item.start-angle + item.sweep-angle - 90) * 3.14159265 / 180;
                property <bool> big: item.sweep-angle > 180;

                MoveTo { x: ring.cx + ring.r-outer * cos(a0 * 1rad); y: ring.cy + ring.r-outer * sin(a0 * 1rad); }
                ArcTo {
                    x: ring.cx + ring.r-outer * cos(a1 * 1rad); y: ring.cy + ring.r-outer * sin(a1 * 1rad);
                    radius-x: ring.r-outer; radius-y: ring.r-outer;
                    sweep: true; large-arc: big;
                }
                LineTo { x: ring.cx + ring.r-inner * cos(a1 * 1rad); y: ring.cy + ring.r-inner * sin(a1 * 1rad); }
                ArcTo {
                    x: ring.cx + ring.r-inner * cos(a0 * 1rad); y: ring.cy + ring.r-inner * sin(a0 * 1rad);
                    radius-x: ring.r-inner; radius-y: ring.r-inner;
                    sweep: false; large-arc: big;
                }
                Close { }
            }

            // ── Hover tooltip (UI addition, 2026-08-27) ─────────────────────
            // One TouchArea over the ring's whole bounding box — a `Path` isn't
            // independently hit-testable in Slint, and giving each wedge its
            // own full-square TouchArea would just stack N identical
            // rectangles (only the topmost ever receives events). `mouse-x`/
            // `mouse-y` are read directly as live properties, not through the
            // `moved` callback — verified via slint-viewer that `moved` only
            // fires while the button is held (drag); the properties
            // themselves update continuously on plain hover with no press.
            ringHit := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }

            // Each item below independently recomputes, from that one shared
            // pointer position, whether the mouse falls inside *its own*
            // wedge (angle range × radius range) — same idea as a CSS
            // `:hover` per element, done with the angle math since nothing
            // here can hit-test an arbitrary wedge shape directly. The angle
            // formula is the exact inverse of the `a = (deg - 90) * π/180`
            // used to draw the arcs above.
            //
            // Full-size (x:0/y:0/parent.width/parent.height), not the
            // `width:0px;height:0px;` it sounds like this invisible,
            // logic-only wrapper should be — verified via slint-viewer that
            // a zero-sized element generated by a `for` loop here rendered
            // its conditional `ChartTooltip` child ~250px away from the
            // position its own x/y math actually computed, while an
            // otherwise-identical full-size wrapper (matching `ringHit`'s
            // and the `Path` loop's own established pattern above) placed
            // it exactly right. Harmless either way for hit-testing, since
            // this wrapper itself has no TouchArea of its own.
            for item in root.data : Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;

                property <float> dx: (ringHit.mouse-x / 1px) - ring.cx;
                property <float> dy: (ringHit.mouse-y / 1px) - ring.cy;
                property <float> dist: sqrt(self.dx * self.dx + self.dy * self.dy);
                property <float> ang: Math.mod((atan2(self.dy, self.dx) / 1deg) + 90 + 360, 360);
                property <bool> is-hovered: ringHit.has-hover
                    && self.dist >= ring.r-inner && self.dist <= ring.r-outer
                    && self.ang >= item.start-angle && self.ang < item.start-angle + item.sweep-angle;

                // Flips to the mouse's left once past the ring's own
                // center — otherwise a tooltip on the ring's right half
                // would spill into the legend column beside it (a sibling
                // painted after `ring`, so it would paint over the
                // overflow) instead of just floating past the ring's own
                // edge, which is otherwise harmless since `ring` doesn't
                // clip its children.
                if self.is-hovered : ChartTooltip {
                    label: item.label; amount: item.amount-str;
                    x: (ringHit.mouse-x / 1px < ring.cx)
                        ? ringHit.mouse-x + 14px
                        : ringHit.mouse-x - self.width - 14px;
                    y: max(0px, ringHit.mouse-y - 30px);
                }
            }
        }

        ScrollView {
            horizontal-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalBox {
                padding: 2px; spacing: 8px;
                // Each legend row also shows the tooltip on hover (UI
                // addition, 2026-08-27) — simple rectangular `has-hover`
                // here, no angle math needed like the ring segments above.
                // The per-item root changed from a bare `HorizontalBox` to
                // a `Rectangle` wrapping one, purely so the TouchArea and
                // conditional tooltip have a plain (non-layout) parent to
                // sit in beside it; same explicit height and inner
                // HorizontalBox as before, so this `for`'s auto width/
                // stacking in the outer VerticalBox is unchanged. Tooltip
                // floats *above* the row rather than below: this row's own
                // subtree paints after the row before it, so an
                // upward-overflowing tooltip correctly lands on top of that
                // earlier row instead of getting painted over by it — the
                // reverse (a tooltip below getting covered by the *next*
                // row) would happen if it went the other way.
                for item in root.data : Rectangle {
                    height: 16px;
                    HorizontalBox {
                        padding: 0px; spacing: 6px; height: 16px;
                        Rectangle {
                            width: 10px; height: 10px; y: 3px; border-radius: 2px;
                            background: PiePalette.color(item.color-idx);
                        }
                        Text {
                            text: item.label; font-size: 10px; color: #37474F;
                            overflow: elide; vertical-alignment: center;
                        }
                    }
                    legendTa := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
                    if legendTa.has-hover : ChartTooltip {
                        label: item.label; amount: item.amount-str;
                        x: 0px; y: -28px;
                    }
                }
            }
        }
    }
}

// ── Cash flow sparkline ────────────────────────────────────────────────────────
component CashFlowChart inherits Rectangle {
    in property <[DashCashPt]> data: [];
    // 5 "₹NK" labels, index 0 = bottom … index 4 = top — spans
    // cashflow_min..cashflow_max (min-max scaled, not 0-based like the
    // other two charts), so index 0 isn't necessarily "₹0K".
    in property <[string]> y-ticks: [];

    HorizontalBox {
        padding: 0px; spacing: 4px;

        // Y-axis label gutter — mirrors the flexible-area + 8px bottom
        // spacer split of the chart body on the right.
        VerticalBox {
            padding: 0px; spacing: 0px;
            width: 32px;
            Rectangle {
                vertical-stretch: 1;
                for frac[i] in [0.0, 0.25, 0.5, 0.75, 1.0] : Text {
                    x: 0px; width: parent.width; height: 12px;
                    y: max(0px, min(parent.height - 12px, parent.height * (1 - frac) - 6px));
                    text: root.y-ticks.length > i ? root.y-ticks[i] : "";
                    font-size: 8px; color: #90A4AE;
                    horizontal-alignment: right; vertical-alignment: center;
                }
            }
            Rectangle { height: 8px; }
        }

    VerticalBox {
        padding: 0px; spacing: 0px;
        vertical-stretch: 1;
        horizontal-stretch: 1;

        Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: #F8FBFF;

            // Grid lines
            for pct in [0.25, 0.5, 0.75] : Rectangle {
                x: 0px; width: parent.width;
                y: parent.height * (1 - pct);
                height: 1px; background: #E3F2FD;
            }

            // Sparkline area (filled bars)
            if data.length > 0 : HorizontalBox {
                padding: 0px; spacing: 0px;
                for pt in root.data : Rectangle {
                    horizontal-stretch: 1;

                    // Fill area
                    Rectangle {
                        x: 0px;
                        width: parent.width;
                        height: pt.h * parent.height;
                        y: parent.height - self.height;
                        background: #1565C033;
                    }
                    // Top line
                    Rectangle {
                        x: 0px; width: parent.width;
                        y: parent.height * (1 - pt.h);
                        height: 2px;
                        background: #1565C0;
                    }
                }
            }

            if data.length == 0 : Text {
                text: "No balance data available";
                font-size: 11px; color: #B0BEC5;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        Rectangle { height: 8px; }
    }
    }
}

// ── Top vendors horizontal bar ─────────────────────────────────────────────────
component VendorsChart inherits Rectangle {
    in property <[DashVendorBar]> data: [];
    // 5 "₹NK" labels, index 0 = left (₹0K) … index 4 = right (nice-rounded
    // max) — original: Chart.js x-axis, dashboard.js:203.
    in property <[string]> x-ticks: [];

    if data.length == 0 : Text {
        text: "No vendor data — classify transactions";
        font-size: 11px; color: #B0BEC5;
        horizontal-alignment: center; vertical-alignment: center;
    }

    if data.length > 0 : VerticalBox {
        padding: 0px; spacing: 2px;

        ScrollView {
        vertical-stretch: 1;
        VerticalBox {
            padding: 2px; spacing: 5px;
            for v in root.data : Rectangle {
                height: 32px;

                // Vendor label
                Text {
                    x: 0px; y: 0px; width: 90px; height: 16px;
                    text: v.label;
                    font-size: 10px; color: #37474F;
                    overflow: elide; vertical-alignment: center;
                }

                // Debit bar
                Rectangle {
                    x: 95px; y: 2px;
                    width: (parent.width - 95px) * v.debit-w;
                    height: 12px;
                    background: #C62828;
                    border-radius: 2px;
                    opacity: 0.75;
                }
                // Debit label
                Text {
                    x: 97px + (parent.width - 95px) * v.debit-w;
                    y: 2px; height: 12px; width: 70px;
                    text: v.debit-str;
                    font-size: 9px; color: #C62828;
                    vertical-alignment: center;
                }

                // Credit bar
                Rectangle {
                    x: 95px; y: 18px;
                    width: (parent.width - 95px) * v.credit-w;
                    height: 12px;
                    background: #2E7D32;
                    border-radius: 2px;
                    opacity: 0.75;
                }
                // Credit label
                Text {
                    x: 97px + (parent.width - 95px) * v.credit-w;
                    y: 18px; height: 12px; width: 70px;
                    text: v.credit-str;
                    font-size: 9px; color: #2E7D32;
                    vertical-alignment: center;
                }
            }
        }
        }

        // X-axis tick row — aligned with the same 95px left margin /
        // (parent.width - 95px) bar-length region the debit/credit bars
        // above use, so labels land under the same 0/25/50/75/100% points
        // the bars themselves are scaled against. x is clamped into
        // [0, parent.width - 40px] so the leftmost/rightmost labels (whose
        // natural centered position would otherwise straddle the edge)
        // never extend past ChartCard's clip:true boundary.
        Rectangle {
            height: 14px;
            for frac[i] in [0.0, 0.25, 0.5, 0.75, 1.0] : Text {
                x: max(0px, min(parent.width - 40px, 95px + (parent.width - 95px) * frac - 20px));
                width: 40px; y: 0px; height: 14px;
                text: root.x-ticks.length > i ? root.x-ticks[i] : "";
                font-size: 8px; color: #90A4AE;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

// ── Dashboard screen ───────────────────────────────────────────────────────────
export component DashboardScreen inherits Rectangle {

    // ── Summary data ──────────────────────────────────────────────────────────
    in property <string> opening-balance:  "₹ —";
    in property <string> total-credits:    "₹ —";
    in property <string> total-debits:     "₹ —";
    in property <string> closing-balance:  "₹ —";
    in property <string> net-cash-flow:    "₹ —";
    in property <string> txn-count:        "—";
    in property <string> vendor-count:     "—";
    in property <string> top-expense:      "—";
    in property <string> top-expense-amt:  "";

    // ── Insight strip ─────────────────────────────────────────────────────────
    in property <string> ins-max-dr:       "—";
    in property <string> ins-max-dr-narr:  "";
    in property <string> ins-max-cr:       "—";
    in property <string> ins-max-cr-narr:  "";
    in property <string> ins-avg-dr:       "—";
    in property <string> ins-avg-cr:       "—";
    in property <string> ins-dr-count:     "";
    in property <string> ins-cr-count:     "";
    in property <string> ins-freq-vendor:  "—";

    // ── Chart data ────────────────────────────────────────────────────────────
    in property <[DashMonthBar]>  chart-monthly:   [];
    in property <[DashExpBar]>    chart-expenses:  [];
    in property <[DashCashPt]>    chart-cashflow:  [];
    in property <[DashVendorBar]> chart-vendors:   [];

    // ── Chart axis-tick labels (5 each, bottom/left → top/right) ─────────────
    in property <[string]> chart-monthly-y-ticks:  [];
    in property <[string]> chart-cashflow-y-ticks: [];
    in property <[string]> chart-vendors-x-ticks:  [];

    // ── Filter options ────────────────────────────────────────────────────────
    in property <[string]> filter-banks:   ["All Banks"];
    in property <[string]> filter-vendors: ["All Vendors"];
    in property <[string]> filter-heads:   ["All Expense Heads"];

    // ── Data flag ─────────────────────────────────────────────────────────────
    in property <bool> has-data: false;

    // ── Responsive width input (2026-08-24 runtime-verified fix) ─────────────
    // `DashboardScreen` inherits `Rectangle`, whose *own* `width` has a
    // default of "inferred from children" — so a `HorizontalBox` deep inside
    // (the 8-card summary row, the 2×2 chart grid) reading `root.width` back
    // to decide its own layout would create a real dependency cycle within
    // the compiled component, independent of the instantiator always giving
    // this component an explicit `width`. A plain `in property` — not
    // Rectangle's special `width` — has no such built-in self-reference, so
    // the instantiator (`main_screen.slint`) passes the same value it
    // already uses for this component's `width` binding through here too,
    // and `scrollWrap` below reads this instead of `root.width` directly.
    // Added after actually running the app and visually confirming the
    // previous `ScrollView { width: parent.width } / VerticalBox { width:
    // parent.visible-width }` pattern let the 8-card row and chart grid
    // render wider than the real window and clip at the right edge (the
    // 8th "Top Expense Category" card and part of "Vendors / Customers"
    // were cut off on screen) — code-level review alone hadn't caught this.
    in property <length> avail-width: 1440px;

    // ── Filter state ──────────────────────────────────────────────────────────
    in-out property <string> dash-from:         "";
    in-out property <string> dash-to:           "";
    in-out property <int>    dash-bank-idx:      0;
    in-out property <int>    dash-vendor-idx:    0;
    in-out property <int>    dash-head-idx:      0;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback dash-filter-changed(string, string, string, string, string);
    // (from, to, bank, vendor, head) — Rust re-aggregates on this
    callback card-credits-clicked();
    callback card-debits-clicked();
    callback card-txns-clicked();

    background: #F0F7FF;

    VerticalBox {
        padding: 0px; spacing: 0px;

        // ── Filter bar ─────────────────────────────────────────────────────
        // Original: background:#fff; border-radius:8px; padding:10px 14px; box-shadow:0 1px 4px rgba(0,0,0,.07); gap:10px
        // dash-fg label: font-size:10px; font-weight:700; color:#666; text-transform:uppercase; letter-spacing:.06em
        //
        // Rounded-card treatment (2026-08-24) — the `border-radius:8px` this
        // component's own "Original" comment documents above had never
        // actually been applied to the Rectangle below (it only set
        // `background`/shadow, not `border-radius`), and the card had no
        // outer margin either, so it rendered as a flush, square-cornered,
        // full-width bar instead of an inset rounded card — confirmed by
        // directly comparing a live screenshot of the running app against
        // the user-supplied reference screenshot. `filterCardMargin` is a
        // plain, un-positioned `VerticalBox` child (so it doesn't disturb
        // that layout's own vertical stacking/spacing), tall enough to hold
        // an 8px top margin plus the card; `filterCard` inside it is a
        // *free* child with explicit x/y/width — the same pattern
        // `scrollWrap` (below) and `ring` (`DonutChart`) already use
        // successfully for the identical need (explicit positioning inside
        // a plain, layout-managed `Rectangle`).
        filterCardMargin := Rectangle {
            height: 64px;

            filterCard := Rectangle {
                x: 10px; y: 8px;
                width: parent.width - 20px; height: 56px;
                background: #FFFFFF;
                border-radius: 8px;
                border-width: 1px;
                border-color: #E3EAF5;
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000012;
                drop-shadow-offset-y: 1px;
                clip: true;

            HorizontalBox {
                padding-left: 14px; padding-right: 14px;
                // Equal 15px top/bottom (UI fix, 2026-08-27): this row is
                // 56px tall and every field's own input (LineEdit/ComboBox)
                // is a fixed 26px, so (56 - 26) / 2 = 15px pins the content
                // area to exactly 26px. That matters because each label+
                // input pair below is its own unconstrained-height
                // HorizontalBox, which — like every other Layout child in
                // this app without an explicit height — auto-stretches to
                // fill whatever height its *parent* row makes available;
                // with the previous 0px/0px padding that was the full
                // 56px, so the label (auto-height, self-centers via
                // `vertical-alignment: center`) rendered near that 56px
                // box's true center while its sibling input (fixed 26px,
                // top-anchored — a Layout doesn't auto-center a fixed-
                // height child, same issue fixed elsewhere in this app)
                // stayed pinned to the top — label and input landed on two
                // different visual lines instead of side by side. Shrinking
                // the available height to exactly 26px removes the slack
                // that caused the mismatch: both label and input now
                // occupy the same 0..26px window, so they align.
                padding-top: 15px; padding-bottom: 15px;
                spacing: 10px;

                // ── Inline label-beside-input fields (2026-08-24) ────────────
                // Each field was previously its own `VerticalBox` (label on
                // top, input below) — the user's own written spec explicitly
                // asked for label-beside-input instead ("FROM: [Date
                // Input]"), so each is now a `HorizontalBox` with the label
                // and its input as siblings on one line. `vertical-align:
                // center` on each label keeps it centered against the
                // input's 26px height instead of sitting at the row's top.
                HorizontalBox {
                    padding: 0px; spacing: 6px; alignment: center;
                    Text { text: "FROM"; font-size: 10px; font-weight: 700; color: #666666; letter-spacing: 0.6px; vertical-alignment: center; }
                    LineEdit {
                        placeholder-text: "DD/MM/YYYY"; height: 26px;
                        min-width: 96px; max-width: 96px; font-size: 12px;
                        text: root.dash-from;
                        edited(v) => {
                            root.dash-from = v;
                            root.dash-filter-changed(root.dash-from, root.dash-to,
                                root.filter-banks[root.dash-bank-idx],
                                root.filter-vendors[root.dash-vendor-idx],
                                root.filter-heads[root.dash-head-idx]);
                        }
                    }
                }
                HorizontalBox {
                    padding: 0px; spacing: 6px; alignment: center;
                    Text { text: "TO"; font-size: 10px; font-weight: 700; color: #666666; letter-spacing: 0.6px; vertical-alignment: center; }
                    LineEdit {
                        placeholder-text: "DD/MM/YYYY"; height: 26px;
                        min-width: 96px; max-width: 96px; font-size: 12px;
                        text: root.dash-to;
                        edited(v) => {
                            root.dash-to = v;
                            root.dash-filter-changed(root.dash-from, root.dash-to,
                                root.filter-banks[root.dash-bank-idx],
                                root.filter-vendors[root.dash-vendor-idx],
                                root.filter-heads[root.dash-head-idx]);
                        }
                    }
                }
                HorizontalBox {
                    padding: 0px; spacing: 6px; alignment: center;
                    Text { text: "BANK"; font-size: 10px; font-weight: 700; color: #666666; letter-spacing: 0.6px; vertical-alignment: center; }
                    ComboBox {
                        model: root.filter-banks; height: 26px; min-width: 120px;
                        current-index: root.dash-bank-idx;
                        selected => {
                            root.dash-bank-idx = self.current-index;
                            root.dash-filter-changed(root.dash-from, root.dash-to,
                                root.filter-banks[self.current-index],
                                root.filter-vendors[root.dash-vendor-idx],
                                root.filter-heads[root.dash-head-idx]);
                        }
                    }
                }
                HorizontalBox {
                    padding: 0px; spacing: 6px; alignment: center;
                    Text { text: "VENDOR / LEDGER"; font-size: 10px; font-weight: 700; color: #666666; letter-spacing: 0.6px; vertical-alignment: center; }
                    ComboBox {
                        model: root.filter-vendors; height: 26px; min-width: 130px;
                        current-index: root.dash-vendor-idx;
                        selected => {
                            root.dash-vendor-idx = self.current-index;
                            root.dash-filter-changed(root.dash-from, root.dash-to,
                                root.filter-banks[root.dash-bank-idx],
                                root.filter-vendors[self.current-index],
                                root.filter-heads[root.dash-head-idx]);
                        }
                    }
                }
                HorizontalBox {
                    padding: 0px; spacing: 6px; alignment: center;
                    Text { text: "EXPENSE HEAD"; font-size: 10px; font-weight: 700; color: #666666; letter-spacing: 0.6px; vertical-alignment: center; }
                    ComboBox {
                        model: root.filter-heads; height: 26px; min-width: 130px;
                        current-index: root.dash-head-idx;
                        selected => {
                            root.dash-head-idx = self.current-index;
                            root.dash-filter-changed(root.dash-from, root.dash-to,
                                root.filter-banks[root.dash-bank-idx],
                                root.filter-vendors[root.dash-vendor-idx],
                                root.filter-heads[self.current-index]);
                        }
                    }
                }

                // Reset button
                Rectangle {
                    y: (parent.height - 26px) / 2;
                    height: 26px; width: 54px;
                    background: #F5F5F5; border-radius: 4px;
                    border-width: 1px; border-color: #D0D0D0;
                    accessible-role: button;
                    accessible-label: "Reset filters";
                    TouchArea {
                        clicked => {
                            root.dash-from = "";
                            root.dash-to = "";
                            root.dash-bank-idx = 0;
                            root.dash-vendor-idx = 0;
                            root.dash-head-idx = 0;
                            root.dash-filter-changed("", "", "", "", "");
                        }
                    }
                    Text { text: "Reset"; font-size: 11px; color: #546E7A;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle { horizontal-stretch: 1; }
            }
            }
        }

        // ── Scrollable content ──────────────────────────────────────────────
        // `scrollWrap` decouples this from the width-binding-loop /
        // right-edge-clipping bug documented on `avail-width` above: a
        // plain `clip: true` `Rectangle`, normally laid out (so it never
        // itself demands more than it's given), containing `ScrollView` as
        // a *free* child (explicit `x`/`y`/`width`/`height`, not layout-
        // managed) — the same pattern the transaction table's own
        // `hScrollWrap` already uses successfully for the identical class
        // of `ScrollView`-inside-`Rectangle` issue (see `main_screen.slint`).
        scrollWrap := Rectangle {
            vertical-stretch: 1; clip: true;

            ScrollView {
                x: 0px; y: 0px;
                width: root.avail-width; height: parent.height;

                VerticalBox {
                    padding: 16px; spacing: 14px;
                    width: max(400px, root.avail-width - 16px);

                // ── 8 Summary cards ──────────────────────────────────────────
                HorizontalBox {
                    spacing: 10px;
                    StatCard {
                        title: "Total Credits"; value: root.total-credits;
                        accent: #2E7D32; horizontal-stretch: 1; clickable: true;
                        clicked => { root.card-credits-clicked(); }
                    }
                    StatCard {
                        title: "Total Debits"; value: root.total-debits;
                        accent: #C62828; horizontal-stretch: 1; clickable: true;
                        clicked => { root.card-debits-clicked(); }
                    }
                    StatCard {
                        title: "Net Cash Flow"; value: root.net-cash-flow;
                        accent: #1565C0; horizontal-stretch: 1;
                    }
                    StatCard {
                        title: "Opening Balance"; value: root.opening-balance;
                        accent: #1565C0; horizontal-stretch: 1;
                    }
                    StatCard {
                        title: "Closing Balance"; value: root.closing-balance;
                        accent: #1565C0; horizontal-stretch: 1;
                    }
                    StatCard {
                        title: "Total Transactions"; value: root.txn-count;
                        accent: #1565C0; horizontal-stretch: 1; clickable: true;
                        clicked => { root.card-txns-clicked(); }
                    }
                    StatCard {
                        title: "Vendors / Customers"; value: root.vendor-count;
                        accent: #1565C0; horizontal-stretch: 1;
                    }
                    StatCard {
                        title: "Top Expense Category"; value: root.top-expense;
                        sub: root.top-expense-amt;
                        accent: #1565C0; horizontal-stretch: 1;
                    }
                }

                // ── No-data placeholder ───────────────────────────────────────
                if !root.has-data : Rectangle {
                    height: 80px;
                    Text {
                        text: "No transaction data. Load a bank statement to see analytics.";
                        font-size: 15px; color: #AAAAAA;
                        horizontal-alignment: center; vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // ── Charts 2×2 grid ───────────────────────────────────────────
                if root.has-data : HorizontalBox {
                    spacing: 12px; height: 260px;

                    // Monthly Credits vs Debits (2fr)
                    ChartCard {
                        horizontal-stretch: 2;
                        chart-title: "MONTHLY CREDITS VS DEBITS";

                        // Legend
                        HorizontalBox {
                            padding: 0px; spacing: 10px; height: 16px;
                            Rectangle { width: 12px; height: 12px; border-radius: 2px;
                                        background: #2E7D32; opacity: 0.75; }
                            Text { text: "Credits"; font-size: 10px; color: #37474F; vertical-alignment: center; }
                            Rectangle { width: 12px; height: 12px; border-radius: 2px;
                                        background: #C62828; opacity: 0.75; }
                            Text { text: "Debits"; font-size: 10px; color: #37474F; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        MonthlyChart {
                            data: root.chart-monthly;
                            y-ticks: root.chart-monthly-y-ticks;
                            vertical-stretch: 1;
                            month-clicked(f, t) => {
                                root.dash-from = f;
                                root.dash-to = t;
                                root.dash-filter-changed(f, t,
                                    root.filter-banks[root.dash-bank-idx],
                                    root.filter-vendors[root.dash-vendor-idx],
                                    root.filter-heads[root.dash-head-idx]);
                            }
                        }
                    }

                    // Expense Head Breakdown (1fr)
                    ChartCard {
                        horizontal-stretch: 1;
                        chart-title: "EXPENSE HEAD BREAKDOWN";

                        DonutChart {
                            data: root.chart-expenses;
                            vertical-stretch: 1;
                        }
                    }
                }

                if root.has-data : HorizontalBox {
                    spacing: 12px; height: 240px;

                    // Cash Flow Trend (2fr)
                    ChartCard {
                        horizontal-stretch: 2;
                        chart-title: "CASH FLOW TREND";

                        CashFlowChart {
                            data: root.chart-cashflow;
                            y-ticks: root.chart-cashflow-y-ticks;
                            vertical-stretch: 1;
                        }
                    }

                    // Top 10 Vendors / Customers (1fr)
                    ChartCard {
                        horizontal-stretch: 1;
                        chart-title: "TOP 10 VENDORS / CUSTOMERS";

                        // Legend
                        HorizontalBox {
                            padding: 0px; spacing: 10px; height: 14px;
                            Rectangle { width: 10px; height: 10px; border-radius: 2px;
                                        background: #C62828; opacity: 0.75; }
                            Text { text: "Debit"; font-size: 9px; color: #37474F; vertical-alignment: center; }
                            Rectangle { width: 10px; height: 10px; border-radius: 2px;
                                        background: #2E7D32; opacity: 0.75; }
                            Text { text: "Credit"; font-size: 9px; color: #37474F; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        VendorsChart {
                            data: root.chart-vendors;
                            x-ticks: root.chart-vendors-x-ticks;
                            vertical-stretch: 1;
                        }
                    }
                }

                // ── Insights strip ────────────────────────────────────────────
                if root.has-data : HorizontalBox {
                    spacing: 10px;
                    InsCard {
                        label: "HIGHEST DEBIT";
                        value: root.ins-max-dr;
                        sub: root.ins-max-dr-narr;
                        vcol: #C62828;
                    }
                    InsCard {
                        label: "HIGHEST CREDIT";
                        value: root.ins-max-cr;
                        sub: root.ins-max-cr-narr;
                        vcol: #2E7D32;
                    }
                    InsCard {
                        label: "AVG. DEBIT VALUE";
                        value: root.ins-avg-dr;
                        sub: root.ins-dr-count;
                        vcol: #37474F;
                    }
                    InsCard {
                        label: "AVG. CREDIT VALUE";
                        value: root.ins-avg-cr;
                        sub: root.ins-cr-count;
                        vcol: #37474F;
                    }
                    InsCard {
                        label: "MOST FREQUENT VENDOR";
                        value: root.ins-freq-vendor;
                        horizontal-stretch: 1.5;
                        vcol: #1565C0;
                    }
                }
                }
            }
        }
    }
}
